---
/**
 * Action potential (C2.2.2, C2.2.3; AHL C2.2.8–C2.2.10). Drawn in the step-1 start state (resting);
 * animated by c2-2-action-potential.ts. Top: a strip of axon membrane in three regions. Bottom: the
 * oscilloscope trace for region 2 (solid) and region 3 (dashed), plotted against the same time axis.
 */
import { AP, apX, apY } from './c2-2-ap-geometry';

const { mem, ch, ions } = AP;
const halves = (cx: number) => [cx - 12, cx];
const yTicks = [40, 0, -40, -80];
const tTicks = [0, 1, 2, 3, 4, 5, 6];
const ion = (key: string, kind: 'na' | 'k', [x, y]: [number, number], cls = '') => ({ key, kind, x, y, cls });
const allIons = [
  ...ions.naA.map((p, i) => ion(`naA${i}`, 'na', p.start)),
  ...ions.naO.map((p, i) => ion(`naO${i}`, 'na', p.start)),
  ...ions.naB.map((p, i) => ion(`naB${i}`, 'na', p.start)),
  ...ions.kA.map((p, i) => ion(`kA${i}`, 'k', p.start)),
  ...ions.kB.map((p, i) => ion(`kB${i}`, 'k', p.start)),
  ...ions.pNa.map((p, i) => ion(`pNa${i}`, 'na', p.start)),
  ...ions.pK.map((p, i) => ion(`pK${i}`, 'k', p.start)),
  ...ions.qNa.map((p, i) => ion(`qNa${i}`, 'na', p.start)),
  ...ions.qK.map((p, i) => ion(`qK${i}`, 'k', p.start)),
];
---
<svg viewBox="0 0 520 480" xmlns="http://www.w3.org/2000/svg" class="ap">
  <text class="side" x="10" y="16">Outside the axon — Na⁺ high, K⁺ low</text>
  <!-- region dividers -->
  <path class="divider" d="M182 24 V236 M352 24 V236" />
  <text class="region" x="91" y="236" text-anchor="middle">region 1</text>
  <text class="region" x="267" y="236" text-anchor="middle">region 2</text>
  <text class="region" x="436" y="236" text-anchor="middle">region 3</text>
  <rect class="mem" x="0" y={mem.top} width="520" height={mem.bottom - mem.top} />

  <!-- region 1: Na⁺/K⁺ pump and K⁺ leak channel -->
  <rect class="pump" x={ch.pump - 18} y={mem.top - 8} width="36" height={mem.bottom - mem.top + 16} rx="12" />
  <text class="mlabel" x={ch.pump + 22} y={mem.top + 25}>pump</text>
  <rect class="kc" x={ch.leak - 14} y={mem.top - 3} width="10" height={mem.bottom - mem.top + 6} rx="3" />
  <rect class="kc" x={ch.leak + 4} y={mem.top - 3} width="10" height={mem.bottom - mem.top + 6} rx="3" />
  <g class="ion"><circle class="k" cx={ch.leak} cy={(mem.top + mem.bottom) / 2} r="9" /></g>
  <text class="mlabel" x={ch.leak + 17} y={mem.top + 25}>leak</text>

  <!-- voltage-gated channels in regions 2 and 3 -->
  {(['2', '3'] as const).map((r) => (
    <>
      <g data-el={`na${r}`}>
        {halves(r === '2' ? ch.na2 : ch.na3).map((x, i) => <rect data-half={i} class="nac" x={x} y={mem.top - 4} width="12" height={mem.bottom - mem.top + 8} rx="3" />)}
      </g>
      <circle data-el={`inact${r}`} class="inact" cx={r === '2' ? ch.na2 : ch.na3} cy={mem.bottom + 8} r="6" style="opacity:0" />
      <g data-el={`k${r}`}>
        {halves(r === '2' ? ch.k2 : ch.k3).map((x, i) => <rect data-half={i} class="kc" x={x} y={mem.top - 4} width="12" height={mem.bottom - mem.top + 8} rx="3" />)}
      </g>
      <text class="mlabel" x={(r === '2' ? ch.na2 : ch.na3) + 24} y={mem.top + 25}>Na⁺</text>
      <text class="mlabel" x={(r === '2' ? ch.k2 : ch.k3) + 24} y={mem.top + 25}>K⁺</text>
    </>
  ))}

  <!-- charges on each side of the membrane -->
  {[91, 267, 436].map((x, i) => (
    <>
      <text data-el={`cOut${i + 1}`} class="charge" x={x} y={mem.top - 9} text-anchor="middle">+ + + + +</text>
      <text data-el={`cIn${i + 1}`} class="charge" x={x} y={mem.bottom + 20} text-anchor="middle">− − − − −</text>
    </>
  ))}
  <text data-el="refractory" class="tag" x="267" y="218" text-anchor="middle" style="opacity:0"></text>

  <!-- local currents (AHL step) -->
  <g data-el="lc" style="opacity:0">
    <path class="lc" d="M250 218 H398" marker-end="url(#ap-arrow)" />
    <path class="lc" d="M462 30 H312" marker-end="url(#ap-arrow)" />
    <text class="lctext" x="404" y="222">Na⁺ inside</text>
    <text class="lctext" x="300" y="34" text-anchor="end">Na⁺ outside</text>
  </g>
  <defs>
    <marker id="ap-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" class="arrowhead" />
    </marker>
  </defs>

  <!-- recording electrode in region 2 -->
  <path class="electrode" d={`M196 ${mem.bottom + 14} V242`} />
  <text class="mlabel" x="202" y="204">electrode</text>

  {allIons.map((p) => (
    <g data-el={p.key} class="ion" transform={`translate(${p.x} ${p.y})`}>
      <circle class={p.kind} r="11" />
      <text text-anchor="middle" dy="0.35em">{p.kind === 'na' ? 'Na⁺' : 'K⁺'}</text>
    </g>
  ))}

  <text class="side" x="10" y="256">Inside the axon — K⁺ high, Na⁺ low</text>

  <!-- oscilloscope -->
  <rect class="scope" x={apX(0) - 4} y={apY(50)} width={apX(6) - apX(0) + 8} height={apY(-90) - apY(50)} rx="6" />
  <g class="grid">{yTicks.map((v) => <line x1={apX(0)} x2={apX(6)} y1={apY(v)} y2={apY(v)} />)}</g>
  <line class="thr" x1={apX(0)} x2={apX(6)} y1={apY(-50)} y2={apY(-50)} />
  <text class="thrtext" x={apX(6) - 4} y={apY(-50) - 4} text-anchor="end">threshold −50 mV</text>
  <g class="ticks">
    {yTicks.map((v) => <text x={apX(0) - 8} y={apY(v)} dy="0.35em" text-anchor="end">{v > 0 ? `+${v}` : v}</text>)}
    {tTicks.map((t) => <text x={apX(t)} y={apY(-90) + 16} text-anchor="middle">{t}</text>)}
  </g>
  <text class="axis" transform={`translate(14 ${(apY(50) + apY(-90)) / 2}) rotate(-90)`} text-anchor="middle">membrane potential / mV</text>
  <text class="axis" x={(apX(0) + apX(6)) / 2} y="476" text-anchor="middle">time / ms</text>
  <path data-el="trace3" class="trace t3" d="" />
  <path data-el="trace2" class="trace" d={`M${apX(0)} ${apY(-70)}`} />
  <circle data-el="dot" class="dot" cx={apX(0)} cy={apY(-70)} r="5" />
  <g class="legend">
    <path class="trace" d={`M${apX(0) + 8} ${apY(44)} h26`} /><text x={apX(0) + 40} y={apY(44)} dy="0.35em">region 2</text>
    <path class="trace t3" d={`M${apX(0) + 108} ${apY(44)} h26`} /><text x={apX(0) + 140} y={apY(44)} dy="0.35em">region 3</text>
  </g>
  <text data-el="readout" class="readout" x={apX(6) - 4} y={apY(44)} dy="0.35em" text-anchor="end">region 2: −70 mV</text>
</svg>
<style>
  .ap { font-family: var(--font-sans); }
  .side { font-size: 13px; font-weight: 700; fill: var(--text-muted); }
  .region { font-size: 12px; font-weight: 700; fill: var(--text-muted); letter-spacing: 0.04em; }
  .divider { stroke: var(--border-strong); stroke-dasharray: 3 5; stroke-width: 1.2; }
  .mem { fill: color-mix(in srgb, var(--bio-tail) 40%, transparent); stroke: var(--bio-head); stroke-width: 6; stroke-dasharray: 2 4; }
  .pump { fill: var(--bio-protein); stroke: color-mix(in srgb, var(--bio-protein) 60%, black); stroke-width: 1.5; }
  .nac { fill: color-mix(in srgb, var(--bio-na) 75%, var(--surface)); stroke: color-mix(in srgb, var(--bio-na) 60%, black); stroke-width: 1.2; }
  .kc { fill: color-mix(in srgb, var(--bio-k) 75%, var(--surface)); stroke: color-mix(in srgb, var(--bio-k) 60%, black); stroke-width: 1.2; }
  .inact { fill: var(--text); }
  .mlabel { font-size: 12px; font-weight: 700; fill: var(--text); }
  .charge { font-size: 16px; font-weight: 800; fill: var(--text); letter-spacing: 0.05em; }
  .tag { font-size: 12px; font-weight: 800; fill: var(--ahl); }
  .lc { stroke: var(--accent); stroke-width: 3; fill: none; }
  .lctext { font-size: 12px; font-weight: 700; fill: var(--accent-strong); }
  .arrowhead { fill: var(--accent); }
  .electrode { stroke: var(--text-muted); stroke-width: 2.5; }
  .na { fill: var(--bio-na); }
  .k { fill: var(--bio-k); }
  .ion text { font-size: 10px; font-weight: 800; fill: #fff; }
  .scope { fill: var(--surface); stroke: var(--border-strong); }
  .grid line { stroke: var(--border); }
  .thr { stroke: var(--warn); stroke-width: 1.5; stroke-dasharray: 6 4; }
  .thrtext { font-size: 12px; font-weight: 700; fill: var(--warn); }
  .ticks text { font-size: 12px; fill: var(--text-muted); }
  .axis { font-size: 13px; font-weight: 650; fill: var(--text); }
  .trace { fill: none; stroke: var(--accent); stroke-width: 3; stroke-linejoin: round; stroke-linecap: round; }
  .trace.t3 { stroke: var(--text-muted); stroke-width: 2; stroke-dasharray: 6 4; }
  .dot { fill: var(--accent); }
  .legend text, .readout { font-size: 12px; font-weight: 700; fill: var(--text); }
</style>
