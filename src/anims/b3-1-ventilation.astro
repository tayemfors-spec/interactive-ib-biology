---
/** Ventilation of the lungs (B3.1.5). Drawn in the step-1 starting state; animated by b3-1-ventilation.ts. */
import { CX, DURATIONS, FRC, G, REST, RIB_W, RIB_Y, gx, gyP, gyV, thoraxShapes } from './b3-1-ventilation';

const s = thoraxShapes(REST);
const rib = (y: number, w: number, sign: 1 | -1) => {
  const X = (dx: number) => CX + sign * dx;
  return `M${X(10)} ${y} C${X(34)} ${y - 9} ${X(w - 6)} ${y - 8} ${X(w)} ${y + 12}`;
};
// intercostal fibres between ribs i and i+1, near the side of the chest
const fibres = (kind: 'ext' | 'int') => {
  const out: string[] = [];
  for (let i = 0; i < RIB_Y.length - 1; i++) {
    const y = RIB_Y[i]!, w = Math.min(RIB_W[i]!, RIB_W[i + 1]!);
    for (const sign of [-1, 1] as const) {
      for (const k of [0, 1]) {
        const x = CX + sign * (w - 10 - k * 13);
        // external fibres run down and towards the front (medially); internal fibres cross them
        const [a, b] = kind === 'ext' ? [-sign * 4, sign * 4] : [sign * 4, -sign * 4];
        out.push(`M${x + a} ${y + 9} L${x + b} ${y + 23}`);
      }
    }
  }
  return out.join(' ');
};
const total = DURATIONS.reduce((a, b) => a + b, 0);
const bounds = DURATIONS.reduce<number[]>((acc, d) => [...acc, (acc.at(-1) ?? 0) + d], []).slice(0, -1);
const vTicks = [1, 2, 3, 4];
const mids = DURATIONS.map((d, i) => DURATIONS.slice(0, i).reduce((a, b) => a + b, 0) + d * 0.5);
---
<svg viewBox="0 0 640 430" xmlns="http://www.w3.org/2000/svg" class="vent">
  <!-- ---------- thorax (front view) ---------- -->
  <path class="abd" data-el="abd" d={`M${CX - 92} 352 Q${CX} 372 ${CX + 92} 352 L${CX + 88} 398 Q${CX} 414 ${CX - 88} 398 Z`} />
  <g data-el="abd-arrows" class="arrows" style="opacity:0">
    <path d={`M${CX - 124} 376 h20`} /><path d={`M${CX + 124} 376 h-20`} /><path d={`M${CX - 82} 350 v-24`} /><path d={`M${CX + 82} 350 v-24`} />
  </g>
  <defs>
    <marker id="vent-a" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse"><path class="mk" d="M0 0 L10 5 L0 10 Z" /></marker>
  </defs>
  <path class="lung" data-el="lungL" d={s.lungL} />
  <path class="lung" data-el="lungR" d={s.lungR} />
  <path class="diaphragm" data-el="diaphragm" d={s.diaphragm} />
  <g data-el="ribs" transform={s.ribs}>
    <path class="sternum" d={`M${CX - 6} 100 h12 v170 h-12 Z`} />
    <g class="rib">{RIB_Y.map((y, i) => <><path d={rib(y, RIB_W[i]!, -1)} /><path d={rib(y, RIB_W[i]!, 1)} /></>)}</g>
    <path class="fib ext" data-el="ext" d={fibres('ext')} />
    <path class="fib int" data-el="int" d={fibres('int')} />
  </g>
  <path class="airway" d={`M${CX} 18 V96 M${CX} 96 L${CX - 34} 136 M${CX} 96 L${CX + 34} 136 M${CX - 22} 122 l-18 10 M${CX + 22} 122 l18 10`} />
  <g data-el="air-in" class="air"><path d={`M${CX + 20} 8 v40`} /><path class="head" d={`M${CX + 13} 40 l7 10 l7 -10`} /></g>
  <g data-el="air-out" class="air" style="opacity:0"><path d={`M${CX + 20} 50 v-40`} /><path class="head" d={`M${CX + 13} 18 l7 -10 l7 10`} /></g>
  <text class="lbl" x={CX + 34} y="30">air</text>
  <text class="lbl" x={CX - 6} y="30" text-anchor="end">trachea</text>
  <path class="lead" d={`M30 236 L56 236`} />
  <text class="lbl" x="2" y="241">lung</text>
  <path class="lead" d={`M${CX + 92} 172 L${CX + 112} 168`} />
  <text class="lbl" x={CX + 116} y="150">ribs and</text>
  <text class="lbl" x={CX + 116} y="168">intercostal</text>
  <text class="lbl" x={CX + 116} y="186">muscles</text>
  <text class="lbl" x={CX} y="338" text-anchor="middle">diaphragm</text>
  <text class="lbl" x={CX} y="426" text-anchor="middle">abdominal muscles</text>

  <!-- ---------- muscle status ---------- -->
  <g class="status">
    <text x="345" y="22">External intercostals: <tspan data-el="st-ext" class="on">contracting</tspan></text>
    <text x="345" y="44">Diaphragm: <tspan data-el="st-dia" class="on">contracting: flattens</tspan></text>
    <text x="345" y="66">Internal intercostals: <tspan data-el="st-int">relaxed</tspan></text>
    <text x="345" y="88">Abdominal muscles: <tspan data-el="st-abd">relaxed</tspan></text>
  </g>

  <!-- ---------- graphs ---------- -->
  <g class="graph">
    {bounds.map((b) => <line class="bound" x1={gx(b)} x2={gx(b)} y1={G.vTop - 6} y2={G.pMid + G.pHalf} />)}
    {mids.map((m, i) => <text class="stepn" x={gx(m)} y={G.vTop - 10} text-anchor="middle">step {i + 1}</text>)}
    <line class="axis-l" x1={G.x0} x2={G.x0} y1={G.vTop} y2={G.vBot} />
    <line class="axis-l" x1={G.x0} x2={G.x1} y1={G.vBot} y2={G.vBot} />
    {vTicks.map((v) => <><line class="tick" x1={G.x0 - 4} x2={G.x0} y1={gyV(v)} y2={gyV(v)} /><text class="tick-t" x={G.x0 - 8} y={gyV(v)} dy="0.35em" text-anchor="end">{v}</text></>)}
    <line class="rest" x1={G.x0} x2={G.x1} y1={gyV(FRC)} y2={gyV(FRC)} />
    <text class="g-title" transform={`translate(366 ${(G.vTop + G.vBot) / 2}) rotate(-90)`} text-anchor="middle">lung volume (dm³)</text>
    <path class="vtrace" data-el="vtrace" d={`M${gx(0)} ${gyV(FRC)}`} />
    <circle class="dot" data-el="vdot" cx={gx(0)} cy={gyV(FRC)} r="5" />

    <line class="atm" x1={G.x0} x2={G.x1} y1={G.pMid} y2={G.pMid} />
    <line class="axis-l" x1={G.x0} x2={G.x0} y1={G.pMid - G.pHalf} y2={G.pMid + G.pHalf} />
    <text class="g-title" transform={`translate(366 ${G.pMid}) rotate(-90)`} text-anchor="middle">pressure in lungs</text>
    <text class="tick-t" x={G.x0 + 4} y={G.pMid - G.pHalf + 4}>above atmospheric</text>
    <text class="tick-t" x={G.x0 + 4} y={G.pMid + G.pHalf + 12}>below atmospheric</text>
    <path class="ptrace" data-el="ptrace" d={`M${gx(0)} ${gyP(0)}`} />
    <circle class="dot p" data-el="pdot" cx={gx(0)} cy={gyP(0)} r="5" />
    <text class="tick-t" x={G.x1} y={G.pMid + G.pHalf + 34} text-anchor="end">time ({total} s shown) →</text>
  </g>
</svg>
<style>
  .vent { font-family: var(--font-sans); }
  .lbl { font-size: 15px; font-weight: 650; fill: var(--text); }
  .lung { fill: color-mix(in srgb, var(--bio-k) 22%, transparent); stroke: var(--bio-k); stroke-width: 2; }
  .airway { fill: none; stroke: var(--bio-head); stroke-width: 9; stroke-linecap: round; stroke-linejoin: round; }
  .sternum { fill: color-mix(in srgb, var(--text-muted) 30%, transparent); }
  .lead { stroke: var(--text); stroke-width: 1.3; }
  .mk { fill: var(--text); }
  .rib path { fill: none; stroke: var(--text-muted); stroke-width: 7; stroke-linecap: round; }
  .fib { fill: none; stroke: color-mix(in srgb, var(--bio-chol) 16%, transparent); stroke-width: 2.6; stroke-linecap: round; transition: stroke 0.2s; }
  .fib.on { stroke: var(--bio-chol); stroke-width: 3.4; }
  .diaphragm { fill: none; stroke: color-mix(in srgb, var(--bio-chol) 55%, transparent); stroke-width: 9; stroke-linecap: round; }
  .diaphragm.on { stroke: var(--bio-chol); }
  .abd { fill: color-mix(in srgb, var(--bio-chol) 12%, transparent); stroke: color-mix(in srgb, var(--bio-chol) 45%, transparent); stroke-width: 2; }
  .abd.on { fill: color-mix(in srgb, var(--bio-chol) 35%, transparent); stroke: var(--bio-chol); }
  .arrows path, .air path { fill: none; stroke: var(--text); stroke-width: 3; }
  .arrows path { marker-end: url(#vent-a); }
  .arrows path { stroke-width: 3.5; }
  .air path { stroke: var(--bio-water); stroke-width: 4; stroke-linecap: round; stroke-linejoin: round; transition: opacity 0.2s; }
  .status text { font-size: 15px; fill: var(--text-muted); }
  .status tspan { font-weight: 700; fill: var(--text-muted); }
  .status tspan.on { fill: var(--accent-strong); font-weight: 800; }
  .axis-l { stroke: var(--text); stroke-width: 1.4; }
  .tick { stroke: var(--text); }
  .tick-t { font-size: 13px; fill: var(--text-muted); }
  .g-title { font-size: 14px; font-weight: 700; fill: var(--text); }
  .stepn { font-size: 13px; font-weight: 700; fill: var(--text-muted); }
  .bound { stroke: var(--border-strong); stroke-dasharray: 3 4; }
  .rest { stroke: var(--text-muted); stroke-dasharray: 5 4; }
  .atm { stroke: var(--text-muted); stroke-width: 1.4; stroke-dasharray: 5 4; }
  .vtrace { fill: none; stroke: var(--bio-water); stroke-width: 3; stroke-linejoin: round; }
  .ptrace { fill: none; stroke: var(--bio-head); stroke-width: 3; stroke-linejoin: round; }
  .dot { fill: var(--bio-water); stroke: var(--surface); stroke-width: 2; }
  .dot.p { fill: var(--bio-head); }
</style>
