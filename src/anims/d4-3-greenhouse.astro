---
/**
 * The greenhouse effect and the enhanced greenhouse effect (D4.3.1), with ozone depletion shown as a
 * separate issue. Animated by d4-3-greenhouse.ts: elements carry data-from / data-to (the steps during
 * which they are visible). Drawn here in the step-1 start state.
 */
const wave = (x1: number, y1: number, x2: number, y2: number, amp = 5, wl = 16) => {
  const len = Math.hypot(x2 - x1, y2 - y1);
  const ux = (x2 - x1) / len, uy = (y2 - y1) / len;
  const n = Math.max(8, Math.round(len / 3));
  let d = '';
  for (let i = 0; i <= n; i++) {
    const s = (len * i) / n;
    // taper the wave to zero at the tip so the arrowhead sits on the line
    const a = amp * Math.sin((2 * Math.PI * s) / wl) * Math.min(1, (len - s) / 10);
    const x = x1 + ux * s - uy * a, y = y1 + uy * s + ux * a;
    d += `${i ? 'L' : 'M'}${x.toFixed(1)} ${y.toFixed(1)}`;
  }
  return d;
};

interface Mol { x: number; y: number; f: string; from: number }
const mols: Mol[] = [
  { x: 392, y: 150, f: 'CO₂', from: 3 }, { x: 468, y: 214, f: 'H₂O', from: 3 }, { x: 446, y: 108, f: 'CH₄', from: 3 }, { x: 366, y: 236, f: 'N₂O', from: 3 },
  { x: 318, y: 132, f: 'CO₂', from: 4 }, { x: 492, y: 152, f: 'CO₂', from: 4 }, { x: 420, y: 262, f: 'CH₄', from: 4 }, { x: 300, y: 214, f: 'CO₂', from: 4 },
];
// Short-wave radiation from the Sun (drawn straight)
const sw = [
  { d: 'M70 64 L118 292', from: 0 },
  { d: 'M80 62 L184 292', from: 0 },
  { d: 'M88 58 L244 290', from: 0 },
];
const reflect = 'M248 290 L330 64';
// Long-wave infrared from the surface (wavy). `to` = last step it is visible.
const ir = [
  { d: wave(322, 296, 322, 30), from: 2, to: 3 },          // escapes to space (until extra CO₂ appears)
  { d: wave(322, 296, 322, 152), from: 4, to: 5 },          // now absorbed by the extra CO₂ molecule
  { d: wave(394, 296, 392, 172), from: 2, to: 5 },
  { d: wave(470, 296, 468, 236), from: 2, to: 5 },
  { d: wave(440, 296, 446, 130), from: 2, to: 5 },
  { d: wave(500, 296, 524, 40), from: 2, to: 5 },           // a window: some IR always escapes
];
// Re-emission by greenhouse-gas molecules, in all directions
const re = [
  { d: wave(380, 166, 352, 288, 4, 13), from: 3 }, { d: wave(404, 136, 420, 46, 4, 13), from: 3 }, { d: wave(412, 152, 440, 150, 3, 12), from: 3 },
  { d: wave(462, 232, 450, 288, 4, 13), from: 3 }, { d: wave(484, 202, 512, 182, 3, 12), from: 3 },
  { d: wave(432, 120, 400, 104, 3, 12), from: 3 }, { d: wave(366, 254, 350, 288, 3, 12), from: 3 },
  { d: wave(316, 150, 296, 288, 4, 13), from: 4 }, { d: wave(310, 116, 296, 46, 4, 13), from: 4 },
  { d: wave(492, 170, 500, 288, 4, 13), from: 4 }, { d: wave(420, 280, 414, 290, 2, 10), from: 4 },
  { d: wave(296, 232, 276, 288, 3, 12), from: 4 },
];
const T = { x: 532, top: 110, bottom: 262 };
---
<svg viewBox="0 0 560 352" xmlns="http://www.w3.org/2000/svg" class="gh" aria-hidden="true">
  <defs>
    <marker id="gh-m-sw" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="11" markerHeight="11" markerUnits="userSpaceOnUse" orient="auto"><path d="M0 0 L10 5 L0 10 z" class="mk sw" /></marker>
    <marker id="gh-m-ir" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="11" markerHeight="11" markerUnits="userSpaceOnUse" orient="auto"><path d="M0 0 L10 5 L0 10 z" class="mk ir" /></marker>
    <marker id="gh-m-uv" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="11" markerHeight="11" markerUnits="userSpaceOnUse" orient="auto"><path d="M0 0 L10 5 L0 10 z" class="mk uv" /></marker>
  </defs>

  <!-- layers -->
  <rect class="atm" x="0" y="70" width="560" height="226" />
  <rect class="ozone" data-from="5" data-to="5" x="0" y="80" width="560" height="14" style="opacity:0" />
  <path class="ground" d="M0 296 L560 296 L560 352 L0 352 Z" />
  <rect class="ice" x="222" y="292" width="58" height="10" rx="3" />
  <g data-el="surface-glow" style="opacity:0"><rect class="glow" x="0" y="296" width="560" height="26" /></g>
  <text class="lbl" x="250" y="26">space</text>
  <text class="lbl" x="12" y="284">atmosphere</text>
  <text class="lbl" x="12" y="330">Earth's surface</text>
  <text class="lbl sm" x="251" y="320" text-anchor="middle">ice</text>

  <!-- Sun -->
  <circle class="sun" cx="50" cy="38" r="24" />
  <text class="lbl sunl" x="50" y="43" text-anchor="middle">Sun</text>

  <!-- short-wave radiation -->
  <g data-from="0" data-to="5">
    {sw.map((a) => <path class="swl" d={a.d} marker-end="url(#gh-m-sw)" />)}
    <path class="swl refl" d={reflect} marker-end="url(#gh-m-sw)" />
    <text class="lbl tag" x="84" y="22">short-wave radiation</text>
    <text class="lbl sm" x="300" y="112" text-anchor="end">reflected</text>
  </g>

  <!-- long-wave infrared -->
  {ir.map((a) => <path class="irl" d={a.d} marker-end="url(#gh-m-ir)" data-from={a.from} data-to={a.to} style="opacity:0" />)}
  <g data-from="2" data-to="2" style="opacity:0">
    <text class="lbl tag ir" x="300" y="270" text-anchor="end">long-wave</text>
    <text class="lbl tag ir" x="300" y="286" text-anchor="end">infrared</text>
  </g>

  <!-- re-emission -->
  {re.map((a) => <path class="rel" d={a.d} marker-end="url(#gh-m-ir)" data-from={a.from} data-to="5" style="opacity:0" />)}

  <!-- greenhouse gas molecules -->
  {mols.map((m) => (
    <g class={`mol ${m.from === 4 ? 'extra' : ''}`} data-from={m.from} data-to="5" style="opacity:0">
      <circle cx={m.x} cy={m.y} r="17" />
      <text x={m.x} y={m.y + 4.5} text-anchor="middle">{m.f}</text>
    </g>
  ))}
  <g data-from="4" data-to="5" style="opacity:0">
    <rect class="note" x="268" y="314" width="234" height="28" rx="8" />
    <text class="lbl" x="385" y="333" text-anchor="middle">CO₂ 280 → 425 ppm (1750–2024)</text>
  </g>

  <!-- ozone: a separate issue -->
  <g data-from="5" data-to="5" style="opacity:0">
    <path class="uvl" d="M76 58 L150 90" marker-end="url(#gh-m-uv)" />
    <path class="uvl thin" d="M84 52 L210 96 L262 290" marker-end="url(#gh-m-uv)" />
    <text class="lbl uvt" x="134" y="64">UV</text>
    <text class="lbl" x="548" y="76" text-anchor="end">stratospheric ozone layer</text>
    <rect class="hole" x="196" y="80" width="30" height="14" />
    <text class="lbl" x="190" y="116" text-anchor="end">thinned by CFCs</text>
  </g>

  <!-- thermometer -->
  <g class="thermo">
    <rect class="tube" x={T.x - 7} y={T.top} width="14" height={T.bottom - T.top} rx="7" />
    <circle class="bulb" cx={T.x} cy={T.bottom + 8} r="13" />
    <rect class="fill" data-el="thermo" x={T.x - 4} y={T.bottom - 40} width="8" height="46" rx="4" data-bottom={T.bottom + 6} data-top={T.top + 6} />
    <text class="lbl sm" x={T.x + 18} y={T.bottom + 34} text-anchor="end">surface</text>
    <text class="lbl sm" x={T.x + 18} y={T.bottom + 50} text-anchor="end">temp.</text>
  </g>
</svg>
<style>
  .gh { font-family: var(--font-sans); }
  .atm { fill: color-mix(in srgb, var(--bio-water) 9%, var(--surface)); }
  .ozone { fill: color-mix(in srgb, var(--bio-protein-2) 35%, var(--surface)); stroke: var(--bio-protein-2); stroke-width: 1; }
  .hole { fill: var(--surface); stroke: var(--bio-protein-2); stroke-dasharray: 3 3; }
  .ground { fill: color-mix(in srgb, var(--bio-tail) 35%, var(--surface)); stroke: color-mix(in srgb, var(--bio-tail) 60%, var(--text)); stroke-width: 1.5; }
  .ice { fill: var(--surface); stroke: var(--bio-water); stroke-width: 1.5; }
  .glow { fill: color-mix(in srgb, var(--bad) 30%, transparent); }
  .sun { fill: color-mix(in srgb, var(--warn) 70%, var(--surface)); stroke: var(--warn); stroke-width: 2; }
  .lbl { font-size: 13px; font-weight: 650; fill: var(--text); }
  .lbl.sm { font-size: 12px; font-weight: 600; fill: var(--text-muted); }
  .sunl { font-size: 12px; }
  .tag { fill: var(--warn); font-weight: 750; }
  .tag.ir { fill: var(--bad); }
  .uvt { fill: var(--bio-protein-2); font-weight: 800; }
  .swl { fill: none; stroke: var(--warn); stroke-width: 4; stroke-linecap: butt; }
  .swl.refl { stroke-dasharray: 8 5; stroke-width: 3; }
  .irl { fill: none; stroke: var(--bad); stroke-width: 2.6; }
  .rel { fill: none; stroke: var(--bad); stroke-width: 2; stroke-dasharray: 5 3; }
  .uvl { fill: none; stroke: var(--bio-protein-2); stroke-width: 3.5; }
  .uvl.thin { stroke-width: 2; stroke-dasharray: 6 4; }
  .mk.sw { fill: var(--warn); }
  .mk.ir { fill: var(--bad); }
  .mk.uv { fill: var(--bio-protein-2); }
  .mol circle { fill: var(--surface); stroke: var(--text); stroke-width: 1.8; }
  .mol.extra circle { stroke: var(--bad); stroke-width: 2.4; }
  .mol text { font-size: 12px; font-weight: 750; fill: var(--text); }
  .mol.lit circle { fill: color-mix(in srgb, var(--bad) 18%, var(--surface)); }
  .note { fill: var(--surface); stroke: var(--bad); stroke-width: 1.5; }
  .tube { fill: var(--surface); stroke: var(--text-muted); stroke-width: 1.5; }
  .bulb { fill: var(--bad); stroke: var(--text-muted); stroke-width: 1.5; }
  .fill { fill: var(--bad); }
</style>
