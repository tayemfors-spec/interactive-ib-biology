---
/**
 * The secretory pathway and clathrin-coated vesicles (B2.2.7–B2.2.9). Drawn in the step-1 start state;
 * animated by b2-2-secretion.ts. The plasma membrane is along the bottom, outside the cell below it.
 */
import { BOUND, CARGO_OUT, CLATHRIN_FREE, CR, CX_CL, ER, FREE, GOLGI, RECEPTORS, VR, Y, membrane, pocket, slots } from './b2-2-secretion';

const bottomRibo = Array.from({ length: 11 }, (_, i) => ER.x + 16 + i * 17).filter((x) => Math.abs(x - 200) > 16);
const topRibo = Array.from({ length: 11 }, (_, i) => ER.x + 16 + i * 17).filter((x) => !BOUND.some(([bx]) => Math.abs(bx - x) < 9));
const cisternae = Array.from({ length: GOLGI.n }, (_, i) => {
  const r = GOLGI.r0 - GOLGI.dr * i, h = 0.62 + i * 0.04;
  const x0 = GOLGI.cx - r * Math.sin(h), x1 = GOLGI.cx + r * Math.sin(h), y = GOLGI.cy - r * Math.cos(h);
  return `M${x0.toFixed(1)} ${y.toFixed(1)} A${r} ${r} 0 0 1 ${x1.toFixed(1)} ${y.toFixed(1)}`;
});
const pm = membrane({ m: 2, D: 0 }, { m: 60, D: 0 });
const recs = slots(pocket(CX_CL, 60, 0, CR), RECEPTORS, 0.33, 0.67);
const leg = (a: number) => {
  const c = Math.cos(a), s = Math.sin(a);
  // a bent leg: out from the hub, then a short kink
  const k = a + 0.7;
  return `M0 0 L${(c * 7).toFixed(1)} ${(s * 7).toFixed(1)} L${(c * 7 + Math.cos(k) * 4).toFixed(1)} ${(s * 7 + Math.sin(k) * 4).toFixed(1)}`;
};
const triskelion = [0, 1, 2].map((i) => leg(-Math.PI / 2 + (i * 2 * Math.PI) / 3)).join(' ');
const receptor = 'M0 0 V7 M-3.5 10.5 L0 7 L3.5 10.5';
---
<svg viewBox="0 0 560 400" xmlns="http://www.w3.org/2000/svg" class="sec">
  <rect class="outside" x="0" y={Y} width="560" height={400 - Y} />
  <text class="side" x="14" y="160">Cytoplasm</text>
  <text class="side" x="14" y="390">Outside the cell</text>
  <text class="lbl" x="14" y={Y - 12}>Plasma membrane</text>

  <!-- rough ER with bound ribosomes -->
  <text class="lbl" x={ER.x} y="50">Rough ER</text>
  <rect class="er" x={ER.x} y={ER.y} width={ER.w} height={ER.h} rx="16" />
  <g class="ribo">
    {topRibo.map((x) => <circle cx={x} cy={ER.y - 8} r="5.5" />)}
    {bottomRibo.map((x) => <circle cx={x} cy={ER.y + ER.h + 8} r="5.5" />)}
    {BOUND.map(([x, y]) => <circle class="active" cx={x} cy={y} r="6.5" />)}
    <circle class="active" cx={FREE[0]} cy={FREE[1]} r="6.5" />
  </g>
  <text class="lbl" x={FREE[0]} y={FREE[1] - 16} text-anchor="middle">Free ribosome</text>

  <!-- Golgi apparatus: cis face (convex) towards the ER, trans face towards the plasma membrane -->
  {cisternae.map((d) => <path class="golgi-o" d={d} />)}
  {cisternae.map((d) => <path class="golgi-i" d={d} />)}
  <text class="lbl" x="178" y="180" text-anchor="end">cis face</text>
  <text class="lbl" x="198" y="246" text-anchor="end">trans face</text>
  <text class="lbl" x="304" y="254">Golgi apparatus</text>

  <!-- legend -->
  <g class="legend">
    <g transform="translate(446 22)" class="tri"><path d={triskelion} /></g>
    <text class="lbl" x="460" y="26">clathrin</text>
    <g transform="translate(446 36)" class="rec"><path d={receptor} /></g>
    <text class="lbl" x="460" y="48">receptor</text>
    <circle class="lig" cx="446" cy="64" r="4" />
    <text class="lbl" x="460" y="68">cargo outside</text>
  </g>

  <!-- plasma membrane (both pockets are computed by the driver) -->
  <path data-el="pm" class="mem-o" d={pm} />
  <path data-el="pm" class="mem-i" d={pm} />

  <!-- receptors and the cargo they bind, outside the cell -->
  {recs.map((s) => <g data-el="rec" class="rec" transform={`translate(${s.p[0].toFixed(1)} ${(s.p[1] + 3).toFixed(1)})`}><path d={receptor} /></g>)}
  {CARGO_OUT.map(([x, y]) => <circle data-el="lig" class="lig" cx={x} cy={y} r="4" />)}

  <!-- vesicles -->
  <g data-el="ves" style="opacity:0"><circle class="ves-o" r={VR} /><circle class="ves-i" r={VR} /></g>
  <g data-el="clv" style="opacity:0"><circle class="ves-o" r={CR} /><circle class="ves-i" r={CR} /></g>

  <!-- free clathrin triskelia in the cytoplasm -->
  {CLATHRIN_FREE.map(([x, y]) => <g data-el="tri" class="tri" transform={`translate(${x} ${y})`}><path d={triskelion} /></g>)}

  <!-- proteins: three made on the rough ER (red), one by the free ribosome (purple), carbohydrate (green) -->
  {[0, 1, 2].map((p) => Array.from({ length: 6 }, () => <circle data-el={`p${p}`} class="cargo" cx={BOUND[p]![0]} cy={BOUND[p]![1]} r="3.3" style="opacity:0" />))}
  {Array.from({ length: 6 }, () => <circle data-el="fp" class="fprot" cx={FREE[0]} cy={FREE[1]} r="3.3" style="opacity:0" />)}
  {Array.from({ length: 6 }, () => <circle data-el="tag" class="carb" cx="0" cy="0" r="0" style="opacity:0" />)}
</svg>
<style>
  .sec { font-family: var(--font-sans); }
  .outside { fill: color-mix(in srgb, var(--bio-water) 9%, transparent); }
  .side { font-size: 13px; font-weight: 700; fill: var(--text-muted); }
  .lbl { font-size: 12.5px; font-weight: 650; fill: var(--text); }
  .er { fill: color-mix(in srgb, var(--bio-protein) 16%, var(--surface)); stroke: var(--bio-protein); stroke-width: 4; }
  .ribo circle { fill: var(--text); }
  .ribo .active { stroke: var(--surface); stroke-width: 1.5; }
  .golgi-o { fill: none; stroke: var(--bio-glucose); stroke-width: 10; stroke-linecap: round; }
  .golgi-i { fill: none; stroke: color-mix(in srgb, var(--bio-glucose) 22%, var(--surface)); stroke-width: 4; stroke-linecap: round; }
  .mem-o, .ves-o { fill: none; stroke: var(--bio-head); stroke-width: 8; stroke-linejoin: round; }
  .mem-i, .ves-i { fill: none; stroke: var(--bio-tail); stroke-width: 2.6; stroke-linejoin: round; }
  .tri path { fill: none; stroke: var(--bio-protein-2); stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; }
  .rec path { fill: none; stroke: var(--bio-protein); stroke-width: 2.2; stroke-linecap: round; }
  .lig { fill: var(--bio-glucose); stroke: color-mix(in srgb, var(--bio-glucose) 55%, black); stroke-width: 1; }
  .cargo { fill: var(--bio-k); stroke: color-mix(in srgb, var(--bio-k) 55%, black); stroke-width: 0.8; }
  .fprot { fill: var(--bio-protein-2); stroke: color-mix(in srgb, var(--bio-protein-2) 55%, black); stroke-width: 0.8; }
  .carb { fill: var(--bio-carb); }
</style>
