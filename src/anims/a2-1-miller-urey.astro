---
/** Miller–Urey apparatus (A2.1.4). Drawn in the step-1 starting state; animated by a2-1-miller-urey.ts. */
import { FOCUS, TUBES } from './a2-1-miller-urey';
const f0 = FOCUS[0]!;
---
<svg viewBox="0 0 520 380" xmlns="http://www.w3.org/2000/svg" class="mu">
  <defs>
    <clipPath id="mu-flask-clip"><circle cx="100" cy="290" r="45" /></clipPath>
  </defs>
  <!-- glass tubes: outer wall + bore -->
  {TUBES.map((d) => <path class="glass" d={d} />)}
  {TUBES.map((d) => <path class="bore" d={d} />)}
  <!-- liquid in the U-tube trap -->
  <path data-el="trap" class="trap-liquid" d="M330 322 Q330 340 312 340 H226 Q208 340 208 322" style="opacity:0" />

  <!-- boiling flask: the ocean -->
  <circle class="flask" cx="100" cy="290" r="48" />
  <rect class="neck" x="93" y="226" width="14" height="20" />
  <rect data-el="water" class="water" x="40" y="284" width="120" height="70" clip-path="url(#mu-flask-clip)" />
  {[0, 1, 2, 3, 4].map((i) => <circle data-bubble={i} class="bubble" cx={78 + i * 11} cy="326" r="3" />)}
  <path class="flame" d="M86 362 Q88 348 96 344 Q94 352 100 354 Q103 344 110 340 Q114 352 114 362 Z" />

  <!-- spark flask: the atmosphere -->
  <circle class="flask" cx="330" cy="118" r="66" />
  <line class="electrode" x1="238" y1="128" x2="306" y2="128" />
  <line class="electrode" x1="422" y1="128" x2="354" y2="128" />
  <circle class="terminal" cx="238" cy="128" r="5" />
  <circle class="terminal" cx="422" cy="128" r="5" />
  <path data-el="spark" class="spark" d="M306 128 l8 -8 l8 14 l8 -14 l8 14 l8 -14 l8 8" style="opacity:0" />
  <g data-el="gases" class="gas">
    <text x="300" y="96" text-anchor="middle">CH₄</text>
    <text x="358" y="96" text-anchor="middle">NH₃</text>
    <text x="304" y="164" text-anchor="middle">H₂</text>
    <text x="356" y="164" text-anchor="middle">H₂O</text>
  </g>
  <g data-el="gases-now" class="gas now" style="opacity:0">
    <text x="300" y="96" text-anchor="middle">CO₂</text>
    <text x="358" y="96" text-anchor="middle">N₂</text>
    <text x="330" y="164" text-anchor="middle">H₂O</text>
  </g>

  <!-- condenser jacket -->
  <rect class="jacket" x="314" y="198" width="32" height="64" rx="6" />
  <path class="coolant" d="M392 252 H350 M357 246 L350 252 L357 258" />
  <path class="coolant" d="M350 208 H392 M385 202 L392 208 L385 214" />
  <!-- sampling tap under the trap -->
  <line class="glass-thin" x1="268" y1="346" x2="268" y2="362" />
  <rect class="tap" x="261" y="352" width="14" height="6" rx="2" />

  <!-- moving material -->
  {[0, 1, 2, 3].map((i) => <circle data-vapour={i} class="vapour" r="4" cx="100" cy="226" />)}
  {[0, 1, 2].map((i) => <circle data-drop={i} class="drop" r="4" cx="330" cy="184" style="opacity:0" />)}
  {[0, 1].map((i) => <circle data-return={i} class="drop" r="3.5" cx="208" cy="322" style="opacity:0" />)}

  <!-- labels -->
  <text class="lbl" x="88" y="192" text-anchor="end">boiling</text>
  <text class="lbl" x="88" y="207" text-anchor="end">water</text>
  <text class="lbl em" x="88" y="222" text-anchor="end">‘ocean’</text>
  <text class="lbl" x="90" y="120" transform="rotate(-90 90 120)" text-anchor="middle">water vapour →</text>
  <text class="lbl" x="130" y="362">heat</text>
  <g data-el="gas-label">
    <text class="lbl" x="410" y="58">gas mixture</text>
    <text class="lbl em" x="410" y="74">‘atmosphere’</text>
  </g>
  <g data-el="now-label" style="opacity:0">
    <text class="lbl now-t" x="410" y="58">now thought:</text>
    <text class="lbl now-t" x="410" y="74">less reducing</text>
  </g>
  <text class="lbl" x="410" y="156">sparks</text>
  <text class="lbl em" x="410" y="172">‘lightning’</text>
  <text class="lbl" x="306" y="234" text-anchor="end">condenser</text>
  <text class="lbl" x="398" y="256">cold water in</text>
  <text class="lbl" x="398" y="212">out</text>
  <text class="lbl" x="269" y="328" text-anchor="middle">products collect</text>
  <text class="lbl" x="282" y="372">sample for analysis</text>

  <g class="day"><rect x="420" y="10" width="92" height="28" rx="6" /><text x="466" y="29" text-anchor="middle">Day <tspan data-el="day">0</tspan></text></g>

  <g data-el="results" class="results" style="opacity:0">
    <rect x="112" y="58" width="122" height="96" rx="8" />
    <text class="rt" x="121" y="78">After a week:</text>
    <text x="121" y="98">amino acids, e.g.</text>
    <text x="121" y="116">glycine, alanine,</text>
    <text x="121" y="134">+ other organics</text>
  </g>

  <rect data-el="focus" class="focus" x={f0[0]} y={f0[1]} width={f0[2]} height={f0[3]} rx="12" />
</svg>
<style>
  .mu { font-family: var(--font-sans); }
  .glass { fill: none; stroke: var(--border-strong); stroke-width: 11; stroke-linejoin: round; stroke-linecap: round; }
  .bore { fill: none; stroke: var(--surface); stroke-width: 6; stroke-linejoin: round; stroke-linecap: round; }
  .glass-thin { stroke: var(--border-strong); stroke-width: 5; }
  .flask { fill: color-mix(in srgb, var(--surface) 70%, transparent); stroke: var(--border-strong); stroke-width: 3; }
  .neck { fill: var(--surface); stroke: var(--border-strong); stroke-width: 2.5; }
  .water { fill: color-mix(in srgb, var(--bio-water) 45%, var(--surface)); }
  .trap-liquid { fill: none; stroke: var(--bio-chol); stroke-width: 6; stroke-linejoin: round; }
  .bubble { fill: var(--surface); stroke: var(--bio-water); stroke-width: 1.5; }
  .flame { fill: var(--bio-head); }
  .electrode { stroke: var(--text); stroke-width: 3; }
  .terminal { fill: var(--text); }
  .spark { fill: none; stroke: var(--bio-glucose); stroke-width: 3.5; stroke-linejoin: round; }
  .gas text { font-size: 15px; font-weight: 800; fill: var(--text); }
  .gas.now text { fill: var(--warn); }
  .jacket { fill: color-mix(in srgb, var(--bio-water) 25%, transparent); stroke: var(--bio-water); stroke-width: 2; }
  .coolant { fill: none; stroke: var(--bio-water); stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }
  .tap { fill: var(--text-muted); }
  .vapour { fill: var(--bio-water); opacity: 0.8; }
  .drop { fill: var(--bio-chol); }
  .lbl { font-size: 13px; fill: var(--text); }
  .lbl.em { fill: var(--text-muted); font-style: italic; }
  .now-t { fill: var(--warn); font-weight: 700; }
  .day rect { fill: var(--surface); stroke: var(--border-strong); }
  .day text { font-size: 14px; font-weight: 800; fill: var(--text); }
  .results rect { fill: var(--surface); stroke: var(--bio-chol); stroke-width: 2; }
  .results text { font-size: 12px; fill: var(--text); }
  .results .rt { font-weight: 800; }
  .focus { fill: none; stroke: var(--accent); stroke-width: 2.5; stroke-dasharray: 6 5; }
</style>
