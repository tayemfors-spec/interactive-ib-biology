---
/** Cohesion and adhesion (A1.1.3–A1.1.4). Drawn in the step-1 start state; animated by a1-1-cohesion-adhesion.ts. */
import { rng } from '../viewer3d/kit';
import {
  DISH_Y, FILM_Y, INNER, OUTER, SHEET_B, SITES, SURFACE_Y, TUBES, WALL_X, XY_BOT, XY_N, XY_SP, XY_TOP, XY_X,
  filmPath, hydrogens, meniscus, sheet, sheetBonds, skaterLegs, tubeWater,
} from './a1-1-cohesion-adhesion';

const [hA, hB] = hydrogens(0, 0, 0);
const deg = (r: number) => ((r * 180) / Math.PI).toFixed(1);
const f = (n: number) => n.toFixed(1);
const bondEnds = sheetBonds.map(([d, a, k]) => {
  const h = hydrogens(sheet[d]!.x, sheet[d]!.y, SHEET_B)[k];
  const o = sheet[a]!;
  const dx = o.x - h[0], dy = o.y - h[1], len = Math.hypot(dx, dy);
  return [h[0] + (dx / len) * 5, h[1] + (dy / len) * 5, o.x - (dx / len) * 9, o.y - (dy / len) * 9].map(f);
});
// neighbours of the two highlighted molecules (attraction arrows point towards them)
const near = (i: number) => sheet.filter((n, j) => j !== i && Math.hypot(n.x - sheet[i]!.x, n.y - sheet[i]!.y) < 48);
const arrows = (i: number) => near(i).map((n) => {
  const m = sheet[i]!;
  const dx = n.x - m.x, dy = n.y - m.y, len = Math.hypot(dx, dy);
  return `M${f(m.x + (dx / len) * 12)} ${f(m.y + (dy / len) * 12)} L${f(m.x + (dx / len) * 30)} ${f(m.y + (dy / len) * 30)}`;
});
const inner = sheet[INNER]!;
const outer = sheet[OUTER]!;

const rand = rng(41);
const soil: { x: number; y: number; r: number }[] = [];
for (let tries = 0; tries < 4000 && soil.length < 70; tries++) {
  const r = 8 + rand() * 9;
  const x = 306 + r + rand() * (188 - 2 * r);
  const y = 104 + r + rand() * (DISH_Y + 32 - 104 - 2 * r);
  if (soil.every((s) => Math.hypot(s.x - x, s.y - y) > s.r + r + 2.5)) soil.push({ x, y, r });
}
const bgWater: [number, number, number][] = [[300, 150, 0.4], [370, 200, 2.1], [440, 140, 3.7], [330, 260, 1.2], [420, 290, 4.4], [470, 220, 5.5], [250, 300, 2.8]];
---
<svg viewBox="0 0 520 340" xmlns="http://www.w3.org/2000/svg" class="coh">
  <defs>
    <marker id="ca-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 Z" class="arrowhead" /></marker>
    <clipPath id="ca-soilclip"><rect x="300" y="100" width="200" height={DISH_Y + 40 - 100} /></clipPath>
  </defs>

  <!-- 0 · cohesion -->
  <g data-el="p0">
    <rect class="water-bg" x="0" y={SURFACE_Y} width="520" height={340 - SURFACE_Y} />
    <line class="surface" x1="0" x2="520" y1={SURFACE_Y} y2={SURFACE_Y} />
    <text class="side" x="12" y="24">Air</text>
    <text class="side" x="12" y={SURFACE_Y + 22}>Water</text>
    <g class="hb">{bondEnds.map(([x1, y1, x2, y2]) => <line data-el="sb" x1={x1} y1={y1} x2={x2} y2={y2} />)}</g>
    {sheet.map((m, i) => (
      <g data-el="sm" transform={`translate(${f(m.x)} ${f(m.y)}) rotate(${deg(SHEET_B)})`}>
        {(i === INNER || i === OUTER) && <circle class="focus" r="15" />}
        <circle class="o" r="6.5" /><circle class="h" cx={f(hA[0])} cy={f(hA[1])} r="3.6" /><circle class="h" cx={f(hB[0])} cy={f(hB[1])} r="3.6" />
      </g>
    ))}
    <g data-el="pulls" style="opacity:0">
      {[...arrows(INNER), ...arrows(OUTER)].map((p) => <path class="pull" d={p} marker-end="url(#ca-arrow)" />)}
      <text class="note" x={f(outer.x + 26)} y="64">At the surface: pulled sideways and</text>
      <text class="note" x={f(outer.x + 26)} y="82">inwards only — no water above</text>
      <path class="lead" d={`M${f(outer.x + 22)} 78 L${f(outer.x + 6)} ${f(outer.y - 16)}`} />
      <text class="note" x="250" y="332" text-anchor="middle">Inside: pulled equally in all directions</text>
      <path class="lead" d={`M${f(inner.x)} 318 L${f(inner.x)} ${f(inner.y + 17)}`} />
    </g>
  </g>

  <!-- 1 · surface tension -->
  <g data-el="p1" style="display:none">
    <path class="water-bg" data-el="filmfill" d={`${filmPath(150)} L520 340 L0 340 Z`} />
    <path class="surface" data-el="film" d={filmPath(150)} />
    <text class="side" x="12" y="24">Air</text>
    <text class="side" x="12" y={FILM_Y + 40}>Water</text>
    <path class="legs" data-el="legs" d={skaterLegs(150)} />
    <g data-el="skater" transform="translate(150 0)">
      <ellipse class="insect" cx="0" cy={FILM_Y - 44} rx="40" ry="8" />
      <circle class="insect" cx="44" cy={FILM_Y - 46} r="6" />
      <path class="legs" d={`M48 ${FILM_Y - 50} l16 -14 M48 ${FILM_Y - 48} l20 -8`} />
    </g>
    <text class="note" x="260" y="70" text-anchor="middle">Pond skater (Gerris) standing on the surface</text>
    <text class="note" x="260" y="296" text-anchor="middle">The surface film bends under each foot but does not break:</text>
    <text class="note" x="260" y="314" text-anchor="middle">hydrogen bonds between surface molecules resist stretching</text>
  </g>

  <!-- 2 · xylem under tension -->
  <g data-el="p2" style="display:none">
    <rect class="soil" x="0" y="304" width="520" height="36" />
    <path class="root" d={`M${XY_X} 304 L${XY_X} 336 M${XY_X} 318 l-40 18 M${XY_X} 314 l46 22`} />
    <text class="side" x="512" y="330" text-anchor="end">Soil: roots take in water</text>
    <path class="leaf" d={`M${XY_X - 16} 64 C${XY_X - 70} 30, 70 20, 40 64 C80 96, ${XY_X - 70} 92, ${XY_X - 16} 70 Z`} />
    <text class="note" x="20" y="112">Leaf: water evaporates from</text>
    <text class="note" x="20" y="130">cell walls (transpiration)</text>
    {Array.from({ length: 5 }, () => <circle class="vapour" data-el="vap" cx={XY_X - 40} cy="58" r="4" style="opacity:0" />)}
    <path class="vessel" d={`M${XY_X - 16} ${XY_TOP - 8} L${XY_X - 16} ${XY_BOT + 8} M${XY_X + 16} ${XY_TOP - 8} L${XY_X + 16} ${XY_BOT + 8}`} />
    <g class="lignin">{Array.from({ length: 11 }, (_, i) => <path d={`M${XY_X - 16} ${XY_TOP + 6 + i * 21} h-5 M${XY_X + 16} ${XY_TOP + 6 + i * 21} h5`} />)}</g>
    <path class="xbonds" data-el="xbonds" d={`M${XY_X} ${XY_BOT + 11} L${XY_X} ${XY_TOP - 8}`} stroke-dasharray="3 2.5" stroke-dashoffset="0" />
    {Array.from({ length: XY_N + 1 }, (_, i) => <circle class="o" data-el="xm" cx={XY_X} cy={XY_BOT - i * XY_SP} r="6" />)}
    <text class="note" x={XY_X - 26} y="196" text-anchor="end">Xylem vessel</text>
    <g data-el="tension" style="opacity:0">
      <path class="pull" d={`M${XY_X + 40} 270 L${XY_X + 40} 110`} marker-end="url(#ca-arrow)" />
      <text class="note" x={XY_X + 54} y="166">Tension pulls the</text>
      <text class="note" x={XY_X + 54} y="184">water column up</text>
      <text class="note" x={XY_X + 54} y="216">Cohesion (hydrogen</text>
      <text class="note" x={XY_X + 54} y="234">bonds) keeps the</text>
      <text class="note" x={XY_X + 54} y="252">column unbroken</text>
    </g>
  </g>

  <!-- 3 · adhesion -->
  <g data-el="p3" style="display:none">
    <path class="water-bg" data-el="meniscus" d={meniscus(0)} />
    <rect class="wall" x="20" y="20" width={WALL_X - 20} height="310" />
    <text class="wall-t" transform={`translate(52 210) rotate(-90)`} text-anchor="middle">Polar wall: cellulose or glass</text>
    {SITES.map((y) => <><circle class="o" cx={WALL_X + 6} cy={y} r="6" /><text class="delta" x={WALL_X - 6} y={y - 9} text-anchor="end">δ−</text></>)}
    {bgWater.map(([x, y, b]) => (
      <g transform={`translate(${x} ${y}) rotate(${deg(b)})`}><circle class="o" r="6.5" /><circle class="h" cx={f(hA[0])} cy={f(hA[1])} r="3.6" /><circle class="h" cx={f(hB[0])} cy={f(hB[1])} r="3.6" /></g>
    ))}
    <g class="hb">{SITES.map((y) => <line data-el="ab" x1={WALL_X + 31} y1={y} x2={WALL_X + 13} y2={y} style="opacity:0" />)}</g>
    {SITES.map((y, i) => (
      <g data-el="aw" transform={`translate(${WALL_X + 80 + (i % 2) * 18} ${y}) rotate(232.3)`}><circle class="o" r="6.5" /><circle class="h" cx={f(hA[0])} cy={f(hA[1])} r="3.6" /><circle class="h" cx={f(hB[0])} cy={f(hB[1])} r="3.6" /></g>
    ))}
    <text class="note" x="300" y="44" text-anchor="middle">Water creeps up the wall: a curved meniscus</text>
    <text class="note" x="330" y="332" text-anchor="middle">δ+ hydrogens bond to the δ− wall (adhesion)</text>
  </g>

  <!-- 4 · capillary action -->
  <g data-el="p4" style="display:none">
    <rect class="water-bg" x="24" y={DISH_Y} width="244" height="40" />
    <path class="dish" d={`M24 ${DISH_Y - 14} L24 ${DISH_Y + 40} L268 ${DISH_Y + 40} L268 ${DISH_Y - 14}`} />
    {TUBES.map((tb) => (
      <>
        <path class="water-bg" data-el="tw" d={tubeWater(tb.x, tb.w, 4)} />
        <rect class="tube" x={tb.x} y={DISH_Y - 210} width={tb.w} height="240" />
      </>
    ))}
    <text class="note" x="146" y="44" text-anchor="middle">Narrower tube → higher rise</text>
    <rect class="water-bg" x="300" y={DISH_Y} width="200" height="40" data-el="soilwater" clip-path="url(#ca-soilclip)" />
    <g class="grain">{soil.map((s) => <circle cx={f(s.x)} cy={f(s.y)} r={f(s.r)} />)}</g>
    <rect class="soilbox" x="300" y="100" width="200" height={DISH_Y + 40 - 100} />
    <text class="note" x="400" y="62" text-anchor="middle">Soil: water is drawn up</text>
    <text class="note" x="400" y="80" text-anchor="middle">through the narrow pores</text>
  </g>
</svg>
<style>
  .coh { font-family: var(--font-sans); }
  .side { font-size: 14px; font-weight: 700; fill: var(--text-muted); }
  .note { font-size: 13px; fill: var(--text); }
  .water-bg { fill: color-mix(in srgb, var(--bio-water) 16%, var(--surface)); }
  .surface { fill: none; stroke: var(--bio-water); stroke-width: 2.5; }
  .o { fill: var(--bio-k); }
  .h { fill: var(--surface); stroke: var(--text-muted); stroke-width: 1.4; }
  .hb line { stroke: var(--text); stroke-width: 1.6; stroke-dasharray: 3 3; }
  .focus { fill: none; stroke: var(--bio-glucose); stroke-width: 2.5; }
  .pull { fill: none; stroke: var(--bio-glucose); stroke-width: 2.6; }
  .arrowhead { fill: var(--bio-glucose); }
  .lead { stroke: var(--text-muted); stroke-width: 1.2; fill: none; }
  .legs { fill: none; stroke: var(--text); stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
  .insect { fill: var(--text-muted); }
  .soil { fill: color-mix(in srgb, var(--bio-head) 35%, var(--surface)); }
  .root { stroke: color-mix(in srgb, var(--bio-head) 70%, var(--text)); stroke-width: 3; fill: none; stroke-linecap: round; }
  .leaf { fill: color-mix(in srgb, var(--bio-carb) 55%, var(--surface)); stroke: var(--bio-carb); stroke-width: 1.5; }
  .vapour { fill: var(--bio-water); }
  .vessel { stroke: var(--bio-carb); stroke-width: 4; fill: none; }
  .lignin path { stroke: var(--bio-carb); stroke-width: 3; }
  .xbonds { stroke: var(--text); stroke-width: 2; fill: none; }
  .wall { fill: color-mix(in srgb, var(--bio-carb) 28%, var(--surface)); stroke: var(--bio-carb); stroke-width: 1.5; }
  .wall-t { font-size: 13px; font-weight: 700; fill: var(--text); }
  .delta { font-size: 13px; font-weight: 700; font-style: italic; fill: var(--text); }
  .dish, .soilbox { fill: none; stroke: var(--text-muted); stroke-width: 2; }
  .tube { fill: none; stroke: var(--text-muted); stroke-width: 1.6; }
  .grain circle { fill: color-mix(in srgb, var(--bio-head) 55%, var(--surface)); stroke: color-mix(in srgb, var(--bio-head) 70%, var(--text)); stroke-width: 1; }
</style>
