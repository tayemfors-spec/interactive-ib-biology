---
/** Origin of mitochondria and chloroplasts by endosymbiosis (A2.2.12). Animated by a2-2-endosymbiosis.ts. */
import { A, CY, NUC, hostPath } from './a2-2-endosymbiosis';
const er = [
  `M${NUC.cx - 54} ${NUC.cy - 30} q -10 30 0 60`,
  `M${NUC.cx - 64} ${NUC.cy - 38} q -14 38 0 76`,
  `M${NUC.cx + 20} ${NUC.cy + 52} q 26 6 46 -10`,
];
const ribo: [number, number][] = [[-12, -5], [12, 6], [16, -6]];
const evidence = [
  ['Double membrane', 'inner one from the bacterium'],
  ['Own DNA', 'naked and circular'],
  ['70S ribosomes', 'like those of bacteria'],
  ['Binary fission', 'only from existing ones'],
  ['Bacterium-sized', 'about 1–10 µm'],
];
---
<svg viewBox="0 0 560 340" xmlns="http://www.w3.org/2000/svg" class="endo">
  <defs>
    <marker id="endo-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0 0 L10 5 L0 10 z" class="arrow-head" />
    </marker>
  </defs>
  <text class="side" x="10" y="22">Ancestral eukaryotic cell (host)</text>
  <path data-el="host" class="host" d={hostPath()} />
  <!-- nucleus (double membrane) and ER: the host already had these -->
  <circle class="nuc" cx={NUC.cx} cy={NUC.cy} r={NUC.r} />
  <circle class="nuc-in" cx={NUC.cx} cy={NUC.cy} r={NUC.r - 5} />
  <circle class="nucleolus" cx={NUC.cx + 8} cy={NUC.cy - 6} r="9" />
  <path class="er" d={er.join(' ')} />
  <text class="lbl" x={NUC.cx} y={NUC.cy + 62} text-anchor="middle">nucleus</text>

  <!-- copy of the endosymbiont made by binary fission -->
  <ellipse data-el="vesB" class="ves" rx="36" ry="21" style="opacity:0" transform={`translate(${A.inside[0]} ${A.inside[1]})`} />
  <g data-el="bactB" style="opacity:0" transform={`translate(${A.inside[0]} ${A.inside[1]})`}>
    <ellipse class="bact" rx="29" ry="14" />
    <path data-cristae class="cristae" style="opacity:0" d="M-16 -12 v14 M-6 12 v-14 M4 -12 v14 M14 12 v-13" />
    <circle class="dna" data-proof cx="-4" cy="2" r="5" />
    {ribo.map(([x, y]) => <circle class="ribo" data-proof cx={x} cy={y} r="1.9" />)}
  </g>
  <!-- the aerobic bacterium that becomes a mitochondrion -->
  <ellipse data-el="vesA" class="ves" rx="36" ry="21" style="opacity:0" transform={`translate(${A.start[0]} ${A.start[1]})`} />
  <g data-el="bactA" transform={`translate(${A.start[0]} ${A.start[1]})`}>
    <ellipse class="bact" rx="29" ry="14" />
    <path data-cristae class="cristae" style="opacity:0" d="M-16 -12 v14 M-6 12 v-14 M4 -12 v14 M14 12 v-13" />
    <circle class="dna" data-proof cx="-4" cy="2" r="5" />
    {ribo.map(([x, y]) => <circle class="ribo" data-proof cx={x} cy={y} r="1.9" />)}
  </g>
  <text data-el="lblA" class="lbl" x={A.start[0]} y={A.start[1] - 24} text-anchor="middle">aerobic bacterium</text>

  <!-- the cyanobacterium that becomes a chloroplast -->
  <ellipse data-el="vesC" class="ves" rx="39" ry="24" style="opacity:0" transform={`translate(${CY.start[0]} ${CY.start[1]})`} />
  <g data-el="cyano" style="opacity:0" transform={`translate(${CY.start[0]} ${CY.start[1]})`}>
    <ellipse class="cyan" rx="32" ry="17" />
    <path class="thyl" d="M-20 -6 h40 M-22 0 h44 M-20 6 h40" />
    <g data-grana style="opacity:0"><path class="grana" d="M-17 -9 v18 M-3 -9 v18 M11 -9 v18" /></g>
    <circle class="dna" data-proof cx="-6" cy="10" r="4.5" />
    {ribo.map(([x, y]) => <circle class="ribo" data-proof cx={x + 4} cy={y + 2} r="1.9" />)}
  </g>
  <text data-el="lblC" class="lbl" x={CY.start[0]} y={CY.start[1] + 36} text-anchor="middle" style="opacity:0">cyanobacterium</text>

  <!-- process arrows and labels -->
  <g data-el="atp" style="opacity:0">
    <path class="arrow" d={`M${A.inside[0] - 30} ${A.inside[1]} q -16 -8 -38 -6`} />
    <text class="lbl strong" x={A.inside[0] - 74} y={A.inside[1] - 12} text-anchor="end">ATP</text>
    <path class="arrow" d={`M${A.inside[0]} ${A.inside[1] - 58} q 3 16 0 32`} />
    <text class="lbl strong" x={A.inside[0] + 8} y={A.inside[1] - 50}>food</text>
  </g>
  <g data-el="genes" style="opacity:0">
    <path class="arrow dashed" d={`M${A.inside[0] - 30} ${A.inside[1] - 8} Q ${NUC.cx + 40} ${NUC.cy - 70} ${NUC.cx + 26} ${NUC.cy - 36}`} />
    <text class="lbl" x={NUC.cx - 44} y={NUC.cy - 92}>genes move to the nucleus</text>
  </g>
  <text data-el="lblMito" class="lbl strong" x={A.inside[0] + 6} y={A.inside[1] - 28} text-anchor="middle" style="opacity:0">mitochondria</text>
  <text data-el="lblChl" class="lbl strong" x={CY.inside[0] - 44} y={CY.inside[1] + 5} text-anchor="end" style="opacity:0">chloroplast</text>

  <g data-el="evidence" style="opacity:0">
    <rect class="panel" x="384" y="64" width="168" height="218" rx="10" />
    <text class="ev-title" x="396" y="90">Evidence</text>
    {evidence.map((e, k) => (
      <g transform={`translate(396 ${116 + k * 36})`}>
        <path class="tick" d="M0 -3 l5 5 l9 -10" />
        <text class="ev" x="20" y="0" dy="0.3em">{e[0]}</text>
        <text class="ev sub" x="20" y="16">{e[1]}</text>
      </g>
    ))}
  </g>
</svg>

<style>
  .endo { font-family: var(--font-sans); }
  .side { font-size: 13px; font-weight: 700; fill: var(--text-muted); }
  .host { fill: color-mix(in srgb, var(--bio-protein) 7%, var(--surface)); stroke: var(--bio-head); stroke-width: 4; stroke-linejoin: round; }
  .nuc { fill: color-mix(in srgb, var(--bio-na) 12%, var(--surface)); stroke: var(--bio-na); stroke-width: 2.4; }
  .nuc-in { fill: none; stroke: var(--bio-na); stroke-width: 2; }
  .nucleolus { fill: var(--bio-na); }
  .er { fill: none; stroke: var(--bio-protein); stroke-width: 3; stroke-linecap: round; }
  .ves { fill: none; stroke: var(--bio-head); stroke-width: 3; }
  .bact { fill: color-mix(in srgb, var(--bio-chol) 22%, var(--surface)); stroke: var(--bio-chol); stroke-width: 2.6; }
  .cristae { fill: none; stroke: var(--bio-chol); stroke-width: 2.2; stroke-linecap: round; }
  .cyan { fill: color-mix(in srgb, var(--bio-carb) 25%, var(--surface)); stroke: var(--bio-carb); stroke-width: 2.6; }
  .thyl { stroke: var(--bio-carb); stroke-width: 1.8; }
  .grana { stroke: var(--bio-carb); stroke-width: 6; }
  .dna { fill: none; stroke: var(--bio-na); stroke-width: 1.8; transition: stroke-width 0.3s; }
  .ribo { fill: var(--text); transition: r 0.3s; }
  .dna.on { stroke-width: 3; }
  .ribo.on { r: 2.8px; }
  .lbl { font-size: 13px; fill: var(--text); }
  .strong { font-weight: 750; }
  .arrow { fill: none; stroke: var(--text); stroke-width: 2; marker-end: url(#endo-arrow); }
  .dashed { stroke-dasharray: 5 4; }
  .arrow-head { fill: var(--text); }
  .panel { fill: var(--surface); stroke: var(--border-strong); stroke-width: 1.5; }
  .ev-title { font-size: 14px; font-weight: 800; fill: var(--text); }
  .ev { font-size: 12.5px; fill: var(--text); }
  .ev.sub { fill: var(--text-muted); }
  .tick { fill: none; stroke: var(--good); stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; }
</style>
