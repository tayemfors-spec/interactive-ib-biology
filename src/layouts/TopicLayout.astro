---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import MustKnow from '../components/content/MustKnow.astro';
import Mistakes from '../components/content/Mistakes.astro';
import Quiz from '../components/practice/Quiz.astro';
import Flashcards from '../components/practice/Flashcards.astro';
import TopicLink from '../components/content/TopicLink.astro';
import { parseSections } from '../lib/integrity';
import { idOf, levelLabel, themeSlug, themes, topics } from '../lib/syllabus';
import { SITE_NAME } from '../lib/site';
import { withBase } from '../lib/url';
import type { Flashcards as FlashcardsData, Quiz as QuizData, SyllabusTopic } from '../schemas';

interface Props {
  topic: CollectionEntry<'topics'>;
  syllabus: SyllabusTopic;
  quiz: QuizData;
  cards: FlashcardsData;
}
const { topic, syllabus: t, quiz, cards } = Astro.props;
const fm = topic.data;
const theme = themes.find((x) => x.id === t.theme)!;
const sections = parseSections(topic.body ?? '');
const published = new Set((await getCollection('topics')).map((x) => x.id));
const ordered = topics.filter((x) => published.has(idOf(x.code)));
const i = ordered.findIndex((x) => x.code === t.code);
const prev = i > 0 ? ordered[i - 1] : undefined;
const next = i < ordered.length - 1 ? ordered[i + 1] : undefined;
const title = `${t.code} ${t.title}`;
const site = Astro.site!;
const abs = (p: string) => new URL(withBase(p), site).href;
const hasAhl = t.status !== 'SL';

const jsonLd = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: SITE_NAME, item: abs('/') },
      { '@type': 'ListItem', position: 2, name: `Theme ${theme.id}: ${theme.title}`, item: abs(`themes/${themeSlug(theme.id)}`) },
      { '@type': 'ListItem', position: 3, name: title, item: abs(t.slug) },
    ],
  },
  {
    '@type': 'LearningResource',
    name: `${title} – interactive revision`,
    description: fm.description,
    url: abs(t.slug),
    inLanguage: 'en-GB',
    isAccessibleForFree: true,
    learningResourceType: ['Interactive resource', 'Quiz', 'Flashcards'],
    educationalLevel: 'IB Diploma Programme (ages 16–19)',
    teaches: t.understandings.map((u) => u.title),
    dateModified: fm.updated.toISOString().slice(0, 10),
    about: { '@type': 'Thing', name: 'Biology' },
    educationalAlignment: {
      '@type': 'AlignmentObject',
      alignmentType: 'educationalSubject',
      educationalFramework: 'IB Diploma Programme Biology (first assessment 2025)',
      targetName: title,
    },
  },
  {
    '@type': 'Quiz',
    name: `${title} flashcards`,
    about: { '@type': 'Thing', name: t.title },
    educationalAlignment: [
      { '@type': 'AlignmentObject', alignmentType: 'educationalSubject', targetName: 'Biology' },
      { '@type': 'AlignmentObject', alignmentType: 'educationalLevel', targetName: 'IB Diploma Programme' },
    ],
    hasPart: cards.cards.map((c) => ({
      '@type': 'Question',
      eduQuestionType: 'Flashcard',
      text: c.front,
      acceptedAnswer: { '@type': 'Answer', text: c.back },
    })),
  },
];
---
<BaseLayout title={title} description={fm.description} ogType="article" jsonLd={jsonLd} currentCode={t.code} ogTheme={t.theme.toLowerCase()}>
  <article class="topic" data-topic-code={t.code}>
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href={withBase('/')}>Home</a></li>
        <li><a href={withBase(`themes/${themeSlug(theme.id)}`)}>Theme {theme.id}: {theme.title}</a></li>
        <li><span>{t.organisation_level}</span></li>
        <li><span aria-current="page">{t.code}</span></li>
      </ol>
    </nav>

    <div data-pagefind-body>
      <header class="topic-head">
        <h1 data-pagefind-meta="title">{title}</h1>
        <p class="levels">
          {t.status === 'AHL' ? (
            <span class="badge badge-ahl">AHL only</span>
          ) : (
            <>
              <span class="badge badge-sl">SL &amp; HL</span>
              {hasAhl && <span class="badge badge-ahl">+ AHL sections</span>}
            </>
          )}
          <span class="lvl-text">{levelLabel(t.status)} · {t.organisation_level} · Theme {theme.id}</span>
        </p>
        <div class="big-q">
          <h2 class="bq-title">Big questions</h2>
          <ul>{t.big_questions.map((q) => <li>{q}</li>)}</ul>
        </div>
        {hasAhl && t.status !== 'AHL' && (
          <p class="ahl-note">Sections with a solid bar on the left are <strong>AHL</strong> (Higher Level only). SL students can hide them in <em>Display settings</em>.</p>
        )}
        <nav class="toc" aria-label="On this page">
          <h2 class="toc-title">On this page</h2>
          <ol>
            {sections.map((s) => (
              <li data-level-block={s.level}><a href={`#${s.id}`}>{s.title}</a>{s.level === 'AHL' && <span class="toc-ahl">AHL</span>}</li>
            ))}
            <li><a href="#must-know">Must-know definitions</a></li>
            <li><a href="#exam-mistakes">Common exam mistakes</a></li>
            <li><a href="#self-test">Self-test</a></li>
          </ol>
        </nav>
      </header>

      <div class="prose">
        <slot />
      </div>

      <MustKnow items={fm.mustKnow} />
      <Mistakes items={fm.mistakes} />
    </div>

    <section id="self-test" class="self-test" aria-labelledby="self-test-title" data-pagefind-ignore>
      <h2 id="self-test-title">Self-test</h2>
      <p>Answer the questions, then check. Your best score and the flashcards you know are saved in this browser only.</p>
      <Quiz code={t.code} quiz={quiz} />
      <Flashcards code={t.code} cards={cards} />
    </section>

    {fm.related.length > 0 && (
      <aside class="related" aria-labelledby="related-title">
        <h2 id="related-title">Connected topics</h2>
        <ul>{fm.related.map((c) => <li><TopicLink code={c} /></li>)}</ul>
      </aside>
    )}

    <nav class="pager" aria-label="Previous and next topic">
      {prev ? <a class="prev" href={withBase(prev.slug)}><span>Previous</span>{prev.code} {prev.title}</a> : <span />}
      {next ? <a class="next" href={withBase(next.slug)}><span>Next</span>{next.code} {next.title}</a> : <span />}
    </nav>
    <p class="updated">Last reviewed {fm.updated.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}. Spotted a mistake? <a href={withBase('about') + '#report-an-error'}>Report it</a>.</p>
  </article>
</BaseLayout>

<script>
  import { markSeen } from '../lib/progress';
  const code = document.querySelector<HTMLElement>('[data-topic-code]')?.dataset.topicCode;
  if (code) markSeen(code);
</script>

<style>
  .topic { max-width: var(--measure); margin: 0 auto; }
  .crumbs ol { display: flex; flex-wrap: wrap; gap: 0.25rem 0.5rem; list-style: none; padding: 0; margin: 0 0 var(--space-4); font-size: var(--step--1); color: var(--text-muted); }
  .crumbs li + li { margin: 0; }
  .crumbs li + li::before { content: '›'; margin-right: 0.5rem; color: var(--border-strong); }
  .topic-head h1 { margin-bottom: var(--space-3); }
  .levels { display: flex; flex-wrap: wrap; gap: var(--space-2); align-items: center; }
  .lvl-text { font-size: var(--step--1); color: var(--text-muted); }
  .big-q { padding: var(--space-3) var(--space-4); background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-m); margin: var(--space-4) 0; }
  .bq-title, .toc-title { font-size: var(--step--1); text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted); margin: 0 0 var(--space-2); }
  .big-q ul { margin: 0; padding-left: 1.2rem; }
  .ahl-note { font-size: var(--step--1); color: var(--text-muted); border-left: 4px solid var(--ink); padding-left: var(--space-3); }
  .toc { margin: var(--space-5) 0 0; }
  .toc ol { columns: 2 14rem; column-gap: var(--space-5); margin: 0; padding-left: 1.3rem; font-size: var(--step--1); }
  .toc li { break-inside: avoid; margin: 0 0 0.2rem; }
  .toc-ahl { margin-left: 0.4rem; font-size: 0.62rem; font-weight: 800; color: var(--text-muted); border: 1px solid currentColor; border-radius: 3px; padding: 0 0.25em; }
  .self-test { margin-top: var(--space-7); }
  .related ul { padding-left: 1.2rem; }
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3); margin-top: var(--space-7); }
  .pager a { display: block; padding: var(--space-3) var(--space-4); border: 1px solid var(--border); border-radius: var(--radius-m); background: var(--surface); text-decoration: none; font-weight: 650; }
  .pager a span { display: block; font-size: 0.78rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; }
  .pager .next { text-align: right; grid-column: 2; }
  .updated { margin-top: var(--space-5); font-size: var(--step--1); color: var(--text-muted); }
</style>
