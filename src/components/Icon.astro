---
// Small inline icon set (24px grid, stroke icons). Decorative by default.
const paths: Record<string, string> = {
  menu: 'M4 6h16M4 12h16M4 18h16',
  close: 'M6 6l12 12M18 6L6 18',
  search: 'M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14zM20 20l-4.2-4.2',
  settings: 'M4 7h10M18 7h2M4 17h4M12 17h8M14 4v6M8 14v6',
  play: 'M8 5.5v13l11-6.5z',
  pause: 'M8 5h3v14H8zM13 5h3v14h-3z',
  prev: 'M15 6l-6 6 6 6',
  next: 'M9 6l6 6-6 6',
  reset: 'M4 12a8 8 0 1 0 2.3-5.7M4 4v4h4',
  'zoom-in': 'M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14zM20 20l-4.2-4.2M8 11h6M11 8v6',
  'zoom-out': 'M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14zM20 20l-4.2-4.2M8 11h6',
  'rotate-left': 'M5 9a8 8 0 1 1-1 4M5 4v5h5',
  'rotate-right': 'M19 9a8 8 0 1 0 1 4M19 4v5h-5',
  tag: 'M3 12V4h8l10 10-8 8L3 12zM7.5 7.5h.01',
  expand: 'M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5',
  cube: 'M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3zM12 12l8-4.5M12 12v9M12 12L4 7.5',
  diagram: 'M4 5h16v14H4zM8 9h3M8 13h8M8 16h5',
  check: 'M5 12.5l4.5 4.5L19 7',
  x: 'M7 7l10 10M17 7L7 17',
  flip: 'M4 8h13l-3-3M20 16H7l3 3',
  book: 'M5 4h10a3 3 0 0 1 3 3v13H8a3 3 0 0 1-3-3V4zM5 17a3 3 0 0 1 3-3h10',
};
interface Props { name: keyof typeof paths | string; label?: string; size?: number }
const { name, label, size = 20 } = Astro.props;
const filled = name === 'play' || name === 'pause';
---
<svg
  class="icon"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={filled ? 'currentColor' : 'none'}
  stroke={filled ? 'none' : 'currentColor'}
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
><path d={paths[name]} /></svg>
