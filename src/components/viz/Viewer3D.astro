---
import { getEntry } from 'astro:content';
import Icon from '../Icon.astro';
import ProcessControls from './ProcessControls.astro';

/**
 * Interactive 3D model with an exam-style 2D diagram view.
 * The diagram (src/diagrams/<first scene module>.astro) is the first paint and the no-WebGL fallback;
 * three.js is only downloaded when the reader opens the 3D view.
 */
interface Props { topic: string; id: string }
const { topic, id } = Astro.props;
const entry = await getEntry('visuals', topic);
const visual = entry?.data.visuals.find((v) => v.id === id);
if (!visual || visual.kind !== 'viewer3d') throw new Error(`Viewer3D: no viewer3d visual "${id}" in ${topic}/visuals.yaml`);

const diagrams = import.meta.glob<{ default: any }>('../../diagrams/*.astro', { eager: true });
const Diagram = diagrams[`../../diagrams/${visual.scenes[0]!.module}.astro`]?.default;
if (!Diagram) throw new Error(`Viewer3D: missing exam diagram src/diagrams/${visual.scenes[0]!.module}.astro`);
const uid = `v-${topic}-${id}`;
const hasSteps = visual.scenes.some((s) => s.steps.length > 0);
---
<figure class="viz viewer3d" id={uid} data-viewer3d data-view="diagram" data-state="idle" data-level-block={visual.level} aria-labelledby={`${uid}-title`}>
  <div class="viz-head">
    <figcaption id={`${uid}-title`} class="viz-title">{visual.title}{visual.level === 'AHL' && <span class="badge badge-ahl">AHL</span>}</figcaption>
    <div class="view-switch" role="group" aria-label="View">
      <button class="btn" type="button" data-view-btn="diagram" aria-pressed="true"><Icon name="diagram" /> Exam diagram</button>
      <button class="btn" type="button" data-view-btn="3d" aria-pressed="false" data-needs-webgl><Icon name="cube" /> 3D model</button>
    </div>
  </div>

  {visual.scenes.length > 1 && (
    <div class="scene-switch" role="group" aria-label="Choose a model" data-3d-only hidden>
      {visual.scenes.map((s, i) => <button class="btn" type="button" data-scene={s.id} aria-pressed={i === 0 ? 'true' : 'false'}>{s.title}</button>)}
    </div>
  )}

  <div class="stage-wrap">
    <div class="diagram" data-diagram>
      <Diagram />
      <button class="btn btn-primary explore" type="button" data-view-btn="3d" data-needs-webgl><Icon name="cube" /> Explore in 3D</button>
    </div>
    <div
      class="stage"
      data-stage
      tabindex="0"
      role="application"
      aria-roledescription="3D model"
      aria-label={`${visual.title}: 3D model`}
      aria-describedby={`${uid}-keys`}
      hidden
    >
      <canvas aria-hidden="true"></canvas>
      <div class="labels" data-labels></div>
      <p class="loading" data-loading>Loading 3D model…</p>
    </div>
  </div>

  <div class="toolbar" data-3d-only hidden>
    <div class="cam" role="group" aria-label="Camera">
      <button class="btn btn-icon" type="button" data-cam="rotate-left"><Icon name="rotate-left" /><span class="visually-hidden">Rotate left</span></button>
      <button class="btn btn-icon" type="button" data-cam="rotate-right"><Icon name="rotate-right" /><span class="visually-hidden">Rotate right</span></button>
      <button class="btn btn-icon" type="button" data-cam="zoom-in"><Icon name="zoom-in" /><span class="visually-hidden">Zoom in</span></button>
      <button class="btn btn-icon" type="button" data-cam="zoom-out"><Icon name="zoom-out" /><span class="visually-hidden">Zoom out</span></button>
      <button class="btn btn-icon" type="button" data-cam="reset"><Icon name="reset" /><span class="visually-hidden">Reset view</span></button>
    </div>
    <button class="btn" type="button" data-labels-toggle aria-pressed="true"><Icon name="tag" /> Labels</button>
    <button class="btn" type="button" data-idle-toggle aria-pressed="false" hidden>Animate movement</button>
    <button class="btn btn-icon" type="button" data-fullscreen><Icon name="expand" /><span class="visually-hidden">Full screen</span></button>
  </div>
  <ol class="key3d" data-key3d data-3d-only hidden aria-label="Labels key"></ol>
  <p id={`${uid}-keys`} class="keys" data-3d-only hidden>
    Drag to rotate, pinch or scroll to zoom. Keyboard: click the model, then use the arrow keys to rotate, + and − to zoom, 0 to reset and L to toggle labels{hasSteps && ', Space to play or pause, and , or . to step'}. Tab moves through the labels.
  </p>

  {hasSteps && <div data-3d-only hidden><ProcessControls /></div>}
  <div class="info" data-info data-3d-only aria-live="polite" hidden></div>
  <p class="nowebgl" data-nowebgl hidden>Your browser can't show 3D graphics (WebGL is off or unsupported), so the exam diagram and text description are shown instead.</p>

  <details class="desc">
    <summary>Text description of this visual</summary>
    <p>{visual.description}</p>
    {visual.scenes.map((s) => (
      <>
        {visual.scenes.length > 1 && <p class="desc-scene"><strong>{s.title}</strong></p>}
        {s.labels.length > 0 && (
          <dl>{s.labels.map((l) => <div data-level-block={l.level}><dt>{l.name}</dt><dd>{l.text}</dd></div>)}</dl>
        )}
        {s.steps.length > 0 && (
          <ol>{s.steps.map((st) => <li data-level-block={st.level}><strong>{st.title}.</strong> {st.caption}</li>)}</ol>
        )}
      </>
    ))}
  </details>
  <script type="application/json" data-scenes set:html={JSON.stringify(visual.scenes)} />
</figure>

<script>
  import type { SceneDef } from '../../schemas';

  const hasWebGL = (() => {
    try {
      const c = document.createElement('canvas');
      return !!(c.getContext('webgl2') || c.getContext('webgl'));
    } catch { return false; }
  })();

  document.querySelectorAll<HTMLElement>('[data-viewer3d]').forEach((fig) => {
    const scenes = JSON.parse(fig.querySelector('[data-scenes]')!.textContent!) as SceneDef[];
    const stage = fig.querySelector<HTMLElement>('[data-stage]')!;
    const diagram = fig.querySelector<HTMLElement>('[data-diagram]')!;
    const loading = fig.querySelector<HTMLElement>('[data-loading]')!;
    const only3d = [...fig.querySelectorAll<HTMLElement>('[data-3d-only]')];
    let handle: { dispose(): void } | null = null;
    let loadingPromise: Promise<void> | null = null;

    if (!hasWebGL) {
      fig.dataset.state = 'fallback';
      fig.querySelectorAll<HTMLElement>('[data-needs-webgl]').forEach((b) => (b.hidden = true));
      fig.querySelector<HTMLElement>('[data-nowebgl]')!.hidden = false;
      return;
    }

    const setView = (view: 'diagram' | '3d') => {
      fig.dataset.view = view;
      diagram.hidden = view !== 'diagram';
      stage.hidden = view !== '3d';
      only3d.forEach((el) => (el.hidden = view !== '3d'));
      fig.querySelectorAll<HTMLButtonElement>('.view-switch [data-view-btn]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.viewBtn === view)));
      // The process block and info panel manage their own visibility once the scene loads.
      if (view === '3d') {
        fig.querySelector<HTMLElement>('[data-info]')!.hidden = false;
        if (!handle) fig.querySelectorAll<HTMLElement>('[data-process]').forEach((p) => (p.hidden = true));
      }
    };

    const load = () => {
      loadingPromise ??= (async () => {
        fig.dataset.state = 'loading';
        loading.hidden = false;
        try {
          const { mountViewer } = await import('../../viewer3d/runtime');
          const h = await mountViewer(fig, scenes);
          handle = h;
          (fig as HTMLElement & { viewer?: unknown }).viewer = h;
          fig.dataset.state = 'ready';
        } catch (err) {
          console.error('[viewer3d] failed to start', err);
          fig.dataset.state = 'error';
          setView('diagram');
          const note = fig.querySelector<HTMLElement>('[data-nowebgl]')!;
          note.textContent = 'The 3D model could not start on this device, so the exam diagram is shown instead.';
          note.hidden = false;
        } finally {
          loading.hidden = true;
        }
      })();
      return loadingPromise;
    };

    fig.querySelectorAll<HTMLButtonElement>('[data-view-btn]').forEach((b) =>
      b.addEventListener('click', async () => {
        const view = b.dataset.viewBtn as 'diagram' | '3d';
        setView(view);
        if (view === '3d') { await load(); stage.focus({ preventScroll: true }); }
      }),
    );

    fig.querySelector('[data-fullscreen]')?.addEventListener('click', () => {
      if (document.fullscreenElement) void document.exitFullscreen();
      else void fig.querySelector<HTMLElement>('.stage-wrap')!.requestFullscreen?.();
    });
    window.addEventListener('pagehide', () => handle?.dispose(), { once: true });
  });
</script>

<style>
  .viz { margin: var(--space-5) 0 var(--space-6); padding: var(--space-3); border: 1px solid var(--border); border-radius: var(--radius-l); background: var(--surface); }
  @media (min-width: 40rem) { .viz { padding: var(--space-4); } }
  .viz-head { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-3); align-items: center; justify-content: space-between; margin-bottom: var(--space-3); }
  .viz-title { font-weight: 750; font-size: var(--step-0); display: flex; gap: var(--space-2); align-items: center; }
  .view-switch, .scene-switch { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .scene-switch { margin-bottom: var(--space-3); }
  .stage-wrap { position: relative; border-radius: var(--radius-m); background: var(--surface-2); overflow: hidden; }
  .stage-wrap:fullscreen { background: var(--surface); display: grid; }
  .diagram { position: relative; padding: var(--space-3); display: flex; flex-direction: column; }
  .diagram :global(.exam-diagram > svg) { display: block; width: 100%; height: auto; }
  .explore { align-self: flex-end; margin-top: var(--space-3); box-shadow: var(--shadow); }
  .stage { position: relative; aspect-ratio: 4 / 3; max-height: 70svh; width: 100%; outline-offset: -3px; touch-action: none; }
  @media (max-width: 40rem) { .stage { aspect-ratio: 1 / 1; max-height: 65svh; } }
  .stage-wrap:fullscreen .stage { aspect-ratio: auto; max-height: none; height: 100%; }
  .stage canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .labels { position: absolute; inset: 0; pointer-events: none; }
  .labels :global(.label3d) {
    position: absolute; left: 0; top: 0; pointer-events: auto; cursor: pointer;
    margin: 0; padding: 0.2rem 0.55rem 0.2rem 1rem; min-height: 1.65rem; font: 650 0.78rem/1.3 var(--font-sans); white-space: nowrap;
    color: var(--text); background: color-mix(in srgb, var(--surface) 90%, transparent); border: 1px solid var(--border-strong); border-radius: 999px;
    translate: -0.45rem -50%; box-shadow: 0 1px 3px rgb(0 0 0 / 0.15);
  }
  .labels :global(.label3d)::before {
    content: ''; position: absolute; left: 0.25rem; top: 50%; width: 0.42rem; height: 0.42rem; margin-top: -0.21rem;
    border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 2px var(--surface);
  }
  .labels :global(.label3d[data-level='AHL'])::before { background: var(--ahl); }
  .labels :global(.label3d .n) { display: none; font-weight: 800; }
  /* Narrow stages (phones): show numbered markers only; tapping one shows its name in the info panel. */
  .viz.viewer3d { container-type: inline-size; }
  .key3d { display: none; }
  @container (max-width: 36rem) {
    .key3d:not([hidden]) { display: flex; flex-wrap: wrap; gap: var(--space-1); list-style: none; padding: 0; margin: var(--space-3) 0 0; }
    .key3d :global(li) { margin: 0; }
    .key3d :global(button) { font: 600 0.78rem/1.2 var(--font-sans); min-height: 1.9rem; padding: 0.2rem 0.55rem; border: 1px solid var(--border-strong); border-radius: 999px; background: var(--surface); color: var(--text); cursor: pointer; }
    .labels :global(.label3d) { padding: 0; width: 1.75rem; min-height: 1.75rem; display: grid; place-items: center; translate: -50% -50%; }
    .labels :global(.label3d)::before { display: none; }
    .labels :global(.label3d .t) { display: none; }
    .labels :global(.label3d .n) { display: inline; }
  }
  .labels :global(.label3d[aria-pressed='true']) { background: var(--accent); color: var(--on-accent); border-color: var(--accent); }
  .labels :global(.label3d.dimmed:not([aria-pressed='true'])) { opacity: 0.5; }
  .loading { position: absolute; inset: auto 0 45% 0; text-align: center; color: var(--text-muted); font-weight: 600; margin: 0; }
  .toolbar { display: flex; flex-wrap: wrap; gap: var(--space-2); align-items: center; margin-top: var(--space-3); }
  .cam { display: flex; gap: var(--space-1); margin-right: auto; }
  .keys { font-size: 0.8rem; color: var(--text-muted); margin: var(--space-2) 0 0; }
  .info { margin-top: var(--space-3); padding: var(--space-3) var(--space-4); border-left: 4px solid var(--accent); background: var(--surface-2); border-radius: 0 var(--radius-m) var(--radius-m) 0; min-height: 3.5rem; }
  .info :global(p) { margin: 0; }
  .info :global(.info-name) { font-weight: 750; margin-bottom: 0.2rem; display: flex; gap: var(--space-2); align-items: center; }
  .info :global(.hint) { color: var(--text-muted); font-size: var(--step--1); }
  .info :global(.info-name .n) { display: inline-grid; place-items: center; width: 1.5rem; height: 1.5rem; border-radius: 50%; background: var(--accent); color: var(--on-accent); font-size: 0.8rem; }
  .nowebgl { font-size: var(--step--1); color: var(--warn); margin: var(--space-2) 0 0; }
  .desc { margin-top: var(--space-3); font-size: var(--step--1); }
  .desc summary { cursor: pointer; font-weight: 650; color: var(--accent-strong); }
  .desc dl { display: grid; gap: var(--space-2); }
  .desc dt { font-weight: 700; }
  .desc dd { margin: 0; color: var(--text-muted); }
  [hidden] { display: none !important; }
</style>
