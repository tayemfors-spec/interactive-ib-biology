---
import { linePath, range, sx, sy, type Frame } from './chart';
import { mutationsPerCopy, rateText, simulate, type EvoParams } from './models/a2-3-evolution';

const d: EvoParams = { log10Rate: -4.5, generations: 100, population: 500, sites: 1, pressure: false };
const r = simulate(d);
const frame: Frame = {
  w: 640, h: 340, left: 60, right: 18, top: 16, bottom: 52,
  x: { min: 0, max: d.generations, ticks: range(0, 1, 0.2), label: 'Generations (replication cycles)' },
  y: { min: 0, max: 100, ticks: range(0, 100, 20), label: '% of virus population' },
};
const pct = (a: number[]) => (g: number) => 100 * a[Math.round(g)]!;
const tickX = (f: number) => sx(frame, f * d.generations);
const dots = Array.from({ length: 100 }, (_, i) => ({ x: 12 + (i % 10) * 22, y: 12 + Math.floor(i / 10) * 22 }));
const state = (s: { mutations: number; escaped: boolean }) => (s.escaped ? 'esc' : s.mutations > 0 ? 'mut' : 'anc');
const rows = range(0, d.generations, d.generations / 10).map((g) => Math.round(g));
const last = r.mutated.length - 1;
---
<div class="evo" data-evo data-frame={JSON.stringify(frame)}>
  <div class="layout">
    <div class="out">
      <svg class="chart" viewBox={`0 0 ${frame.w} ${frame.h}`} role="img" aria-labelledby="evo-t" data-chart>
        <title id="evo-t">Percentage of the virus population carrying new mutations and escape variants, against generations</title>
        <g class="grid">
          {frame.x.ticks.map((f) => <line x1={tickX(f)} x2={tickX(f)} y1={frame.top} y2={frame.h - frame.bottom} />)}
          {frame.y.ticks.map((t) => <line x1={frame.left} x2={frame.w - frame.right} y1={sy(frame, t)} y2={sy(frame, t)} />)}
        </g>
        <g class="ticks">
          {frame.x.ticks.map((f, i) => <text data-xtick={i} x={tickX(f)} y={frame.h - frame.bottom + 20} text-anchor="middle">{Math.round(f * d.generations)}</text>)}
          {frame.y.ticks.map((t) => <text x={frame.left - 8} y={sy(frame, t)} dy="0.35em" text-anchor="end">{t}</text>)}
        </g>
        <text class="axis" x={(frame.left + frame.w - frame.right) / 2} y={frame.h - 10} text-anchor="middle">{frame.x.label} →</text>
        <text class="axis" transform={`translate(17 ${(frame.top + frame.h - frame.bottom) / 2}) rotate(-90)`} text-anchor="middle">{frame.y.label} →</text>
        <path class="line mutated" data-line="mutated" d={linePath(frame, pct(r.mutated), d.generations)} />
        <path class="line escaped" data-line="escaped" d={linePath(frame, pct(r.escaped), d.generations)} />
      </svg>
      <div class="legend" aria-hidden="true">
        <span><span class="key mutated"></span> carry at least one new mutation</span>
        <span><span class="key escaped"></span> escape variants (all target sites changed)</span>
      </div>
      <div class="pop">
        <svg viewBox="0 0 224 224" class="dots" role="img" aria-labelledby="evo-dots-t" data-dots>
          <title id="evo-dots-t">A sample of 100 viruses from the final generation</title>
          {dots.map((p, i) => {
            const s = state(r.sample[i] ?? { mutations: 0, escaped: false });
            return <g transform={`translate(${p.x} ${p.y})`} data-dot={i} class={s}><circle class="c" r="7.5" /><rect class="dmd" x="-6.5" y="-6.5" width="13" height="13" transform="rotate(45)" /></g>;
          })}
        </svg>
        <ul class="dot-key">
          <li><span class="sw anc"></span> same as the original virus</li>
          <li><span class="sw mut"></span> mutated, still recognised</li>
          <li><span class="sw esc"></span> escape variant</li>
          <li class="dot-cap">A sample of 100 viruses from the last generation.</li>
        </ul>
      </div>
    </div>
    <div class="controls">
      <label class="slider">Mutation rate (per base, per copy): <output data-out="rate">{rateText(d.log10Rate)}</output>
        <input type="range" min="-8" max="-4" step="0.5" value={d.log10Rate} data-param="rate" />
        <span class="hint" data-hint="rate">≈ {mutationsPerCopy(d.log10Rate).toFixed(2)} new mutations per 10 000-base genome copied</span>
      </label>
      <label class="slider">Generations: <output data-out="gens">{d.generations}</output>
        <input type="range" min="10" max="200" step="10" value={d.generations} data-param="gens" />
      </label>
      <label class="slider">Population size: <output data-out="pop">{d.population}</output>
        <input type="range" min="100" max="2000" step="100" value={d.population} data-param="pop" />
      </label>
      <label class="slider">Target sites that must all change to escape: <output data-out="sites">{d.sites}</output>
        <input type="range" min="1" max="3" step="1" value={d.sites} data-param="sites" />
        <span class="hint">1 = one antibody or one drug; 3 = like three drugs taken together</span>
      </label>
      <label class="check"><input type="checkbox" data-param="pressure" /> Selection pressure from antibodies or a drug</label>
      <div class="presets">
        <span>Try:</span>
        <button class="btn" type="button" data-preset='{"rate":-8,"gens":100,"pop":1000,"sites":1,"pressure":true}'>DNA virus, proofreading</button>
        <button class="btn" type="button" data-preset='{"rate":-4.5,"gens":100,"pop":1000,"sites":1,"pressure":true}'>Influenza or HIV</button>
        <button class="btn" type="button" data-preset='{"rate":-4.5,"gens":100,"pop":1000,"sites":3,"pressure":true}'>HIV, three-drug therapy</button>
      </div>
    </div>
  </div>
  <p class="readout" aria-live="polite" data-readout>
    After {d.generations} generations: {r.meanMutations[last]!.toFixed(1)} new mutations per genome on average, {r.variants[last]} different variants among {d.population} viruses, and {(100 * r.escaped[last]!).toFixed(0)}% escape variants.
  </p>
  <details class="table">
    <summary>Show data table</summary>
    <table>
      <thead><tr><th scope="col">Generation</th><th scope="col">% mutated</th><th scope="col">% escape</th><th scope="col">Mean mutations</th><th scope="col">Variants</th></tr></thead>
      <tbody data-tbody>{rows.map((g) => <tr><th scope="row">{g}</th><td>{(100 * r.mutated[g]!).toFixed(0)}</td><td>{(100 * r.escaped[g]!).toFixed(0)}</td><td>{r.meanMutations[g]!.toFixed(1)}</td><td>{r.variants[g]}</td></tr>)}</tbody>
    </table>
  </details>
  <p class="model-note">Qualitative model: a 10 000-base genome copied once per generation, with seeded random mutations and no recombination or reassortment. It shows how mutation rate, generation number, population size and selection affect the speed of change, not real measurements.</p>
</div>

<script>
  import { linePath, range, type Frame } from './chart';
  import { mutationsPerCopy, rateText, simulate } from './models/a2-3-evolution';

  document.querySelectorAll<HTMLElement>('[data-evo]').forEach((root) => {
    const frame = JSON.parse(root.dataset.frame!) as Frame;
    const input = (k: string) => root.querySelector<HTMLInputElement>(`[data-param="${k}"]`)!;
    const out = (k: string, v: string) => (root.querySelector(`[data-out="${k}"]`)!.textContent = v);
    const readout = root.querySelector<HTMLElement>('[data-readout]')!;
    const tbody = root.querySelector<HTMLElement>('[data-tbody]')!;
    const dots = [...root.querySelectorAll<SVGGElement>('[data-dot]')];
    let raf = 0;
    let timer = 0;

    const run = () => {
      raf = 0;
      const p = { log10Rate: Number(input('rate').value), generations: Number(input('gens').value), population: Number(input('pop').value), sites: Number(input('sites').value), pressure: input('pressure').checked };
      out('rate', rateText(p.log10Rate)); out('gens', String(p.generations)); out('pop', String(p.population)); out('sites', String(p.sites));
      root.querySelector('[data-hint="rate"]')!.textContent = `≈ ${mutationsPerCopy(p.log10Rate) < 0.01 ? mutationsPerCopy(p.log10Rate).toExponential(0) : mutationsPerCopy(p.log10Rate).toFixed(2)} new mutations per 10 000-base genome copied`;
      const r = simulate(p);
      const f: Frame = { ...frame, x: { ...frame.x, max: p.generations } };
      root.querySelectorAll<SVGTextElement>('[data-xtick]').forEach((t) => { t.textContent = String(Math.round(Number(t.dataset.xtick) * 0.2 * p.generations)); });
      const pct = (a: number[]) => (g: number) => 100 * a[Math.round(g)]!;
      root.querySelector('[data-line="mutated"]')!.setAttribute('d', linePath(f, pct(r.mutated), p.generations));
      root.querySelector('[data-line="escaped"]')!.setAttribute('d', linePath(f, pct(r.escaped), p.generations));
      dots.forEach((g, i) => { const s = r.sample[i]; g.setAttribute('class', !s ? 'anc' : s.escaped ? 'esc' : s.mutations > 0 ? 'mut' : 'anc'); });
      tbody.innerHTML = range(0, p.generations, p.generations / 10).map((x) => Math.round(x))
        .map((g) => `<tr><th scope="row">${g}</th><td>${(100 * r.mutated[g]!).toFixed(0)}</td><td>${(100 * r.escaped[g]!).toFixed(0)}</td><td>${r.meanMutations[g]!.toFixed(1)}</td><td>${r.variants[g]}</td></tr>`).join('');
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        const L = r.mutated.length - 1;
        const esc = 100 * r.escaped[L]!;
        let extra = '';
        if (p.log10Rate <= -7) extra = ' With a proofreading DNA polymerase almost no variants arise in this time, so the virus changes very little.';
        else if (p.pressure && p.sites === 1 && esc > 50) extra = ' Escape variants have been selected and now dominate: antibodies or a single drug no longer work well, as in antigenic drift of influenza or drug resistance in HIV.';
        else if (p.pressure && p.sites > 1 && esc < 20) extra = ' Escape needs changes at several target sites at once, so it is much slower: this is why HIV is treated with a combination of drugs.';
        else if (!p.pressure && p.log10Rate >= -5) extra = ' Variation builds up quickly even without selection, giving natural selection plenty to act on.';
        readout.textContent = `After ${p.generations} generations: ${r.meanMutations[L]!.toFixed(1)} new mutations per genome on average, ${r.variants[L]} different variants among ${p.population} viruses, and ${esc.toFixed(0)}% escape variants.` + extra;
      }, 350);
    };
    const schedule = () => { if (!raf) raf = requestAnimationFrame(run); };
    root.querySelectorAll('[data-param]').forEach((el) => el.addEventListener('input', schedule));
    input('pressure').addEventListener('change', schedule);
    root.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((b) => b.addEventListener('click', () => {
      const p = JSON.parse(b.dataset.preset!) as Record<string, number | boolean>;
      for (const [k, v] of Object.entries(p)) {
        if (typeof v === 'boolean') input(k).checked = v; else input(k).value = String(v);
      }
      schedule();
    }));
  });
</script>

<style>
  .evo { container-type: inline-size; }
  .layout { display: grid; gap: var(--space-4); }
  @container (min-width: 46rem) { .layout { grid-template-columns: minmax(0, 1.6fr) minmax(15rem, 1fr); align-items: start; } }
  .chart { width: 100%; height: auto; font-family: var(--font-sans); }
  .grid line { stroke: var(--border); stroke-width: 1; }
  .ticks text { font-size: 15px; fill: var(--text-muted); }
  .axis { font-size: 16px; font-weight: 650; fill: var(--text); }
  .line { fill: none; stroke-width: 3.5; stroke-linecap: round; stroke-linejoin: round; }
  .mutated { stroke: var(--bio-protein); }
  .escaped { stroke: var(--bio-k); stroke-dasharray: 10 6; }
  .legend { display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-4); font-size: var(--step--1); color: var(--text-muted); margin-top: var(--space-1); }
  .legend > span { display: inline-flex; align-items: center; gap: var(--space-2); }
  .key { display: inline-block; width: 2rem; height: 0; border-top: 3.5px solid; }
  .key.mutated { border-color: var(--bio-protein); }
  .key.escaped { border-color: var(--bio-k); border-top-style: dashed; }
  .pop { display: flex; flex-wrap: wrap; gap: var(--space-3); align-items: center; margin-top: var(--space-3); }
  .dots { width: min(12rem, 48%); height: auto; background: var(--surface-2); border-radius: var(--radius-m); }
  .dots .c, .dots .dmd { stroke-width: 1.6; }
  .dots .anc .c { fill: var(--surface); stroke: var(--text-muted); }
  .dots .mut .c { fill: var(--bio-protein); stroke: var(--bio-protein); }
  .dots .esc .c, .dots :not(.esc) > .dmd { display: none; }
  .dots .esc .dmd { fill: var(--bio-k); stroke: var(--text); }
  .dot-key { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-1); font-size: var(--step--1); flex: 1 1 10rem; }
  .dot-key li { display: flex; align-items: center; gap: var(--space-2); margin: 0; }
  .dot-key .dot-cap { color: var(--text-muted); font-size: 0.8rem; }
  .sw { display: inline-block; width: 0.9rem; height: 0.9rem; border-radius: 50%; border: 1.6px solid var(--text-muted); flex: none; }
  .sw.anc { background: var(--surface); }
  .sw.mut { background: var(--bio-protein); border-color: var(--bio-protein); }
  .sw.esc { background: var(--bio-k); border-color: var(--text); border-radius: 2px; transform: rotate(45deg) scale(0.85); }
  .controls { display: grid; gap: var(--space-3); font-size: var(--step--1); }
  .slider { display: grid; gap: var(--space-1); font-weight: 600; }
  .hint { font-weight: 400; color: var(--text-muted); font-size: 0.8rem; }
  .check { display: flex; gap: var(--space-2); align-items: center; font-weight: 600; min-height: 24px; }
  .check input { width: 1.1rem; height: 1.1rem; }
  output { font-weight: 800; color: var(--accent-strong); }
  .presets { display: flex; flex-wrap: wrap; gap: var(--space-2); align-items: center; }
  .readout { margin: var(--space-3) 0 0; padding: var(--space-3); background: var(--surface-2); border-radius: var(--radius-m); font-size: var(--step--1); }
  .table { margin-top: var(--space-2); font-size: var(--step--1); }
  .table summary { cursor: pointer; font-weight: 650; color: var(--accent-strong); }
  .table { overflow-x: auto; }
  table { border-collapse: collapse; margin-top: var(--space-2); font-variant-numeric: tabular-nums; }
  th, td { padding: 0.2rem 0.7rem; border-bottom: 1px solid var(--border); text-align: right; }
  .model-note { font-size: 0.8rem; color: var(--text-muted); margin: var(--space-2) 0 0; }
</style>
