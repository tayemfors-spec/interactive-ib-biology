---
import { linePath, range, sx, sy, type Frame } from './chart';
import { CAPILLARY_RADIUS_MM, START_READING, distanceMoved, rateFromReadings, readingAt, type Setup } from './models/c1-2-respirometer';

const frame: Frame = {
  w: 560, h: 330, left: 58, right: 18, top: 16, bottom: 52,
  x: { min: 0, max: 10, ticks: range(0, 10, 2), label: 'Time (min)' },
  y: { min: 0, max: 100, ticks: range(0, 100, 20), label: 'Distance moved (mm)' },
};
const defaults: Setup = { tempC: 20, massG: 5, sample: 'germinating', absorber: true };
const minutes = 5;
const control: Setup = { ...defaults, sample: 'beads' };
const paths = {
  test: linePath(frame, (t) => distanceMoved(defaults, t), 100),
  control: linePath(frame, (t) => distanceMoved(control, t), 20),
};
const rows = range(0, 10, 1).map((t) => ({ t, r: readingAt(defaults, t), d: distanceMoved(defaults, t) }));
const calc = rateFromReadings(START_READING, readingAt(defaults, minutes), minutes, defaults.massG);

// apparatus geometry (SVG units): capillary scale from x0 (reading 0) to x0 + 100·k (reading 100)
const cap = { x0: 196, k: 3.4, y: 64 };
const dropX = (reading: number) => cap.x0 + reading * cap.k;
const scaleTicks = range(0, 100, 10);
const fmt = (v: number, dp = 1) => v.toFixed(dp);
---
<div class="sim-resp" data-sim-resp data-frame={JSON.stringify(frame)} data-cap={JSON.stringify(cap)}>
  <div class="layout">
    <div class="rig">
      <svg class="apparatus" viewBox="0 0 560 290" role="img" aria-labelledby="rs-t rs-d">
        <title id="rs-t">Simple respirometer</title>
        <desc id="rs-d">A sealed boiling tube in a water bath holds germinating seeds on a wire gauze above potassium hydroxide solution, which absorbs carbon dioxide. A horizontal capillary tube with a millimetre scale leads from the bung. A drop of coloured fluid in the capillary moves towards the tube as the seeds use oxygen.</desc>
        <rect class="bath" data-bath x="40" y="70" width="130" height="212" rx="10" />
        <text class="small" x="105" y="272" text-anchor="middle">water bath</text>
        <text class="temp" data-temp-label x="105" y="252" text-anchor="middle">20 °C</text>
        <!-- boiling tube -->
        <path class="glass" d="M78 44 V196 a27 27 0 0 0 54 0 V44" />
        <rect class="bung" x="72" y="34" width="66" height="22" rx="4" />
        <!-- KOH below gauze -->
        <path class="koh" data-koh d="M80 168 V196 a25 25 0 0 0 50 0 V168 Z" />
        <line class="gauze" x1="80" y1="160" x2="130" y2="160" />
        <g data-seeds>
          {[[90, 150], [104, 151], [118, 150], [96, 138], [111, 139], [124, 140], [88, 127], [103, 126], [118, 127], [97, 114], [112, 114]].map(([x, y]) => <ellipse class="seed" data-seed cx={x} cy={y} rx="7" ry="5.5" />)}
        </g>
        <text class="small lbl" x="146" y="132">seeds</text>
        <text class="small lbl" data-koh-label x="146" y="190">KOH (absorbs CO₂)</text>
        <!-- capillary and scale -->
        <path class="glass thin" d={`M105 34 V${cap.y} H${cap.x0 + 100 * cap.k + 14}`} />
        <rect class="scale" x={cap.x0 - 6} y={cap.y + 8} width={100 * cap.k + 12} height="26" rx="3" />
        {scaleTicks.map((v) => (
          <g>
            <line class="tick" x1={dropX(v)} x2={dropX(v)} y1={cap.y + 8} y2={cap.y + (v % 50 === 0 ? 20 : 15)} />
            <text class="tick-t" x={dropX(v)} y={cap.y + 31} text-anchor="middle">{v}</text>
          </g>
        ))}
        <text class="small" x={cap.x0 + 50 * cap.k} y={cap.y + 52} text-anchor="middle">capillary scale (mm)</text>
        <line class="start" x1={dropX(START_READING)} x2={dropX(START_READING)} y1={cap.y - 16} y2={cap.y + 6} />
        <text class="small" x={dropX(START_READING)} y={cap.y - 20} text-anchor="middle">start</text>
        <rect class="drop" data-drop x={dropX(readingAt(defaults, minutes)) - 7} y={cap.y - 4} width="14" height="8" rx="3" />
        <text class="small" x="420" y="150">◀ drop moves towards the tube</text>
        <text class="small" x="420" y="168">as O₂ is used</text>
        <text class="reading" data-reading-label x="300" y="244">Reading after {minutes} min: {fmt(readingAt(defaults, minutes))} mm</text>
      </svg>
      <svg class="chart" viewBox={`0 0 ${frame.w} ${frame.h}`} role="img" aria-labelledby="rc-t">
        <title id="rc-t">Distance moved by the drop against time</title>
        <g class="grid">
          {frame.x.ticks.map((t) => <line x1={sx(frame, t)} x2={sx(frame, t)} y1={frame.top} y2={frame.h - frame.bottom} />)}
          {frame.y.ticks.map((t) => <line x1={frame.left} x2={frame.w - frame.right} y1={sy(frame, t)} y2={sy(frame, t)} />)}
        </g>
        <g class="ticks">
          {frame.x.ticks.map((t) => <text x={sx(frame, t)} y={frame.h - frame.bottom + 18} text-anchor="middle">{t}</text>)}
          {frame.y.ticks.map((t) => <text x={frame.left - 8} y={sy(frame, t)} dy="0.35em" text-anchor="end">{t}</text>)}
        </g>
        <text class="axis" x={(frame.left + frame.w - frame.right) / 2} y={frame.h - 10} text-anchor="middle">{frame.x.label} →</text>
        <text class="axis" transform={`translate(16 ${(frame.top + frame.h - frame.bottom) / 2}) rotate(-90)`} text-anchor="middle">{frame.y.label} →</text>
        <path class="line control" d={paths.control} data-line="control" />
        <path class="line test" d={paths.test} data-line="test" />
        <line class="marker" data-marker x1={sx(frame, minutes)} x2={sx(frame, minutes)} y1={frame.top} y2={frame.h - frame.bottom} />
        <circle class="dot" data-dot cx={sx(frame, minutes)} cy={sy(frame, distanceMoved(defaults, minutes))} r="5" />
      </svg>
      <p class="key"><span class="k test"></span> Your tube <span class="k control"></span> Control tube (glass beads)</p>
    </div>
    <div class="controls">
      <fieldset class="choice">
        <legend>In the tube</legend>
        <label><input type="radio" name="resp-sample" value="germinating" checked data-sample /> Germinating seeds</label>
        <label><input type="radio" name="resp-sample" value="boiled" data-sample /> Boiled (dead) seeds</label>
        <label><input type="radio" name="resp-sample" value="beads" data-sample /> Glass beads only</label>
      </fieldset>
      <label class="check"><input type="checkbox" checked data-absorber /> CO₂ absorber (KOH) in the tube</label>
      <label class="slider">Temperature: <output data-out="temp">{defaults.tempC} °C</output>
        <input type="range" min="5" max="45" step="1" value={defaults.tempC} data-param="temp" />
      </label>
      <label class="slider">Mass of seeds: <output data-out="mass">{defaults.massG} g</output>
        <input type="range" min="1" max="10" step="1" value={defaults.massG} data-param="mass" />
      </label>
      <label class="slider">Time since the start: <output data-out="time">{minutes} min</output>
        <input type="range" min="0" max="10" step="0.5" value={minutes} data-param="time" />
      </label>
    </div>
  </div>
  <div class="working" data-working aria-live="polite">
    <p><strong>Distance moved</strong> = start − end reading = {START_READING} − {fmt(readingAt(defaults, minutes))} = {fmt(calc.distance)} mm</p>
    <p><strong>Volume of O₂ used</strong> = πr²d = 3.14 × {CAPILLARY_RADIUS_MM}² × {fmt(calc.distance)} = {fmt(calc.volume)} mm³</p>
    <p><strong>Rate</strong> = {fmt(calc.volume)} ÷ {minutes} min = {fmt(calc.perMin, 2)} mm³ min⁻¹, or {fmt(calc.perGramPerMin, 2)} mm³ g⁻¹ min⁻¹ for {defaults.massG} g of seeds</p>
  </div>
  <p class="note" data-note>The capillary has an internal radius of {CAPILLARY_RADIUS_MM} mm. Move the time slider to read the scale at different times.</p>
  <details class="table">
    <summary>Show data table</summary>
    <table>
      <thead><tr><th scope="col">Time (min)</th><th scope="col">Scale reading (mm)</th><th scope="col">Distance moved (mm)</th></tr></thead>
      <tbody data-tbody>{rows.map((r) => <tr><th scope="row">{r.t}</th><td>{fmt(r.r)}</td><td>{fmt(r.d)}</td></tr>)}</tbody>
    </table>
  </details>
  <p class="model-note">Qualitative model with illustrative values: the rate roughly doubles for every 10 °C rise until enzymes begin to denature above about 40 °C. Real seeds vary, and in a real experiment a control tube is also needed to correct for changes in temperature and air pressure.</p>
</div>

<script>
  import { linePath, range, sx, sy, type Frame } from './chart';
  import { CAPILLARY_RADIUS_MM, START_READING, distanceMoved, offScale, rateFromReadings, readingAt, type Sample, type Setup } from './models/c1-2-respirometer';

  document.querySelectorAll<HTMLElement>('[data-sim-resp]').forEach((root) => {
    const frame = JSON.parse(root.dataset.frame!) as Frame;
    const cap = JSON.parse(root.dataset.cap!) as { x0: number; k: number; y: number };
    const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const num = (k: string) => Number(q<HTMLInputElement>(`[data-param="${k}"]`).value);
    const out = (k: string, v: string) => (q(`[data-out="${k}"]`).textContent = v);
    const fmt = (v: number, dp = 1) => v.toFixed(dp);
    let timer = 0;

    const update = () => {
      const sample = (q<HTMLInputElement>('[data-sample]:checked').value) as Sample;
      const s: Setup = { tempC: num('temp'), massG: num('mass'), sample, absorber: q<HTMLInputElement>('[data-absorber]').checked };
      const t = num('time');
      out('temp', `${s.tempC} °C`); out('mass', `${s.massG} g`); out('time', `${t} min`);
      const reading = readingAt(s, t);
      const d = distanceMoved(s, t);
      const c = rateFromReadings(START_READING, reading, t, s.massG);

      // apparatus
      q('[data-drop]').setAttribute('x', String(cap.x0 + reading * cap.k - 7));
      q('[data-reading-label]').textContent = `Reading after ${t} min: ${fmt(reading)} mm`;
      q('[data-temp-label]').textContent = `${s.tempC} °C`;
      const warm = (s.tempC - 5) / 40;
      q<SVGElement>('[data-bath]').style.fill = `color-mix(in srgb, var(--bio-k) ${Math.round(8 + warm * 22)}%, var(--bio-water) ${Math.round(28 - warm * 20)}%)`;
      q<SVGElement>('[data-koh]').style.opacity = s.absorber ? '1' : '0.1';
      q('[data-koh-label]').textContent = s.absorber ? 'KOH (absorbs CO₂)' : 'no CO₂ absorber';
      root.querySelectorAll<SVGElement>('[data-seed]').forEach((e) => {
        e.style.display = sample === 'beads' ? 'none' : '';
        e.classList.toggle('dead', sample === 'boiled');
      });
      root.querySelectorAll<SVGElement>('[data-seeds]').forEach((g) => g.classList.toggle('beads', sample === 'beads'));

      // graph
      const control: Setup = { ...s, sample: 'beads' };
      q('[data-line="test"]').setAttribute('d', linePath(frame, (x) => distanceMoved(s, x), 100));
      q('[data-line="control"]').setAttribute('d', linePath(frame, (x) => distanceMoved(control, x), 20));
      const mx = sx(frame, t).toFixed(1);
      q('[data-marker]').setAttribute('x1', mx); q('[data-marker]').setAttribute('x2', mx);
      q('[data-dot]').setAttribute('cx', mx); q('[data-dot]').setAttribute('cy', sy(frame, d).toFixed(1));
      q('[data-tbody]').innerHTML = range(0, 10, 1)
        .map((m) => `<tr><th scope="row">${m}</th><td>${fmt(readingAt(s, m))}</td><td>${fmt(distanceMoved(s, m))}</td></tr>`).join('');

      // working and notes (debounced so screen readers are not flooded)
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        const lines = t === 0
          ? ['<p>Move the time slider: at 0 min the drop is still at the start mark, so no rate can be calculated yet.</p>']
          : [
            `<p><strong>Distance moved</strong> = start − end reading = ${START_READING} − ${fmt(reading)} = ${fmt(c.distance)} mm</p>`,
            `<p><strong>Volume of O₂ used</strong> = πr²d = 3.14 × ${CAPILLARY_RADIUS_MM}² × ${fmt(c.distance)} = ${fmt(c.volume)} mm³</p>`,
            `<p><strong>Rate</strong> = ${fmt(c.volume)} ÷ ${t} min = ${fmt(c.perMin, 2)} mm³ min⁻¹, or ${fmt(c.perGramPerMin, 2)} mm³ g⁻¹ min⁻¹ for ${s.massG} g of seeds</p>`,
          ];
        q('[data-working]').innerHTML = lines.join('');
        let note = 'The capillary has an internal radius of 0.5 mm.';
        if (sample === 'boiled') note = 'Boiled seeds are dead: their enzymes are denatured, so they do not respire and the drop does not move. This is a control.';
        else if (sample === 'beads') note = 'Glass beads of the same volume do not respire. A tube like this is used as a control, to show any movement caused by changes in temperature or air pressure.';
        else if (!s.absorber) note = 'Without KOH, the seeds give out about as much CO₂ as the O₂ they take in, so the gas volume hardly changes and the drop does not move. The absorber is what makes the drop measure O₂ uptake.';
        else if (offScale(s, t)) note = 'The drop has reached the end of the scale, so this reading underestimates the rate. Use an earlier time, fewer seeds or reset the drop.';
        else if (s.tempC > 40) note = 'Above about 40 °C the rate falls because enzymes in the seeds begin to denature.';
        q('[data-note]').textContent = note;
      }, 300);
    };
    root.querySelectorAll('[data-param], [data-sample], [data-absorber]').forEach((el) => el.addEventListener('input', update));
    root.querySelectorAll('[data-sample], [data-absorber]').forEach((el) => el.addEventListener('change', update));
  });
</script>

<style>
  .sim-resp { container-type: inline-size; }
  .layout { display: grid; gap: var(--space-4); }
  @container (min-width: 46rem) { .layout { grid-template-columns: minmax(0, 1.7fr) minmax(14rem, 1fr); align-items: start; } }
  .rig { display: grid; gap: var(--space-2); }
  svg { width: 100%; height: auto; font-family: var(--font-sans); }
  .bath { fill: color-mix(in srgb, var(--bio-k) 15%, var(--bio-water) 20%); stroke: var(--border-strong); }
  .glass { fill: color-mix(in srgb, var(--surface) 70%, transparent); stroke: var(--text-muted); stroke-width: 2.5; }
  .glass.thin { fill: none; stroke-width: 7; stroke: color-mix(in srgb, var(--text-muted) 55%, transparent); }
  .bung { fill: var(--text-muted); }
  .koh { fill: color-mix(in srgb, var(--bio-water) 45%, var(--surface)); transition: opacity 0.2s; }
  .gauze { stroke: var(--text); stroke-width: 2; stroke-dasharray: 3 2; }
  .seed { fill: var(--bio-tail); stroke: color-mix(in srgb, var(--bio-tail) 50%, black); stroke-width: 1; }
  .seed.dead { fill: color-mix(in srgb, var(--bio-tail) 35%, var(--text-muted)); }
  .scale { fill: var(--surface); stroke: var(--border-strong); }
  .tick { stroke: var(--text); stroke-width: 1.2; }
  .tick-t { font-size: 12px; fill: var(--text); }
  .start { stroke: var(--text-muted); stroke-width: 1.5; stroke-dasharray: 3 2; }
  .drop { fill: var(--bio-k); }
  .small { font-size: 13px; fill: var(--text-muted); }
  .lbl { fill: var(--text); }
  .temp { font-size: 15px; font-weight: 750; fill: var(--text); }
  .reading { font-size: 15px; font-weight: 700; fill: var(--text); }
  .grid line { stroke: var(--border); stroke-width: 1; }
  .ticks text { font-size: 15px; fill: var(--text-muted); }
  .axis { font-size: 16px; font-weight: 650; fill: var(--text); }
  .line { fill: none; stroke-width: 3.5; stroke-linecap: round; }
  .line.test { stroke: var(--bio-k); }
  .line.control { stroke: var(--text-muted); stroke-dasharray: 10 7; }
  .marker { stroke: var(--text); stroke-width: 1.2; stroke-dasharray: 3 3; }
  .dot { fill: var(--bio-k); stroke: var(--surface); stroke-width: 2; }
  .key { margin: 0; font-size: var(--step--1); display: flex; flex-wrap: wrap; gap: var(--space-2); align-items: center; }
  .k { display: inline-block; width: 2rem; height: 0; border-top: 3.5px solid; }
  .k.test { border-color: var(--bio-k); }
  .k.control { border-color: var(--text-muted); border-top-style: dashed; }
  .controls { display: grid; gap: var(--space-3); font-size: var(--step--1); }
  .choice { border: 0; padding: 0; margin: 0; display: grid; gap: var(--space-1); }
  .choice legend { font-weight: 700; color: var(--text-muted); margin-bottom: var(--space-1); }
  .choice label, .check { display: flex; align-items: center; gap: var(--space-2); min-height: 24px; }
  input[type='radio'], input[type='checkbox'] { width: 1.1rem; height: 1.1rem; }
  .slider { display: grid; gap: var(--space-1); font-weight: 600; }
  output { font-weight: 800; color: var(--accent-strong); }
  .working { margin: var(--space-3) 0 0; padding: var(--space-3); background: var(--surface-2); border-radius: var(--radius-m); font-size: var(--step--1); font-variant-numeric: tabular-nums; }
  .working :global(p) { margin: 0.15rem 0; }
  .note { font-size: var(--step--1); margin: var(--space-2) 0 0; }
  .table { margin-top: var(--space-2); font-size: var(--step--1); }
  .table summary { cursor: pointer; font-weight: 650; color: var(--accent-strong); }
  table { border-collapse: collapse; margin-top: var(--space-2); font-variant-numeric: tabular-nums; }
  th, td { padding: 0.2rem 0.7rem; border-bottom: 1px solid var(--border); text-align: right; }
  .model-note { font-size: 0.8rem; color: var(--text-muted); margin: var(--space-2) 0 0; }
</style>
