---
import { range, sx, sy, type Frame } from './chart';
import { DIRECT_MAX, DIRECT_MIN, LOOPS, LOOP_IDS, STRENGTH_MAX, STRENGTH_MIN, equilibrium, responseCurve, rounds, type LoopId } from './models/d4-3-feedback';

/** Reader-facing names and chains for each loop (the maths is in the model file). */
const INFO: Record<LoopId, { name: string; chain: string; cls: string }> = {
  ice: { name: 'Snow and ice melt', chain: 'Warming melts snow, sea ice and glaciers → darker ocean, rock and vegetation are exposed → less sunlight reflected, more absorbed → more warming.', cls: 'ice' },
  permafrost: { name: 'Permafrost and peat', chain: 'Warming thaws permafrost and warms peat → saprotrophs decompose long-frozen organic matter → CO₂ released, and CH₄ from waterlogged anaerobic soil → more warming.', cls: 'perm' },
  boreal: { name: 'Drought and fire', chain: 'Warmer summers and less snow → drought, lower production and more frequent, intense fires in boreal forest → stored carbon burned as CO₂ → more warming.', cls: 'fire' },
  ocean: { name: 'Warmer oceans', chain: 'Warmer water dissolves less CO₂ and mixes less with the deep ocean → oceans absorb less of our emissions and can release CO₂ → more warming.', cls: 'ocean' },
};

const frame: Frame = {
  w: 560, h: 380, left: 64, right: 16, top: 16, bottom: 56,
  x: { min: DIRECT_MIN, max: DIRECT_MAX, ticks: range(0.5, 3, 0.5), label: 'Warming caused directly by emissions (relative units)' },
  y: { min: 0, max: 7, ticks: range(0, 7, 1), label: 'Total warming (relative units)' },
};
const on0 = [...LOOP_IDS];
const d0 = 1;
const r0 = equilibrium(d0, on0);
const path = (pts: { direct: number; total: number }[]) => pts.map((p, i) => `${i ? 'L' : 'M'}${sx(frame, p.direct).toFixed(1)} ${sy(frame, Math.min(p.total, frame.y.max)).toFixed(1)}`).join('');
const noFb = `M${sx(frame, DIRECT_MIN)} ${sy(frame, DIRECT_MIN)}L${sx(frame, DIRECT_MAX)} ${sy(frame, DIRECT_MAX)}`;
const tips = LOOPS.filter((l) => l.tip).map((l) => ({ id: l.id, at: l.tip!.at }));
const rs0 = rounds(r0);
const tableDirect = range(0.5, 3, 0.5);
---
<div class="fb" data-feedback data-frame={JSON.stringify(frame)}>
  <p class="model-note top"><strong>Qualitative model.</strong> Warming is in relative units (1 = the warming emissions would cause with no feedback). Loop strengths and tipping points are invented to show how positive feedback behaves; they are not climate projections.</p>
  <div class="layout">
    <div class="graphs">
      <svg class="chart" viewBox={`0 0 ${frame.w} ${frame.h}`} role="img" aria-labelledby="fb-t fb-d">
        <title id="fb-t">Total warming against warming caused directly by emissions</title>
        <desc id="fb-d" data-desc>With feedback loops switched on, total warming rises faster than the no-feedback line and jumps upward where a tipping point is passed.</desc>
        <g class="grid">
          {frame.x.ticks.map((t) => <line x1={sx(frame, t)} x2={sx(frame, t)} y1={frame.top} y2={frame.h - frame.bottom} />)}
          {frame.y.ticks.map((t) => <line x1={frame.left} x2={frame.w - frame.right} y1={sy(frame, t)} y2={sy(frame, t)} />)}
        </g>
        <g class="ticks">
          {frame.x.ticks.map((t) => <text x={sx(frame, t)} y={frame.h - frame.bottom + 20} text-anchor="middle">{t}</text>)}
          {frame.y.ticks.map((t) => <text x={frame.left - 8} y={sy(frame, t)} dy="0.35em" text-anchor="end">{t}</text>)}
        </g>
        <text class="axis" x={(frame.left + frame.w - frame.right) / 2} y={frame.h - 10} text-anchor="middle">{frame.x.label}</text>
        <text class="axis" transform={`translate(16 ${(frame.top + frame.h - frame.bottom) / 2}) rotate(-90)`} text-anchor="middle">{frame.y.label}</text>
        {tips.map((t) => (
          <g class="tipline" data-tipline={t.id}>
            <line x1={frame.left} x2={frame.w - frame.right} y1={sy(frame, t.at)} y2={sy(frame, t.at)} />
            <text x={frame.left + 6} y={sy(frame, t.at) - 5}>{t.id === 'permafrost' ? 'permafrost tipping point' : 'boreal forest tipping point'}</text>
          </g>
        ))}
        <path class="line nofb" d={noFb} />
        <path class="line withfb" d={path(responseCurve(on0))} data-curve />
        <circle class="dot" r="7" cx={sx(frame, d0)} cy={sy(frame, r0.total)} data-dot />
      </svg>
      <ul class="legend" role="list">
        <li><span class="k nofb"></span> No feedback</li>
        <li><span class="k withfb"></span> With the loops switched on</li>
        <li><span class="k tip"></span> Tipping point</li>
      </ul>
      <div class="bar-wrap">
        <p class="bar-title">Share of the total warming from each source</p>
        <div class="bar" data-bar>
          <span class="seg direct" data-seg="direct" style={`width:${(r0.direct / r0.total) * 100}%`}></span>
          {LOOP_IDS.map((id) => <span class={`seg ${INFO[id].cls}`} data-seg={id} style={`width:${(r0.contributions[id] / r0.total) * 100}%`}></span>)}
        </div>
        <ul class="bar-key" role="list">
          <li><span class="sw direct"></span> Direct <output data-c="direct">{r0.direct.toFixed(2)}</output></li>
          {LOOP_IDS.map((id) => <li><span class={`sw ${INFO[id].cls}`}></span> {INFO[id].name} <output data-c={id}>+{r0.contributions[id].toFixed(2)}</output></li>)}
        </ul>
        <p class="bar-title">Rounds of feedback (each round warms by a fraction of the one before)</p>
        <div class="rounds" data-rounds aria-hidden="true">
          {rs0.map((v, k) => <span class="rd" style={`height:${(v / r0.direct) * 100}%`}><b>{k === 0 ? 'direct' : `round ${k}`}</b></span>)}
        </div>
      </div>
    </div>
    <div class="side">
      <fieldset class="loops">
        <legend>Feedback loops</legend>
        {LOOP_IDS.map((id) => (
          <label class={`loop ${INFO[id].cls}`}>
            <input type="checkbox" data-loop={id} checked />
            <span><strong>{INFO[id].name}</strong>{LOOPS.find((l) => l.id === id)!.tip && <em class="tag"> has a tipping point</em>}<br /><span class="chain">{INFO[id].chain}</span></span>
          </label>
        ))}
      </fieldset>
      <label class="slider">Warming caused directly by emissions: <output data-out="direct">{d0.toFixed(1)}</output>
        <input type="range" min={DIRECT_MIN} max={DIRECT_MAX} step="0.1" value={d0} data-param="direct" />
      </label>
      <label class="slider">Strength of every loop: <output data-out="strength">×1.0</output>
        <input type="range" min={STRENGTH_MIN} max={STRENGTH_MAX} step="0.1" value="1" data-param="strength" />
      </label>
      <div class="presets" role="group" aria-label="Presets">
        <button type="button" data-preset="none">No feedback</button>
        <button type="button" data-preset="all">All loops, low emissions</button>
        <button type="button" data-preset="tip">Push past tipping points</button>
      </div>
    </div>
  </div>
  <div class="stats">
    <div><span>Total warming</span><output data-stat="total">{r0.total.toFixed(2)}</output></div>
    <div><span>Amplification</span><output data-stat="amp">×{r0.amplification.toFixed(2)}</output></div>
    <div><span>Tipping points passed</span><output data-stat="tipped">{r0.tipped.length}</output></div>
  </div>
  <p class="readout" aria-live="polite" data-readout>
    With all four loops on, direct warming of {d0.toFixed(1)} unit becomes {r0.total.toFixed(2)} units: feedback amplifies it {r0.amplification.toFixed(2)} times. No tipping point has been passed.
  </p>
  <details class="table">
    <summary>Show data table</summary>
    <table data-table>
      <caption>Total warming for the loops and strength selected (relative units)</caption>
      <thead><tr><th scope="col">Direct warming</th><th scope="col">Total warming</th><th scope="col">Amplification</th></tr></thead>
      <tbody>{tableDirect.map((d) => { const r = equilibrium(d, on0); return <tr><th scope="row">{d.toFixed(1)}</th><td>{r.total.toFixed(2)}</td><td>×{r.amplification.toFixed(2)}</td></tr>; })}</tbody>
    </table>
  </details>
</div>

<script>
  import { sx, sy, type Frame } from './chart';
  import { LOOP_IDS, equilibrium, responseCurve, rounds, type LoopId } from './models/d4-3-feedback';

  const NAMES: Record<LoopId, string> = { ice: 'snow and ice', permafrost: 'permafrost', boreal: 'boreal forest', ocean: 'ocean' };
  
  document.querySelectorAll<HTMLElement>('[data-feedback]').forEach((root) => {
    const frame = JSON.parse(root.dataset.frame!) as Frame;
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const direct = $<HTMLInputElement>('[data-param="direct"]');
    const strength = $<HTMLInputElement>('[data-param="strength"]');
    const boxes = [...root.querySelectorAll<HTMLInputElement>('[data-loop]')];
    const readout = $<HTMLElement>('[data-readout]');
    let timer = 0;

    const update = () => {
      const d = Number(direct.value), s = Number(strength.value);
      const on = boxes.filter((b) => b.checked).map((b) => b.dataset.loop as LoopId);
      const r = equilibrium(d, on, s);
      $('[data-out="direct"]').textContent = d.toFixed(1);
      $('[data-out="strength"]').textContent = `×${s.toFixed(1)}`;
      const curve = responseCurve(on, s);
      $('[data-curve]').setAttribute('d', curve.map((p, i) => `${i ? 'L' : 'M'}${sx(frame, p.direct).toFixed(1)} ${sy(frame, Math.min(p.total, frame.y.max)).toFixed(1)}`).join(''));
      const dot = $('[data-dot]');
      dot.setAttribute('cx', sx(frame, d).toFixed(1));
      dot.setAttribute('cy', sy(frame, Math.min(r.total, frame.y.max)).toFixed(1));
      root.querySelectorAll<SVGGElement>('[data-tipline]').forEach((g) => { g.style.display = on.includes(g.dataset.tipline as LoopId) ? '' : 'none'; });
      $<HTMLElement>('[data-seg="direct"]').style.width = `${(r.direct / r.total) * 100}%`;
      $('[data-c="direct"]').textContent = r.direct.toFixed(2);
      for (const id of LOOP_IDS) {
        $<HTMLElement>(`[data-seg="${id}"]`).style.width = `${(r.contributions[id] / r.total) * 100}%`;
        $(`[data-c="${id}"]`).textContent = `+${r.contributions[id].toFixed(2)}`;
      }
      $('[data-rounds]').querySelectorAll<HTMLElement>('.rd').forEach((el, k) => { el.style.height = `${(rounds(r)[k]! / r.direct) * 100}%`; });
      $('[data-stat="total"]').textContent = r.total.toFixed(2);
      $('[data-stat="amp"]').textContent = `×${r.amplification.toFixed(2)}`;
      $('[data-stat="tipped"]').textContent = String(r.tipped.length);
      root.classList.toggle('tipped', r.tipped.length > 0);
      const rows = [0.5, 1, 1.5, 2, 2.5, 3].map((x) => { const q = equilibrium(x, on, s); return `<tr><th scope="row">${x.toFixed(1)}</th><td>${q.total.toFixed(2)}</td><td>×${q.amplification.toFixed(2)}</td></tr>`; });
      $('[data-table] tbody').innerHTML = rows.join('');
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        const loops = on.length === 0 ? 'With no feedback loops on' : on.length === 4 ? 'With all four loops on' : `With the ${on.map((id) => NAMES[id]).join(', ')} loop${on.length > 1 ? 's' : ''} on`;
        const tip = r.tipped.length === 0
          ? 'No tipping point has been passed.'
          : `Tipping point passed: ${r.tipped.map((id) => (id === 'boreal' ? 'boreal forest has flipped from carbon sink to carbon source' : 'permafrost thaw has become widespread')).join(', and ')}, so the loop is stronger than before and warming jumps.`;
        readout.textContent = `${loops}, direct warming of ${d.toFixed(1)} unit${d === 1 ? '' : 's'} becomes ${r.total.toFixed(2)} units: feedback amplifies it ${r.amplification.toFixed(2)} times. ${tip}`;
      }, 300);
    };

    direct.addEventListener('input', update);
    strength.addEventListener('input', update);
    boxes.forEach((b) => b.addEventListener('change', update));
    root.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((btn) => btn.addEventListener('click', () => {
      const p = btn.dataset.preset;
      boxes.forEach((b) => { b.checked = p !== 'none'; });
      direct.value = p === 'tip' ? '1.8' : '1';
      strength.value = '1';
      update();
    }));
    update();
  });
</script>

<style>
  .fb { container-type: inline-size; }
  .layout { display: grid; gap: var(--space-4); }
  @container (min-width: 52rem) { .layout { grid-template-columns: minmax(0, 1.4fr) minmax(17rem, 1fr); align-items: start; } }
  .chart { width: 100%; height: auto; font-family: var(--font-sans); display: block; }
  .grid line { stroke: var(--border); stroke-width: 1; }
  .ticks text { font-size: 15px; fill: var(--text-muted); }
  .axis { font-size: 15px; font-weight: 650; fill: var(--text); }
  @container (max-width: 34rem) { .ticks text { font-size: 19px; } .axis { font-size: 16px; } .tipline text { font-size: 17px; } }
  .line { fill: none; stroke-linejoin: round; stroke-linecap: round; }
  .nofb { stroke: var(--text-muted); stroke-width: 2.5; stroke-dasharray: 8 6; }
  .withfb { stroke: var(--bad); stroke-width: 3.5; }
  .dot { fill: var(--bad); stroke: var(--surface); stroke-width: 3; }
  .tipline line { stroke: var(--warn); stroke-width: 1.6; stroke-dasharray: 2 4; }
  .tipline text { font-size: 13px; font-weight: 650; fill: var(--text-muted); }
  .legend, .bar-key { list-style: none; padding: 0; margin: var(--space-2) 0 0; display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-4); font-size: 0.8rem; color: var(--text-muted); }
  .legend li, .bar-key li { margin: 0; display: flex; align-items: center; gap: var(--space-2); }
  .k { display: inline-block; width: 1.8rem; flex: none; }
  .k.nofb { border-top: 2.5px dashed var(--text-muted); }
  .k.withfb { border-top: 3.5px solid var(--bad); }
  .k.tip { border-top: 2px dotted var(--warn); }
  .bar-wrap { margin-top: var(--space-3); }
  .bar-title { font-size: var(--step--1); font-weight: 700; margin: var(--space-3) 0 var(--space-1); }
  .bar { display: flex; height: 2rem; border-radius: var(--radius-s); background: var(--surface-2); border: 1px solid var(--border); overflow: hidden; }
  .seg { display: block; height: 100%; transition: width 0.25s; border-right: 2px solid var(--surface); }
  @media (prefers-reduced-motion: reduce) { .seg, .rd { transition: none; } }
  .seg.direct, .sw.direct { background: var(--text-muted); }
  .seg.ice, .sw.ice { background: var(--bio-water); }
  .seg.perm, .sw.perm { background: var(--bio-tail); }
  .seg.fire, .sw.fire { background: var(--bio-k); }
  .seg.ocean, .sw.ocean { background: var(--bio-protein-2); }
  .sw { display: inline-block; width: 0.9rem; height: 0.9rem; border-radius: 3px; flex: none; }
  .bar-key output { font-weight: 750; color: var(--text); font-variant-numeric: tabular-nums; }
  .rounds { display: flex; align-items: flex-end; gap: var(--space-2); height: 6rem; padding-bottom: 1.3rem; border-bottom: 1px solid var(--border); }
  .rd { position: relative; flex: 1; background: color-mix(in srgb, var(--bad) 55%, var(--surface)); border-radius: 3px 3px 0 0; transition: height 0.25s; min-height: 1px; }
  .rd b { position: absolute; top: 100%; left: 50%; transform: translateX(-50%); font-size: 0.68rem; font-weight: 600; color: var(--text-muted); white-space: nowrap; padding-top: 2px; }
  .side { display: grid; gap: var(--space-3); font-size: var(--step--1); }
  .loops { border: 0; padding: 0; margin: 0; display: grid; gap: var(--space-2); }
  .loops legend { font-weight: 700; color: var(--text-muted); margin-bottom: var(--space-1); }
  .loop { display: grid; grid-template-columns: auto 1fr; gap: var(--space-2); align-items: start; padding: var(--space-2); border: 1px solid var(--border); border-left-width: 5px; border-radius: var(--radius-m); cursor: pointer; }
  .loop input { width: 1.2rem; height: 1.2rem; margin-top: 0.15rem; }
  .loop.ice { border-left-color: var(--bio-water); }
  .loop.perm { border-left-color: var(--bio-tail); }
  .loop.fire { border-left-color: var(--bio-k); }
  .loop.ocean { border-left-color: var(--bio-protein-2); }
  .chain { color: var(--text-muted); font-size: 0.8rem; line-height: 1.4; }
  .tag { font-style: normal; font-size: 0.72rem; font-weight: 700; color: var(--text); background: var(--warn-soft); padding: 0 0.4em; border-radius: 4px; margin-left: 0.3em; }
  .slider { display: grid; gap: var(--space-1); font-weight: 600; }
  output { font-weight: 800; color: var(--accent-strong); }
  .presets { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .presets button { min-height: 32px; padding: 0.3rem 0.7rem; border: 1px solid var(--border-strong); background: var(--surface); color: var(--text); border-radius: var(--radius-m); font: inherit; font-size: 0.8rem; cursor: pointer; }
  .presets button:hover { background: var(--surface-2); }
  .stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-2); margin-top: var(--space-4); }
  .stats div { padding: var(--space-2) var(--space-3); border-radius: var(--radius-m); background: var(--surface-2); display: grid; }
  .stats span { font-size: 0.75rem; color: var(--text-muted); font-weight: 650; }
  .stats output { font-size: var(--step-1); font-variant-numeric: tabular-nums; }
  .tipped .stats div:last-child { background: var(--warn-soft); }
  .readout { margin: var(--space-3) 0 0; padding: var(--space-3); background: var(--surface-2); border-radius: var(--radius-m); font-size: var(--step--1); }
  .table { margin-top: var(--space-2); font-size: var(--step--1); }
  .table summary { cursor: pointer; font-weight: 650; color: var(--accent-strong); }
  table { border-collapse: collapse; margin-top: var(--space-2); font-variant-numeric: tabular-nums; }
  caption { text-align: left; font-weight: 650; padding-bottom: var(--space-1); }
  th, td { padding: 0.2rem 0.7rem; border-bottom: 1px solid var(--border); text-align: right; }
  .model-note { font-size: 0.8rem; color: var(--text-muted); margin: 0 0 var(--space-3); }
</style>
