---
/**
 * A3.2.5 molecular clock calculator. A fossil-dated pair calibrates the rate; the number of
 * differences between a second pair (same gene, same length) then gives an estimated divergence time.
 * Maths: ./models/a3-2-molecular-clock.ts.
 */
import { range, sx, sy, type Frame } from './chart';
import { divergenceTime, expectedDifferences, fmtMyr, perLineageRate, rateFromCalibration, timeRange } from './models/a3-2-molecular-clock';

const LENGTH = 1000;
const frame: Frame = {
  w: 640, h: 380, left: 62, right: 18, top: 16, bottom: 54,
  x: { min: 0, max: 100, ticks: range(0, 100, 20), label: 'Time since divergence (million years)' },
  y: { min: 0, max: 200, ticks: range(0, 200, 40), label: 'Base differences' },
};
const d = { calT: 20, calD: 60, diffs: 21, vary: 20 };
const rate = rateFromCalibration(d.calD, d.calT);
const t = divergenceTime(d.diffs, rate);
const [lo, hi] = timeRange(d.diffs, rate, d.vary / 100);
const sci = (v: number) => { const e = Math.floor(Math.log10(v)); return `${(v / 10 ** e).toFixed(1)} × 10${String(e).replace('-', '⁻').replace(/\d/g, (c) => '⁰¹²³⁴⁵⁶⁷⁸⁹'[Number(c)]!)}`; };
/** Straight line through the origin; drawn past the plot edge and clipped, so it never flattens. */
const ray = (r: number) => `M${sx(frame, 0)} ${sy(frame, 0)}L${sx(frame, frame.x.max)} ${sy(frame, frame.x.max * r).toFixed(1)}`;
const table = range(0, 100, 10).map((x) => ({ x, y: expectedDifferences(x, rate) }));
---
<div class="mclock" data-mclock data-frame={JSON.stringify(frame)} data-length={LENGTH}>
  <div class="layout">
    <svg class="chart" viewBox={`0 0 ${frame.w} ${frame.h}`} role="img" aria-labelledby="mc-t mc-d" data-chart>
      <title id="mc-t">Molecular clock: base differences against time since divergence</title>
      <desc id="mc-d">A straight line through the origin and the fossil-dated calibration point. Reading across from the number of differences between the species pair to the line, then down, gives the estimated time since they diverged. Dashed lines show the range if the true rate is faster or slower.</desc>
      <defs><clipPath id="mc-clip"><rect x={frame.left} y={frame.top} width={frame.w - frame.left - frame.right} height={frame.h - frame.top - frame.bottom} /></clipPath></defs>
      <g class="grid">
        {frame.x.ticks.map((v) => <line x1={sx(frame, v)} x2={sx(frame, v)} y1={frame.top} y2={frame.h - frame.bottom} />)}
        {frame.y.ticks.map((v) => <line x1={frame.left} x2={frame.w - frame.right} y1={sy(frame, v)} y2={sy(frame, v)} />)}
      </g>
      <g class="ticks">
        {frame.x.ticks.map((v) => <text x={sx(frame, v)} y={frame.h - frame.bottom + 20} text-anchor="middle">{v}</text>)}
        {frame.y.ticks.map((v) => <text x={frame.left - 8} y={sy(frame, v)} dy="0.35em" text-anchor="end">{v}</text>)}
      </g>
      <text class="axis" x={(frame.left + frame.w - frame.right) / 2} y={frame.h - 10} text-anchor="middle">{frame.x.label} →</text>
      <text class="axis" transform={`translate(16 ${(frame.top + frame.h - frame.bottom) / 2}) rotate(-90)`} text-anchor="middle">{frame.y.label} →</text>
      <g clip-path="url(#mc-clip)">
        <path class="band" d={ray(rate * (1 + d.vary / 100))} data-line="fast" />
        <path class="band" d={ray(rate * (1 - d.vary / 100))} data-line="slow" />
        <path class="clock" d={ray(rate)} data-line="clock" />
        <path class="read" data-read d={`M${frame.left} ${sy(frame, d.diffs)}H${sx(frame, t)}V${frame.h - frame.bottom}`} />
        <rect class="range" data-range x={sx(frame, lo)} width={sx(frame, hi) - sx(frame, lo)} y={frame.h - frame.bottom - 8} height="8" />
      </g>
      <circle class="cal" r="7" cx={sx(frame, d.calT)} cy={sy(frame, d.calD)} data-cal />
      <circle class="pt" r="6" cx={sx(frame, t)} cy={sy(frame, d.diffs)} data-pt />
    </svg>
    <div class="controls">
      <fieldset>
        <legend>1. Calibrate with fossils</legend>
        <label class="slider">Fossil date of a known split: <output data-out="calT">{d.calT} million years</output>
          <input type="range" min="5" max="60" step="1" value={d.calT} data-param="calT" />
        </label>
        <label class="slider">Differences between that pair: <output data-out="calD">{d.calD}</output>
          <input type="range" min="10" max="150" step="1" value={d.calD} data-param="calD" />
        </label>
        <p class="rate">Rate: <strong data-rate>{rate.toFixed(1)} differences per million years</strong></p>
      </fieldset>
      <fieldset>
        <legend>2. Date a new split</legend>
        <label class="slider">Differences between the two species: <output data-out="diffs">{d.diffs}</output>
          <input type="range" min="0" max="150" step="1" value={d.diffs} data-param="diffs" />
        </label>
        <label class="slider">Possible error in the rate: <output data-out="vary">±{d.vary}%</output>
          <input type="range" min="0" max="50" step="5" value={d.vary} data-param="vary" />
        </label>
      </fieldset>
    </div>
  </div>
  <p class="readout" aria-live="polite" data-readout>
    Estimated time since divergence: <strong>{fmtMyr(t)} million years</strong> (range {fmtMyr(lo)}–{fmtMyr(hi)} million years if the rate is ±{d.vary}% out). This rate is about {sci(perLineageRate(rate, LENGTH))} changes per base per year in each lineage.
  </p>
  <div class="key" aria-hidden="true">
    <span><span class="sw clock"></span> Calibrated clock</span>
    <span><span class="sw band"></span> Faster / slower rate</span>
    <span><span class="dot cal"></span> Fossil-dated pair</span>
    <span><span class="dot pt"></span> New pair</span>
  </div>
  <details class="table">
    <summary>Show data table</summary>
    <table>
      <thead><tr><th scope="col">Time (million years)</th><th scope="col">Expected differences</th></tr></thead>
      <tbody data-tbody>{table.map((r) => <tr><th scope="row">{r.x}</th><td>{r.y.toFixed(0)}</td></tr>)}</tbody>
    </table>
  </details>
  <div class="limits">
    <p><strong>Assumptions and limitations</strong></p>
    <ul>
      <li>Assumes differences build up at a <strong>constant rate</strong> in both lineages since the split.</li>
      <li>The rate must be <strong>calibrated</strong> using a split dated independently, usually by fossils (or a dated geological event), and the fossil date has its own uncertainty.</li>
      <li>Each gene has its own rate: compare the <strong>same gene</strong>, of the same length, in every pair.</li>
      <li>Rates vary with <strong>generation time</strong>, <strong>population size</strong>, the <strong>intensity of selection</strong> on the gene and other factors, so the answer is only an <strong>estimate</strong>.</li>
    </ul>
  </div>
  <p class="model-note">Simplified model: differences counted in a 1000-base section of one gene. Real analyses also correct for a base changing more than once at the same position.</p>
</div>

<script>
  import { range, sx, sy, type Frame } from './chart';
  import { divergenceTime, expectedDifferences, fmtMyr, perLineageRate, rateFromCalibration, timeRange } from './models/a3-2-molecular-clock';

  const sup = (s: string) => s.replace('-', '⁻').replace(/\d/g, (c) => '⁰¹²³⁴⁵⁶⁷⁸⁹'[Number(c)]!);
  const sci = (v: number) => { const e = Math.floor(Math.log10(v)); return `${(v / 10 ** e).toFixed(1)} × 10${sup(String(e))}`; };

  document.querySelectorAll<HTMLElement>('[data-mclock]').forEach((root) => {
    const frame = JSON.parse(root.dataset.frame!) as Frame;
    const length = Number(root.dataset.length);
    const get = (k: string) => Number(root.querySelector<HTMLInputElement>(`[data-param="${k}"]`)!.value);
    const out = (k: string, v: string) => (root.querySelector(`[data-out="${k}"]`)!.textContent = v);
    const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const ray = (r: number) => `M${sx(frame, 0)} ${sy(frame, 0)}L${sx(frame, frame.x.max)} ${sy(frame, frame.x.max * r).toFixed(1)}`;
    const clampX = (v: number) => sx(frame, Math.min(frame.x.max, Math.max(0, v)));
    let timer = 0;

    const update = () => {
      const calT = get('calT'), calD = get('calD'), diffs = get('diffs'), vary = get('vary') / 100;
      const rate = rateFromCalibration(calD, calT);
      const t = divergenceTime(diffs, rate);
      const [lo, hi] = timeRange(diffs, rate, vary);
      out('calT', `${calT} million years`); out('calD', String(calD)); out('diffs', String(diffs)); out('vary', `±${Math.round(vary * 100)}%`);
      q('[data-rate]').textContent = `${rate.toFixed(1)} differences per million years`;
      q('[data-line="clock"]').setAttribute('d', ray(rate));
      q('[data-line="fast"]').setAttribute('d', ray(rate * (1 + vary)));
      q('[data-line="slow"]').setAttribute('d', ray(rate * (1 - vary)));
      q('[data-read]').setAttribute('d', `M${frame.left} ${sy(frame, diffs).toFixed(1)}H${clampX(t).toFixed(1)}V${frame.h - frame.bottom}`);
      const r = q<SVGRectElement>('[data-range]');
      r.setAttribute('x', clampX(lo).toFixed(1));
      r.setAttribute('width', Math.max(0, clampX(hi) - clampX(lo)).toFixed(1));
      const cal = q('[data-cal]'); cal.setAttribute('cx', sx(frame, calT).toFixed(1)); cal.setAttribute('cy', sy(frame, Math.min(frame.y.max, calD)).toFixed(1));
      const pt = q<SVGCircleElement>('[data-pt]');
      pt.setAttribute('cx', clampX(t).toFixed(1)); pt.setAttribute('cy', sy(frame, diffs).toFixed(1));
      pt.style.display = t > frame.x.max ? 'none' : '';
      q('[data-tbody]').innerHTML = range(0, 100, 10).map((x) => `<tr><th scope="row">${x}</th><td>${expectedDifferences(x, rate).toFixed(0)}</td></tr>`).join('');
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        q('[data-readout]').innerHTML =
          `Estimated time since divergence: <strong>${fmtMyr(t)} million years</strong>` +
          (vary > 0 ? ` (range ${fmtMyr(lo)}–${fmtMyr(hi)} million years if the rate is ±${Math.round(vary * 100)}% out)` : ' (no allowance for rate error)') +
          `. This rate is about ${sci(perLineageRate(rate, length))} changes per base per year in each lineage.` +
          (t > frame.x.max ? ' The point is beyond the right-hand edge of the graph.' : '') +
          (diffs === 0 ? ' With no differences the clock cannot separate the species: the split is too recent to detect in this gene.' : '');
      }, 300);
    };
    root.querySelectorAll('[data-param]').forEach((el) => el.addEventListener('input', update));
  });
</script>

<style>
  .mclock { container-type: inline-size; }
  .layout { display: grid; gap: var(--space-4); }
  @container (min-width: 46rem) { .layout { grid-template-columns: minmax(0, 1.5fr) minmax(15rem, 1fr); align-items: start; } }
  .chart { width: 100%; height: auto; font-family: var(--font-sans); }
  .grid line { stroke: var(--border); stroke-width: 1; }
  .ticks text { font-size: 17px; fill: var(--text-muted); }
  .axis { font-size: 17px; font-weight: 650; fill: var(--text); }
  .clock { fill: none; stroke: var(--accent); stroke-width: 3.5; stroke-linecap: round; }
  .band { fill: none; stroke: var(--bio-protein-2); stroke-width: 2; stroke-dasharray: 9 6; }
  .read { fill: none; stroke: var(--text); stroke-width: 1.5; stroke-dasharray: 3 4; }
  .range { fill: color-mix(in srgb, var(--bio-protein-2) 45%, transparent); }
  .cal { fill: var(--bio-head); stroke: var(--text); stroke-width: 1.5; }
  .pt { fill: var(--surface); stroke: var(--text); stroke-width: 2.5; }
  .controls { display: grid; gap: var(--space-3); font-size: var(--step--1); }
  fieldset { border: 1px solid var(--border); border-radius: var(--radius-m); padding: var(--space-2) var(--space-3) var(--space-3); margin: 0; display: grid; gap: var(--space-2); }
  legend { font-weight: 750; padding: 0 var(--space-1); }
  .slider { display: grid; gap: var(--space-1); font-weight: 600; }
  output { font-weight: 800; color: var(--accent-strong); }
  .rate { margin: 0; }
  .readout { margin: var(--space-3) 0 0; padding: var(--space-3); background: var(--surface-2); border-radius: var(--radius-m); font-size: var(--step--1); }
  .key { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-4); font-size: 0.8rem; color: var(--text-muted); margin-top: var(--space-2); }
  .key > span { display: inline-flex; align-items: center; gap: var(--space-1); }
  .sw { display: inline-block; width: 1.8rem; height: 0; border-top: 3px solid; }
  .sw.clock { border-color: var(--accent); }
  .sw.band { border-color: var(--bio-protein-2); border-top-style: dashed; }
  .dot { display: inline-block; width: 0.8rem; height: 0.8rem; border-radius: 50%; border: 1.5px solid var(--text); }
  .dot.cal { background: var(--bio-head); }
  .dot.pt { background: var(--surface); }
  .table { margin-top: var(--space-2); font-size: var(--step--1); }
  .table summary { cursor: pointer; font-weight: 650; color: var(--accent-strong); }
  table { border-collapse: collapse; margin-top: var(--space-2); font-variant-numeric: tabular-nums; }
  th, td { padding: 0.2rem 0.7rem; border-bottom: 1px solid var(--border); text-align: right; }
  .limits { margin-top: var(--space-3); padding: var(--space-3); background: var(--warn-soft); border-radius: var(--radius-m); font-size: var(--step--1); }
  .limits p { margin: 0 0 var(--space-1); }
  .limits ul { margin: 0; padding-left: 1.2rem; }
  .model-note { font-size: 0.8rem; color: var(--text-muted); margin: var(--space-2) 0 0; }
</style>
