---
import { range, sx, sy, type Frame } from './chart';
import { biomes, classify, labelAt, places, P_MAX, regions, T_MAX, T_MIN, type BiomeId } from './models/b4-1-biomes';

const frame: Frame = {
  w: 640, h: 440, left: 74, right: 16, top: 14, bottom: 54,
  x: { min: T_MIN, max: T_MAX, ticks: range(-15, 30, 5), label: 'Mean annual temperature / °C' },
  y: { min: 0, max: P_MAX, ticks: range(0, 450, 50), label: 'Annual precipitation / cm' },
};
const path = (pts: [number, number][]) => pts.map(([t, p], i) => `${i ? 'L' : 'M'}${sx(frame, t).toFixed(1)} ${sy(frame, p).toFixed(1)}`).join('') + 'Z';
const order: BiomeId[] = ['tundra', 'taiga', 'temperate-forest', 'grassland', 'savanna', 'tropical-forest', 'hot-desert', 'cold-desert'];
const start = places[0]!;
const first = biomes[classify(start.t, start.p) as BiomeId];
const fmtT = (t: number) => `${t > 0 ? '' : t < 0 ? '−' : ''}${Math.abs(t)} °C`;
---
<div class="biomes" data-biomes data-frame={JSON.stringify(frame)}>
  <div class="layout">
    <div>
      <svg class="chart" viewBox={`0 0 ${frame.w} ${frame.h}`} role="img" aria-labelledby="bm-t bm-d" data-chart>
        <title id="bm-t">Biome graph: annual precipitation against mean annual temperature</title>
        <desc id="bm-d">Approximate regions for each biome. Tundra is on the left, where it is coldest. Taiga lies between about −5 and 5 °C. Between 5 and 20 °C, temperate grassland occupies drier climates and temperate forest wetter ones. Above 20 °C, hot desert is at the bottom, savanna above it and tropical forest where rainfall is highest. A thin band of cold desert lies along the bottom between −5 and 20 °C. The desert and forest boundaries slope upwards to the right, because warmer climates need more rain. Climates above the shaded envelope are rare on Earth.</desc>
        <g class="grid">
          {frame.x.ticks.map((t) => <line x1={sx(frame, t)} x2={sx(frame, t)} y1={frame.top} y2={frame.h - frame.bottom} />)}
          {frame.y.ticks.map((t) => <line x1={frame.left} x2={frame.w - frame.right} y1={sy(frame, t)} y2={sy(frame, t)} />)}
        </g>
        {order.map((id) => <path class:list={['reg', `reg-${id}`, { on: id === first.id }]} d={path(regions[id])} data-region={id} />)}
        {order.map((id) => {
          const l = labelAt[id];
          return (
            <text class:list={['rlab', { 'wide-only': !l.narrow }]} x={sx(frame, l.t)} y={sy(frame, l.p)} text-anchor="middle">
              {l.lines.map((line, i) => <tspan x={sx(frame, l.t)} dy={i === 0 ? `${0.35 - (l.lines.length - 1) * 0.55}em` : '1.1em'}>{line}</tspan>)}
            </text>
          );
        })}
        <text class="rare" x={sx(frame, -9)} y={sy(frame, 330)}>climates this cold and wet</text>
        <text class="rare" x={sx(frame, -9)} y={sy(frame, 330) + 18}>are rare on Earth</text>
        <g class="ticks">
          {frame.x.ticks.map((t) => <text x={sx(frame, t)} y={frame.h - frame.bottom + 19} text-anchor="middle">{t < 0 ? `−${-t}` : t}</text>)}
          {frame.y.ticks.map((t) => <text x={frame.left - 8} y={sy(frame, t)} dy="0.35em" text-anchor="end">{t}</text>)}
        </g>
        <text class="axis" x={(frame.left + frame.w - frame.right) / 2} y={frame.h - 10} text-anchor="middle">{frame.x.label} →</text>
        <text class="axis" transform={`translate(16 ${(frame.top + frame.h - frame.bottom) / 2}) rotate(-90)`} text-anchor="middle">{frame.y.label} →</text>
        <g class="pt" data-point>
          <line class="cross" data-cx x1={sx(frame, start.t)} x2={sx(frame, start.t)} y1={sy(frame, start.p)} y2={frame.h - frame.bottom} />
          <line class="cross" data-cy x1={frame.left} x2={sx(frame, start.t)} y1={sy(frame, start.p)} y2={sy(frame, start.p)} />
          <circle class="dot" data-dot cx={sx(frame, start.t)} cy={sy(frame, start.p)} r="10" />
        </g>
      </svg>
      <p class="hint">Drag or tap the graph, or use the sliders.</p>
      <ul class="key" aria-label="Colour key">
        {order.map((id) => <li><span class:list={['sw', `reg-${id}`]}></span>{biomes[id].name}{!biomes[id].required && <span class="muted"> (extra)</span>}</li>)}
      </ul>
    </div>

    <div class="side">
      <label class="slider">Mean annual temperature: <output data-out="t">{fmtT(start.t)}</output>
        <input type="range" min={T_MIN} max={T_MAX} step="0.5" value={start.t} data-param="t" />
      </label>
      <label class="slider">Annual precipitation: <output data-out="p">{start.p} cm</output>
        <input type="range" min="0" max={P_MAX} step="5" value={start.p} data-param="p" />
      </label>
      <div class="places" role="group" aria-label="Example places">
        <span>Try a place:</span>
        {places.map((pl) => <button type="button" class="btn chip" data-place={pl.id}>{pl.label}</button>)}
      </div>
      <p class="readout" aria-live="polite" data-readout>{fmtT(start.t)} and {start.p} cm a year: most likely {first.name.toLowerCase()}.</p>
    </div>
  </div>

  <div class="card" data-card>
    <p class="c-name"><strong data-c="name">{first.name}</strong> <span class="badge-x" data-c="extra" hidden>not one of the six required biomes</span></p>
    <dl>
      <div><dt>Climate</dt><dd data-c="climate">{first.climate}</dd></div>
      <div><dt>Typical community</dt><dd data-c="community">{first.community}</dd></div>
      <div><dt>Adaptations</dt><dd data-c="adaptations">{first.adaptations}</dd></div>
      <div><dt>Where</dt><dd data-c="where">{first.where}</dd></div>
      <div><dt>Convergent evolution</dt><dd data-c="convergence">{first.convergence}</dd></div>
    </dl>
  </div>

  <details class="table">
    <summary>Show data table</summary>
    <table>
      <thead><tr><th scope="col">Place</th><th scope="col">Mean annual temperature</th><th scope="col">Annual precipitation</th><th scope="col">Biome on the graph</th></tr></thead>
      <tbody>{places.map((pl) => <tr><th scope="row">{pl.label}</th><td>{fmtT(pl.t)}</td><td>{pl.p} cm</td><td>{biomes[classify(pl.t, pl.p) as BiomeId].name}</td></tr>)}</tbody>
    </table>
  </details>
  <p class="model-note">Approximate boundaries, simplified from Whittaker-style biome graphs; climate figures for places are rounded long-term averages. Real biome boundaries are gradual and also depend on the seasonal pattern of rainfall, soils, fire, grazing and human activity.</p>
</div>

<script>
  import { sx, sy, type Frame } from './chart';
  import { biomes, classify, P_MAX, places, T_MAX, T_MIN } from './models/b4-1-biomes';

  document.querySelectorAll<HTMLElement>('[data-biomes]').forEach((root) => {
    const frame = JSON.parse(root.dataset.frame!) as Frame;
    const svg = root.querySelector<SVGSVGElement>('[data-chart]')!;
    const tIn = root.querySelector<HTMLInputElement>('[data-param="t"]')!;
    const pIn = root.querySelector<HTMLInputElement>('[data-param="p"]')!;
    const dot = root.querySelector<SVGCircleElement>('[data-dot]')!;
    const cx = root.querySelector<SVGLineElement>('[data-cx]')!;
    const cy = root.querySelector<SVGLineElement>('[data-cy]')!;
    const readout = root.querySelector<HTMLElement>('[data-readout]')!;
    const c = (k: string) => root.querySelector<HTMLElement>(`[data-c="${k}"]`)!;
    const fmtT = (t: number) => `${t < 0 ? '−' : ''}${Math.abs(t)} °C`;
    let timer = 0;

    const update = () => {
      const t = Number(tIn.value), p = Number(pIn.value);
      root.querySelector('[data-out="t"]')!.textContent = fmtT(t);
      root.querySelector('[data-out="p"]')!.textContent = `${p} cm`;
      const x = sx(frame, t).toFixed(1), y = sy(frame, p).toFixed(1);
      dot.setAttribute('cx', x); dot.setAttribute('cy', y);
      cx.setAttribute('x1', x); cx.setAttribute('x2', x); cx.setAttribute('y1', y);
      cy.setAttribute('x2', x); cy.setAttribute('y1', y); cy.setAttribute('y2', y);
      const r = classify(t, p);
      root.querySelectorAll<SVGPathElement>('[data-region]').forEach((el) => el.classList.toggle('on', el.dataset.region === r));
      if (r === 'rare') {
        c('name').textContent = 'No biome mapped';
        c('extra').hidden = true;
        c('climate').textContent = 'Very few places on Earth combine this temperature with this much rain, so the graph shows no biome here. Real climates fall inside the coloured envelope.';
        for (const k of ['community', 'adaptations', 'where', 'convergence']) c(k).textContent = '—';
      } else {
        const b = biomes[r];
        c('name').textContent = b.name;
        c('extra').hidden = b.required;
        for (const k of ['climate', 'community', 'adaptations', 'where', 'convergence'] as const) c(k).textContent = b[k];
      }
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        readout.textContent = r === 'rare'
          ? `${fmtT(t)} and ${p} cm a year: a combination that is rare on Earth, so no biome is mapped.`
          : `${fmtT(t)} and ${p} cm a year: most likely ${biomes[r].name.toLowerCase()}.`;
      }, 300);
    };

    const fromEvent = (e: PointerEvent) => {
      const m = svg.getScreenCTM();
      if (!m) return;
      const pt = new DOMPoint(e.clientX, e.clientY).matrixTransform(m.inverse());
      const t = frame.x.min + ((pt.x - frame.left) / (frame.w - frame.left - frame.right)) * (frame.x.max - frame.x.min);
      const p = ((frame.h - frame.bottom - pt.y) / (frame.h - frame.top - frame.bottom)) * frame.y.max;
      tIn.value = String(Math.min(T_MAX, Math.max(T_MIN, Math.round(t * 2) / 2)));
      pIn.value = String(Math.min(P_MAX, Math.max(0, Math.round(p / 5) * 5)));
      update();
    };
    let dragging = false;
    svg.addEventListener('pointerdown', (e) => { dragging = true; svg.setPointerCapture(e.pointerId); fromEvent(e); });
    svg.addEventListener('pointermove', (e) => { if (dragging) fromEvent(e); });
    const stop = () => { dragging = false; };
    svg.addEventListener('pointerup', stop);
    svg.addEventListener('pointercancel', stop);

    [tIn, pIn].forEach((el) => el.addEventListener('input', update));
    root.querySelectorAll<HTMLButtonElement>('[data-place]').forEach((b) => b.addEventListener('click', () => {
      const pl = places.find((x) => x.id === b.dataset.place)!;
      tIn.value = String(pl.t); pIn.value = String(pl.p);
      update();
    }));
  });
</script>

<style>
  .biomes { container-type: inline-size; }
  .layout { display: grid; gap: var(--space-4); }
  @container (min-width: 46rem) { .layout { grid-template-columns: minmax(0, 1.6fr) minmax(15rem, 1fr); align-items: start; } }
  .chart { width: 100%; height: auto; font-family: var(--font-sans); touch-action: pan-y pinch-zoom; cursor: crosshair; user-select: none; }
  .grid line { stroke: var(--border); stroke-width: 1; }
  .reg { stroke: var(--surface); stroke-width: 1.5; }
  .reg.on { stroke: var(--text); stroke-width: 3; }
  .reg-tundra { fill: color-mix(in srgb, var(--bio-water) 24%, var(--surface)); background: color-mix(in srgb, var(--bio-water) 24%, var(--surface)); }
  .reg-taiga { fill: color-mix(in srgb, var(--accent) 38%, var(--surface)); background: color-mix(in srgb, var(--accent) 38%, var(--surface)); }
  .reg-temperate-forest { fill: color-mix(in srgb, var(--bio-carb) 38%, var(--surface)); background: color-mix(in srgb, var(--bio-carb) 38%, var(--surface)); }
  .reg-grassland { fill: color-mix(in srgb, var(--bio-tail) 48%, var(--surface)); background: color-mix(in srgb, var(--bio-tail) 48%, var(--surface)); }
  .reg-savanna { fill: color-mix(in srgb, var(--bio-glucose) 34%, var(--surface)); background: color-mix(in srgb, var(--bio-glucose) 34%, var(--surface)); }
  .reg-tropical-forest { fill: color-mix(in srgb, var(--good) 46%, var(--surface)); background: color-mix(in srgb, var(--good) 46%, var(--surface)); }
  .reg-hot-desert { fill: color-mix(in srgb, var(--bio-head) 42%, var(--surface)); background: color-mix(in srgb, var(--bio-head) 42%, var(--surface)); }
  .reg-cold-desert { fill: color-mix(in srgb, var(--bio-protein-2) 22%, var(--surface)); background: color-mix(in srgb, var(--bio-protein-2) 22%, var(--surface)); }
  .rlab { font-size: 14px; font-weight: 700; fill: var(--text); pointer-events: none; }
  .rare { font-size: 13px; fill: var(--text-muted); font-style: italic; }
  .ticks text { font-size: 14px; fill: var(--text-muted); }
  .axis { font-size: 15px; font-weight: 650; fill: var(--text); }
  .cross { stroke: var(--text); stroke-width: 1.4; stroke-dasharray: 4 4; pointer-events: none; }
  .dot { fill: var(--text); stroke: var(--surface); stroke-width: 3; }
  @container (max-width: 34rem) {
    .rlab { font-size: 22px; }
    .wide-only, .rare { display: none; }
    .ticks text { font-size: 19px; }
    .axis { font-size: 21px; }
    .dot { r: 14px; }
  }
  .hint { margin: var(--space-1) 0 0; font-size: 0.8rem; color: var(--text-muted); }
  .key { list-style: none; margin: var(--space-2) 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-3); font-size: 0.8rem; }
  .key li { display: flex; align-items: center; gap: 0.35rem; }
  .sw { display: inline-block; width: 0.9rem; height: 0.9rem; border-radius: 3px; border: 1px solid var(--border-strong); }
  .muted { color: var(--text-muted); }
  .side { display: grid; gap: var(--space-3); font-size: var(--step--1); }
  .slider { display: grid; gap: var(--space-1); font-weight: 600; }
  output { font-weight: 800; color: var(--accent-strong); }
  .places { display: flex; flex-wrap: wrap; gap: var(--space-2); align-items: center; }
  .chip { min-height: 2.1rem; padding: 0.3rem 0.65rem; }
  .readout { margin: 0; padding: var(--space-3); background: var(--surface-2); border-radius: var(--radius-m); font-weight: 650; }
  .card { margin-top: var(--space-4); padding: var(--space-3) var(--space-4); border-radius: var(--radius-m); background: var(--surface-2); border-left: 4px solid var(--accent); font-size: var(--step--1); }
  .c-name { margin: 0 0 var(--space-2); font-size: var(--step-0); }
  .badge-x { font-size: 0.75rem; color: var(--text-muted); font-weight: 600; margin-left: var(--space-2); }
  dl { display: grid; gap: var(--space-2); margin: 0; }
  @container (min-width: 46rem) { dl { grid-template-columns: 1fr 1fr; } dl > div:first-child { grid-column: 1 / -1; } }
  dt { font-weight: 700; color: var(--text-muted); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; }
  dd { margin: 0; }
  .table { margin-top: var(--space-3); font-size: var(--step--1); }
  .table summary { cursor: pointer; font-weight: 650; color: var(--accent-strong); }
  table { border-collapse: collapse; margin-top: var(--space-2); font-variant-numeric: tabular-nums; }
  th, td { padding: 0.2rem 0.7rem; border-bottom: 1px solid var(--border); text-align: left; }
  .model-note { font-size: 0.8rem; color: var(--text-muted); margin: var(--space-2) 0 0; }
</style>
