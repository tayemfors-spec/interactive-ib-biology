---
import { linePath, range, sx, sy, type Frame } from './chart';
import { GENERATIONS, STRAINS, simulate, type ResistParams } from './models/c3-2-resistance';

const d: ResistParams = { treatment: 'AthenB', log10Rate: -7, seed: 5 };
const r = simulate(d);
const frame: Frame = {
  w: 640, h: 360, left: 64, right: 18, top: 44, bottom: 52,
  x: { min: 0, max: GENERATIONS, ticks: range(0, GENERATIONS, 20), label: 'Generations of bacteria' },
  y: { min: 0, max: 8.5, ticks: range(0, 8, 2), label: 'Number of bacteria (log scale)' },
};
const lg = (a: number[]) => (g: number) => { const n = a[Math.round(g)]!; return n >= 1 ? Math.log10(n) : NaN; };
const sup = ['⁰', '¹', '²', '³', '⁴', '⁵', '⁶', '⁷', '⁸'];
const treatments = [
  { id: 'none', label: 'No antibiotic' },
  { id: 'A', label: 'Antibiotic A only' },
  { id: 'AthenB', label: 'A, then switch to B' },
  { id: 'AandB', label: 'A and B together' },
];
const names: Record<string, string> = { S: 'susceptible to both', A: 'resistant to A', B: 'resistant to B', AB: 'resistant to A and B (multiresistant)' };
const band = (key: 'A' | 'B') => {
  const gs = r.drugs.map((x, g) => (x[key] ? g : -1)).filter((g) => g >= 0);
  return gs.length ? { x: sx(frame, gs[0]!), w: sx(frame, gs[gs.length - 1]!) - sx(frame, gs[0]!) } : { x: 0, w: 0 };
};
const rows = range(0, GENERATIONS, 10);
const fmt = (n: number) => { if (n < 1000) return String(n); const [m, e] = n.toExponential(1).split('e+'); return `${m} × 10${e!.split('').map((c) => '⁰¹²³⁴⁵⁶⁷⁸⁹'[Number(c)]).join('')}`; };
---
<div class="res" data-res data-frame={JSON.stringify(frame)} data-seed={d.seed}>
  <div class="layout">
    <div class="out">
      <svg class="chart" viewBox={`0 0 ${frame.w} ${frame.h}`} role="img" aria-labelledby="res-t" data-chart>
        <title id="res-t">Numbers of susceptible, singly resistant and multiresistant bacteria over generations</title>
        <rect class="band a" data-band="A" x={band('A').x} y="6" width={band('A').w} height="14" />
        <rect class="band b" data-band="B" x={band('B').x} y="24" width={band('B').w} height="14" />
        <text class="band-t" x={frame.left - 6} y="17" text-anchor="end">A in use</text>
        <text class="band-t" x={frame.left - 6} y="35" text-anchor="end">B in use</text>
        <g class="grid">
          {frame.x.ticks.map((t) => <line x1={sx(frame, t)} x2={sx(frame, t)} y1={frame.top} y2={frame.h - frame.bottom} />)}
          {frame.y.ticks.map((t) => <line x1={frame.left} x2={frame.w - frame.right} y1={sy(frame, t)} y2={sy(frame, t)} />)}
        </g>
        <g class="ticks">
          {frame.x.ticks.map((t) => <text x={sx(frame, t)} y={frame.h - frame.bottom + 20} text-anchor="middle">{t}</text>)}
          {frame.y.ticks.map((t) => <text x={frame.left - 8} y={sy(frame, t)} dy="0.35em" text-anchor="end">{t === 0 ? '1' : `10${sup[t]}`}</text>)}
        </g>
        <text class="axis" x={(frame.left + frame.w - frame.right) / 2} y={frame.h - 10} text-anchor="middle">{frame.x.label} →</text>
        <text class="axis" transform={`translate(15 ${(frame.top + frame.h - frame.bottom) / 2}) rotate(-90)`} text-anchor="middle">{frame.y.label} →</text>
        {STRAINS.map((s) => <path class={`line s-${s}`} data-line={s} d={linePath(frame, lg(r.counts[s]), GENERATIONS)} />)}
      </svg>
      <ul class="legend" aria-hidden="true">
        {STRAINS.map((s) => <li><span class={`key s-${s}`}></span> {names[s]}</li>)}
      </ul>
    </div>
    <div class="controls">
      <fieldset class="modes">
        <legend>Treatment from generation 10</legend>
        {treatments.map((t) => (
          <label class="pill"><input type="radio" name="res-treat" value={t.id} checked={t.id === d.treatment} data-treat /> {t.label}</label>
        ))}
      </fieldset>
      <label class="slider"><span>Chance of gaining a resistance gene: <output data-out="rate">1 in 10{sup[-d.log10Rate]}</output></span>
        <input type="range" min="-9" max="-5" step="1" value={d.log10Rate} data-param="rate" />
        <span class="hint">per bacterium per generation, by mutation or gene transfer, for each antibiotic</span>
      </label>
      <button class="btn" type="button" data-reseed>Run again (new random seed)</button>
    </div>
  </div>
  <p class="readout" aria-live="polite" data-readout>
    A, then B: the bacteria resistant to A survived antibiotic A and multiplied; after the switch, antibiotic B selected the few that were also resistant to B. A multiresistant strain first appeared in generation {r.abFirst}.
  </p>
  <details class="table">
    <summary>Show data table</summary>
    <table>
      <thead><tr><th scope="col">Generation</th>{STRAINS.map((s) => <th scope="col">{names[s]}</th>)}</tr></thead>
      <tbody data-tbody>{rows.map((g) => <tr><th scope="row">{g}</th>{STRAINS.map((s) => <td>{fmt(r.counts[s][g]!)}</td>)}</tr>)}</tbody>
    </table>
  </details>
  <p class="model-note">Qualitative model with seeded random numbers: a population of up to 10⁸ bacteria; each antibiotic kills 90% of non-resistant cells per generation; resistance genes carry a small cost when no antibiotic is present. Real infections are also attacked by the immune system.</p>
</div>

<script>
  import { linePath, range, sx, type Frame } from './chart';
  import { GENERATIONS, STRAINS, finalResistantFraction, simulate, type Treatment } from './models/c3-2-resistance';

  const sup = ['⁰', '¹', '²', '³', '⁴', '⁵', '⁶', '⁷', '⁸', '⁹'];
  const names: Record<string, string> = { S: 'susceptible to both', A: 'resistant to A', B: 'resistant to B', AB: 'resistant to A and B (multiresistant)' };
  const fmt = (n: number) => { if (n < 1000) return String(n); const [m, e] = n.toExponential(1).split('e+'); return `${m} × 10${e!.split('').map((c) => '⁰¹²³⁴⁵⁶⁷⁸⁹'[Number(c)]).join('')}`; };
  document.querySelectorAll<HTMLElement>('[data-res]').forEach((root) => {
    const frame = JSON.parse(root.dataset.frame!) as Frame;
    const rate = root.querySelector<HTMLInputElement>('[data-param="rate"]')!;
    const readout = root.querySelector<HTMLElement>('[data-readout]')!;
    const tbody = root.querySelector<HTMLElement>('[data-tbody]')!;
    let seed = Number(root.dataset.seed);
    let raf = 0;
    let timer = 0;
    const run = () => {
      raf = 0;
      const treatment = (root.querySelector<HTMLInputElement>('[data-treat]:checked')?.value ?? 'none') as Treatment;
      const log10Rate = Number(rate.value);
      root.querySelector('[data-out="rate"]')!.textContent = `1 in 10${sup[-log10Rate]}`;
      const r = simulate({ treatment, log10Rate, seed });
      for (const s of STRAINS) {
        const a = r.counts[s];
        root.querySelector(`[data-line="${s}"]`)!.setAttribute('d', linePath(frame, (g) => { const n = a[Math.round(g)]!; return n >= 1 ? Math.log10(n) : NaN; }, GENERATIONS));
      }
      for (const key of ['A', 'B'] as const) {
        const gs = r.drugs.map((x, g) => (x[key] ? g : -1)).filter((g) => g >= 0);
        const el = root.querySelector(`[data-band="${key}"]`)!;
        el.setAttribute('x', String(gs.length ? sx(frame, gs[0]!) : 0));
        el.setAttribute('width', String(gs.length ? sx(frame, gs[gs.length - 1]!) - sx(frame, gs[0]!) : 0));
      }
      tbody.innerHTML = range(0, GENERATIONS, 10).map((g) => `<tr><th scope="row">${g}</th>${STRAINS.map((s) => `<td>${fmt(r.counts[s][g]!)}</td>`).join('')}</tr>`).join('');
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        const L = GENERATIONS;
        const total = STRAINS.reduce((acc, s) => acc + r.counts[s][L]!, 0);
        const frac = finalResistantFraction(r);
        const top = STRAINS.reduce((a, s) => (r.counts[s][L]! > r.counts[a][L]! ? s : a), 'S' as (typeof STRAINS)[number]);
        let msg: string;
        if (treatment === 'none') msg = `No antibiotic: resistant variants arise but are not selected (they carry a small cost), so only ${(frac * 100).toPrecision(2)}% of the bacteria are resistant at the end.`;
        else if (total === 0) msg = 'The antibiotic killed every bacterium before a resistant variant arose: the infection was cleared.';
        else msg = `By generation ${L} the population is mostly bacteria ${names[top]}. The antibiotic killed the susceptible bacteria, so resistant variants that were already present survived, reproduced and took over.`;
        if (r.abFirst >= 0 && treatment !== 'none') msg += ` A multiresistant strain first appeared in generation ${r.abFirst}.`;
        if (treatment === 'AandB' && r.counts.AB[L]! === 0 && total === 0) msg += ' Using two antibiotics together means a bacterium must already resist both to survive, which is very rare.';
        readout.textContent = msg;
      }, 350);
    };
    const schedule = () => { if (!raf) raf = requestAnimationFrame(run); };
    rate.addEventListener('input', schedule);
    root.querySelectorAll('[data-treat]').forEach((el) => el.addEventListener('change', schedule));
    root.querySelector('[data-reseed]')!.addEventListener('click', () => { seed += 1; schedule(); });
  });
</script>

<style>
  .res { container-type: inline-size; }
  .layout { display: grid; gap: var(--space-4); }
  @container (min-width: 46rem) { .layout { grid-template-columns: minmax(0, 1.6fr) minmax(15rem, 1fr); align-items: start; } }
  .chart { width: 100%; height: auto; font-family: var(--font-sans); }
  .grid line { stroke: var(--border); stroke-width: 1; }
  .ticks text { font-size: 15px; fill: var(--text-muted); }
  .axis { font-size: 16px; font-weight: 650; fill: var(--text); }
  .band.a { fill: color-mix(in srgb, var(--bio-protein) 45%, transparent); }
  .band.b { fill: color-mix(in srgb, var(--bio-glucose) 55%, transparent); }
  .band-t { font-size: 13px; fill: var(--text-muted); }
  .line { fill: none; stroke-width: 3.2; stroke-linecap: round; stroke-linejoin: round; }
  .s-S { stroke: var(--text-muted); border-color: var(--text-muted); }
  .s-A { stroke: var(--bio-protein); border-color: var(--bio-protein); stroke-dasharray: 10 6; }
  .s-B { stroke: var(--bio-carb); border-color: var(--bio-carb); stroke-dasharray: 2 6; }
  .s-AB { stroke: var(--bio-k); border-color: var(--bio-k); stroke-width: 4.5; stroke-dasharray: 16 5 3 5; }
  .legend { list-style: none; margin: var(--space-1) 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-4); font-size: var(--step--1); color: var(--text-muted); }
  .legend li { display: inline-flex; align-items: center; gap: var(--space-2); margin: 0; }
  .key { display: inline-block; width: 2rem; height: 0; border-top: 3.5px solid; }
  .key.s-S { border-top-color: var(--text-muted); }
  .key.s-A { border-top-style: dashed; border-top-color: var(--bio-protein); }
  .key.s-B { border-top-style: dotted; border-top-color: var(--bio-carb); }
  .key.s-AB { border-top-width: 5px; border-top-style: dashed; border-top-color: var(--bio-k); }
  .controls { display: grid; gap: var(--space-3); font-size: var(--step--1); align-content: start; }
  .modes { border: 0; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .modes legend { font-weight: 700; margin-bottom: var(--space-2); padding: 0; }
  .pill { position: relative; display: inline-flex; align-items: center; min-height: 2.1rem; padding: 0.25rem 0.8rem; border: 1px solid var(--border-strong); border-radius: 999px; cursor: pointer; font-weight: 650; background: var(--surface); }
  .pill input { position: absolute; inset: 0; opacity: 0; margin: 0; cursor: pointer; }
  .pill:has(input:checked) { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
  .pill:has(input:focus-visible) { outline: 3px solid var(--focus); outline-offset: 2px; }
  .slider { display: grid; gap: var(--space-1); font-weight: 600; }
  .hint { font-weight: 400; color: var(--text-muted); font-size: 0.8rem; }
  output { font-weight: 800; color: var(--accent-strong); }
  .controls .btn { justify-self: start; }
  .readout { margin: var(--space-3) 0 0; padding: var(--space-3); background: var(--surface-2); border-radius: var(--radius-m); font-size: var(--step--1); }
  .table { margin-top: var(--space-2); font-size: var(--step--1); overflow-x: auto; }
  .table summary { cursor: pointer; font-weight: 650; color: var(--accent-strong); }
  table { border-collapse: collapse; margin-top: var(--space-2); font-variant-numeric: tabular-nums; }
  th, td { padding: 0.2rem 0.6rem; border-bottom: 1px solid var(--border); text-align: right; }
  .model-note { font-size: 0.8rem; color: var(--text-muted); margin: var(--space-2) 0 0; }
</style>
