---
import { DEFAULT_GROWTH as d, frameFor, growthSvg, growthText } from './c4-1-growth-view';
import { duckweed, exponential, logistic } from './models/c4-1-growth';
const f = frameFor(false);
---
<div class="sim-growth" data-sim-growth>
  <div class="layout">
    <svg class="chart" viewBox={`0 0 ${f.w} ${f.h}`} role="img" aria-labelledby="c41g-t c41g-d">
      <title id="c41g-t">Population size against time: exponential and sigmoid (logistic) models</title>
      <desc id="c41g-d">The exponential curve keeps getting steeper. The sigmoid curve rises steeply at first, then levels off at the carrying capacity K. Shaded bands mark the exponential, transitional and plateau phases.</desc>
      <g data-chart set:html={growthSvg(d)} />
    </svg>
    <div class="controls">
      <label class="slider">Growth rate, r (per day): <output data-out="r">{d.r.toFixed(2)}</output>
        <input type="range" min="0.05" max="0.6" step="0.01" value={d.r} data-param="r" />
      </label>
      <label class="slider">Carrying capacity, K (fronds): <output data-out="k">{d.k}</output>
        <input type="range" min="100" max="600" step="10" value={d.k} data-param="k" />
      </label>
      <label class="slider">Read the graph on day: <output data-out="at">{d.at}</output>
        <input type="range" min="0" max="30" step="1" value={d.at} data-param="at" />
      </label>
      <fieldset class="legend">
        <legend>Show</legend>
        <label><input type="checkbox" data-show="logi" checked /> <span class="key logi"></span> Sigmoid (logistic) model</label>
        <label><input type="checkbox" data-show="exp" checked /> <span class="key exp"></span> Exponential model</label>
        <label><input type="checkbox" data-show="data" checked /> <span class="key-pt"></span> Duckweed counts (illustrative)</label>
        <label><input type="checkbox" data-show="log" /> Logarithmic vertical axis</label>
      </fieldset>
      <button type="button" class="btn" data-fit>Fit the model to the data</button>
    </div>
  </div>
  <p class="readout" aria-live="polite" data-readout>{growthText(d)}</p>
  <details class="table">
    <summary>Show data table</summary>
    <table>
      <thead><tr><th scope="col">Day</th><th scope="col">Fronds counted</th><th scope="col">Sigmoid model</th><th scope="col">Exponential model</th></tr></thead>
      <tbody data-tbody>{duckweed.map((p) => <tr><th scope="row">{p.day}</th><td>{p.fronds}</td><td>{Math.round(logistic(duckweed[0]!.fronds, d.r, d.k, p.day))}</td><td>{Math.round(exponential(duckweed[0]!.fronds, d.r, p.day))}</td></tr>)}</tbody>
    </table>
  </details>
  <p class="model-note">Idealized models: real populations rarely follow either curve exactly. The duckweed counts are illustrative values of the kind a class investigation produces (12 fronds in a beaker of mineral-ion solution, counted every two days), not published data. Phase boundaries are drawn at 25% and 95% of K; the change from one phase to the next is gradual.</p>
</div>

<script>
  import { bestFit, growthSvg, growthText, type GrowthState } from './c4-1-growth-view';
  import { duckweed, exponential, logistic } from './models/c4-1-growth';

  document.querySelectorAll<HTMLElement>('[data-sim-growth]').forEach((root) => {
    const input = (k: string) => root.querySelector<HTMLInputElement>(`[data-param="${k}"]`)!;
    const show = (k: string) => root.querySelector<HTMLInputElement>(`[data-show="${k}"]`)!.checked;
    const chart = root.querySelector<SVGGElement>('[data-chart]')!;
    const readout = root.querySelector<HTMLElement>('[data-readout]')!;
    const tbody = root.querySelector<HTMLElement>('[data-tbody]')!;
    let timer = 0;
    const state = (): GrowthState => ({
      r: Number(input('r').value), k: Number(input('k').value), at: Number(input('at').value),
      exp: show('exp'), logi: show('logi'), data: show('data'), log: show('log'),
    });
    const update = () => {
      const s = state();
      root.querySelector('[data-out="r"]')!.textContent = s.r.toFixed(2);
      root.querySelector('[data-out="k"]')!.textContent = String(s.k);
      root.querySelector('[data-out="at"]')!.textContent = String(s.at);
      chart.innerHTML = growthSvg(s);
      const n0 = duckweed[0]!.fronds;
      tbody.innerHTML = duckweed
        .map((p) => `<tr><th scope="row">${p.day}</th><td>${p.fronds}</td><td>${Math.round(logistic(n0, s.r, s.k, p.day))}</td><td>${Math.round(exponential(n0, s.r, p.day))}</td></tr>`)
        .join('');
      clearTimeout(timer);
      timer = window.setTimeout(() => (readout.textContent = growthText(s)), 300);
    };
    root.querySelectorAll('[data-param]').forEach((el) => el.addEventListener('input', update));
    root.querySelectorAll('[data-show]').forEach((el) => el.addEventListener('change', update));
    root.querySelector('[data-fit]')!.addEventListener('click', () => {
      const b = bestFit();
      input('r').value = String(b.r);
      input('k').value = String(b.k);
      update();
    });
  });
</script>

<style>
  .sim-growth { container-type: inline-size; }
  .layout { display: grid; gap: var(--space-4); }
  @container (min-width: 46rem) { .layout { grid-template-columns: minmax(0, 1.6fr) minmax(15rem, 1fr); align-items: start; } }
  .chart { width: 100%; height: auto; font-family: var(--font-sans); }
  .chart :global(.grid line) { stroke: var(--border); stroke-width: 1; }
  .chart :global(.axisline) { fill: none; stroke: var(--text-muted); stroke-width: 1.4; }
  .chart :global(.ticks text) { font-size: 15px; fill: var(--text-muted); }
  .chart :global(.axis) { font-size: 16px; font-weight: 650; fill: var(--text); }
  .chart :global(.band-exp) { fill: color-mix(in srgb, var(--bio-carb) 10%, transparent); }
  .chart :global(.band-tr) { fill: color-mix(in srgb, var(--bio-glucose) 12%, transparent); }
  .chart :global(.band-pl) { fill: color-mix(in srgb, var(--bio-protein) 10%, transparent); }
  .chart :global(.band-t) { font-size: 14px; font-weight: 700; fill: var(--text-muted); }
  .chart :global(.kline) { stroke: var(--text-muted); stroke-width: 1.5; stroke-dasharray: 2 5; }
  .chart :global(.k-t) { font-size: 14px; font-weight: 700; fill: var(--text-muted); }
  .chart :global(.line) { fill: none; stroke-width: 3.5; stroke-linecap: round; stroke-linejoin: round; }
  .chart :global(.logi) { stroke: var(--bio-carb); }
  .chart :global(.exp) { stroke: var(--bio-chol); stroke-dasharray: 12 7; }
  .chart :global(.pt) { fill: var(--surface); stroke: var(--text); stroke-width: 2; }
  .chart :global(.marker) { stroke: var(--text); stroke-width: 1.2; stroke-dasharray: 3 3; }
  .chart :global(.mk) { fill: var(--bio-carb); stroke: var(--surface); stroke-width: 2; }
  @container (max-width: 30rem) {
    .chart :global(.ticks text) { font-size: 20px; }
    .chart :global(.axis) { font-size: 20px; }
    .chart :global(.band-t), .chart :global(.k-t) { font-size: 18px; }
  }
  .controls { display: grid; gap: var(--space-3); font-size: var(--step--1); align-content: start; }
  .legend { border: 0; padding: 0; margin: 0; display: grid; gap: var(--space-1); }
  .legend legend { font-weight: 700; color: var(--text-muted); margin-bottom: var(--space-1); }
  .legend label { display: flex; align-items: center; gap: var(--space-2); min-height: 1.75rem; }
  .key { display: inline-block; width: 2rem; height: 0; border-top: 3.5px solid; }
  .key.logi { border-color: var(--bio-carb); }
  .key.exp { border-color: var(--bio-chol); border-top-style: dashed; }
  .key-pt { display: inline-block; width: 0.8rem; height: 0.8rem; border-radius: 50%; border: 2px solid var(--text); background: var(--surface); margin: 0 0.6rem; }
  .slider { display: grid; gap: var(--space-1); font-weight: 600; }
  output { font-weight: 800; color: var(--accent-strong); }
  .readout { margin: var(--space-3) 0 0; padding: var(--space-3); background: var(--surface-2); border-radius: var(--radius-m); font-size: var(--step--1); }
  .table { margin-top: var(--space-2); font-size: var(--step--1); }
  .table summary { cursor: pointer; font-weight: 650; color: var(--accent-strong); }
  table { border-collapse: collapse; margin-top: var(--space-2); font-variant-numeric: tabular-nums; }
  .table :global(th), .table :global(td) { padding: 0.2rem 0.7rem; border-bottom: 1px solid var(--border); text-align: right; }
  .model-note { font-size: 0.8rem; color: var(--text-muted); margin: var(--space-2) 0 0; }
</style>
