---
/** Surface area-to-volume explorer (B2.3.6, with the shape comparison for B2.3.7). Maths in models/b2-3-sav.ts. */
import { linePath, range, sx, sy, type Frame } from './chart';
import { cube, cubeTable, fmt, measure } from './models/b2-3-sav';
import { ART, curvePath, shapeArt } from './b2-3-sav-draw';

const L0 = 4;
const ratioFrame: Frame = {
  w: 640, h: 330, left: 58, right: 18, top: 16, bottom: 52,
  x: { min: 0, max: 10, ticks: range(0, 10, 2), label: 'Size: side length of a cube of the same volume (µm)' },
  y: { min: 0, max: 10, ticks: range(0, 10, 2), label: 'SA:V ratio (µm⁻¹)' },
};
const growFrame: Frame = {
  w: 640, h: 330, left: 66, right: 18, top: 16, bottom: 52,
  x: { min: 0, max: 10, ticks: range(0, 10, 2), label: 'Side length of cube, L (µm)' },
  y: { min: 0, max: 1000, ticks: range(0, 1000, 200), label: 'Surface area (µm²) or volume (µm³)' },
};
const curves = {
  cube: curvePath(ratioFrame, (x) => measure('cube', x).ratio),
  sphere: curvePath(ratioFrame, (x) => measure('sphere', x).ratio),
  flat: curvePath(ratioFrame, (x) => measure('flat', x).ratio),
  sa: linePath(growFrame, (x) => cube(x).sa),
  v: linePath(growFrame, (x) => cube(x).v),
};
const c0 = cube(L0);
const rows = cubeTable(range(1, 10, 1));
---
<div class="sav" data-sim-sav data-ratio-frame={JSON.stringify(ratioFrame)} data-grow-frame={JSON.stringify(growFrame)}>
  <div class="layout">
    <div class="views">
      <svg class="art" viewBox={`0 0 ${ART.w} ${ART.h}`} role="img" aria-labelledby="sav-art-t" data-art-svg>
        <title id="sav-art-t" data-art-title>A cube of side {L0} µm, drawn to scale</title>
        <g data-art set:html={shapeArt('cube', L0, false)} />
        <g class="scalebar" transform="translate(16 232)">
          <line x1="0" x2={ART.scale * 2} y1="0" y2="0" />
          <line x1="0" x2="0" y1="-4" y2="4" /><line x1={ART.scale * 2} x2={ART.scale * 2} y1="-4" y2="4" />
          <text x={ART.scale * 2 + 6} y="0" dy="0.35em">2 µm</text>
        </g>
      </svg>

      <svg class="chart" viewBox={`0 0 ${ratioFrame.w} ${ratioFrame.h}`} role="img" aria-labelledby="sav-r-t" data-graph="ratio">
        <title id="sav-r-t">SA:V ratio against size for a cube, a sphere and a flattened cell of the same volume</title>
        <g class="grid">
          {ratioFrame.x.ticks.map((t) => <line x1={sx(ratioFrame, t)} x2={sx(ratioFrame, t)} y1={ratioFrame.top} y2={ratioFrame.h - ratioFrame.bottom} />)}
          {ratioFrame.y.ticks.map((t) => <line x1={ratioFrame.left} x2={ratioFrame.w - ratioFrame.right} y1={sy(ratioFrame, t)} y2={sy(ratioFrame, t)} />)}
        </g>
        <g class="ticks">
          {ratioFrame.x.ticks.map((t) => <text x={sx(ratioFrame, t)} y={ratioFrame.h - ratioFrame.bottom + 18} text-anchor="middle">{t}</text>)}
          {ratioFrame.y.ticks.map((t) => <text x={ratioFrame.left - 8} y={sy(ratioFrame, t)} dy="0.35em" text-anchor="end">{t}</text>)}
        </g>
        <text class="axis" x={(ratioFrame.left + ratioFrame.w - ratioFrame.right) / 2} y={ratioFrame.h - 10} text-anchor="middle">{ratioFrame.x.label} →</text>
        <text class="axis" transform={`translate(16 ${(ratioFrame.top + ratioFrame.h - ratioFrame.bottom) / 2}) rotate(-90)`} text-anchor="middle">{ratioFrame.y.label} →</text>
        <path class="line flat" d={curves.flat} />
        <path class="line cube" d={curves.cube} />
        <path class="line sphere" d={curves.sphere} />
        <line class="marker" data-marker x1={sx(ratioFrame, L0)} x2={sx(ratioFrame, L0)} y1={ratioFrame.top} y2={ratioFrame.h - ratioFrame.bottom} />
        <circle class="dot" data-dot r="7" cx={sx(ratioFrame, L0)} cy={sy(ratioFrame, c0.ratio)} />
        <circle class="dot-div" data-dot-div r="7" cx={sx(ratioFrame, L0)} cy={sy(ratioFrame, 2 * c0.ratio)} style="display:none" />
      </svg>

      <svg class="chart" viewBox={`0 0 ${growFrame.w} ${growFrame.h}`} role="img" aria-labelledby="sav-g-t" data-graph="grow" style="display:none">
        <title id="sav-g-t">Surface area and volume of a cube against its side length. Volume rises faster than surface area; area and volume have different units, so the point where the curves cross has no biological meaning</title>
        <g class="grid">
          {growFrame.x.ticks.map((t) => <line x1={sx(growFrame, t)} x2={sx(growFrame, t)} y1={growFrame.top} y2={growFrame.h - growFrame.bottom} />)}
          {growFrame.y.ticks.map((t) => <line x1={growFrame.left} x2={growFrame.w - growFrame.right} y1={sy(growFrame, t)} y2={sy(growFrame, t)} />)}
        </g>
        <g class="ticks">
          {growFrame.x.ticks.map((t) => <text x={sx(growFrame, t)} y={growFrame.h - growFrame.bottom + 18} text-anchor="middle">{t}</text>)}
          {growFrame.y.ticks.map((t) => <text x={growFrame.left - 8} y={sy(growFrame, t)} dy="0.35em" text-anchor="end">{t}</text>)}
        </g>
        <text class="axis" x={(growFrame.left + growFrame.w - growFrame.right) / 2} y={growFrame.h - 10} text-anchor="middle">{growFrame.x.label} →</text>
        <text class="axis" transform={`translate(16 ${(growFrame.top + growFrame.h - growFrame.bottom) / 2}) rotate(-90)`} text-anchor="middle">{growFrame.y.label} →</text>
        <path class="line sa" d={curves.sa} />
        <path class="line vol" d={curves.v} />
        <text class="note" x={sx(growFrame, 6) + 8} y={sy(growFrame, 216) + 22}>curves cross (different units)</text>
        <text class="lab vol" x={sx(growFrame, 8.3) - 6} y={sy(growFrame, 8.3 ** 3) - 6} text-anchor="end">volume, L³</text>
        <text class="lab sa" x={sx(growFrame, 7.4)} y={sy(growFrame, 6 * 7.4 ** 2) + 30}>surface area, 6L²</text>
        <line class="marker" data-marker2 x1={sx(growFrame, L0)} x2={sx(growFrame, L0)} y1={growFrame.top} y2={growFrame.h - growFrame.bottom} />
      </svg>
      <p class="graph-note" data-graph="grow" style="display:none">SA:V falls below 1 µm⁻¹ when L exceeds 6 µm. The two curves can be plotted together, but area (µm²) and volume (µm³) have different units, so their crossing has no biological meaning.</p>
    </div>

    <div class="controls">
      <label class="slider">Side length of the cube, L: <output data-out="L">{L0} µm</output>
        <input type="range" min="1" max="10" step="0.5" value={L0} data-param="L" />
      </label>
      <fieldset>
        <legend>Shape (same volume as the cube)</legend>
        <label><input type="radio" name="sav-shape" value="cube" checked data-shape /> <span class="key cube"></span> Cube</label>
        <label><input type="radio" name="sav-shape" value="sphere" data-shape /> <span class="key sphere"></span> Sphere</label>
        <label><input type="radio" name="sav-shape" value="flat" data-shape /> <span class="key flat"></span> Flattened cell (8 × wider than thick)</label>
      </fieldset>
      <fieldset>
        <legend>Graph</legend>
        <label><input type="radio" name="sav-graph" value="ratio" checked data-graph-pick /> SA:V ratio against size</label>
        <label><input type="radio" name="sav-graph" value="grow" data-graph-pick /> Surface area and volume of the cube</label>
      </fieldset>
      <button class="btn" type="button" data-divide aria-pressed="false">Divide into 8 cells</button>
      <div class="working" data-working>
        <p><strong data-w-title>Cube, L = {L0} µm</strong></p>
        <p data-w1>SA = 6 × L² = 6 × {L0}² = <b>{fmt(c0.sa)} µm²</b></p>
        <p data-w2>V = L³ = {L0}³ = <b>{fmt(c0.v)} µm³</b></p>
        <p data-w3>SA:V = {fmt(c0.sa)} ÷ {fmt(c0.v)} = <b>{fmt(c0.ratio)} µm⁻¹</b></p>
      </div>
    </div>
  </div>
  <p class="readout" aria-live="polite" data-readout>
    A cube of side {L0} µm has {fmt(c0.ratio)} µm² of surface for every µm³ of volume.
  </p>
  <details class="table">
    <summary>Show data table</summary>
    <table>
      <caption>Cubes of different side lengths</caption>
      <thead><tr><th scope="col">Side, L (µm)</th><th scope="col">SA = 6L² (µm²)</th><th scope="col">V = L³ (µm³)</th><th scope="col">SA:V (µm⁻¹)</th></tr></thead>
      <tbody>{rows.map((r) => <tr><th scope="row">{r.L}</th><td>{fmt(r.sa, 4)}</td><td>{fmt(r.v, 4)}</td><td>{fmt(r.ratio)}</td></tr>)}</tbody>
    </table>
  </details>
  <p class="model-note">A model: real cells are not cubes, spheres or plates, and their shapes are irregular. The scale factors work the same way for any shape: multiply every length by x and the surface area rises by x² but the volume by x³.</p>
</div>

<script>
  import { sx, sy, type Frame } from './chart';
  import { fmt, measure, shapeName, divide, type Shape } from './models/b2-3-sav';
  import { shapeArt } from './b2-3-sav-draw';

  document.querySelectorAll<HTMLElement>('[data-sim-sav]').forEach((root) => {
    const rf = JSON.parse(root.dataset.ratioFrame!) as Frame;
    const gf = JSON.parse(root.dataset.growFrame!) as Frame;
    const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const slider = q<HTMLInputElement>('[data-param="L"]');
    const divBtn = q<HTMLButtonElement>('[data-divide]');
    const readout = q<HTMLElement>('[data-readout]');
    let divided = false;
    let timer = 0;

    const shape = () => (root.querySelector<HTMLInputElement>('[data-shape]:checked')?.value ?? 'cube') as Shape;
    const set = (sel: string, html: string) => { q<HTMLElement>(sel).innerHTML = html; };
    const setX = (el: SVGLineElement, x: number) => { el.setAttribute('x1', x.toFixed(1)); el.setAttribute('x2', x.toFixed(1)); };

    const update = () => {
      const L = Number(slider.value), sh = shape();
      const m = measure(sh, L), d = divide(sh, L);
      q('[data-out="L"]').textContent = `${L} µm`;
      q('[data-art]').innerHTML = shapeArt(sh, L, divided);
      const what = sh === 'cube' ? 'cube' : sh === 'sphere' ? 'sphere' : 'flattened plate';
      q('[data-art-title]').textContent = divided
        ? `Eight smaller ${what}s whose total volume equals a cube of side ${L} µm, drawn to scale`
        : sh === 'cube' ? `A cube of side ${L} µm, drawn to scale` : `A ${what} with the volume of a cube of side ${L} µm, drawn to scale`;

      // working, shown the way it would be set out in an exam answer
      const cur = divided ? d : m;
      const name = sh === 'cube' ? 'Cube' : sh === 'sphere' ? 'Sphere' : 'Flattened cell';
      set('[data-w-title]', divided ? `8 × ${name.toLowerCase()} (total volume of a cube of side ${L} µm)` : `${name}, volume of a cube of side ${L} µm`);
      if (sh === 'cube' && !divided) {
        set('[data-w1]', `SA = 6 × L² = 6 × ${L}² = <b>${fmt(m.sa)} µm²</b>`);
        set('[data-w2]', `V = L³ = ${L}³ = <b>${fmt(m.v)} µm³</b>`);
      } else if (sh === 'cube') {
        set('[data-w1]', `Each cube has side ${L / 2} µm. Total SA = 8 × 6 × ${L / 2}² = <b>${fmt(d.sa)} µm²</b>`);
        set('[data-w2]', `Total V = 8 × ${L / 2}³ = <b>${fmt(d.v)} µm³</b> (unchanged)`);
      } else {
        const each = divided ? ' (total of all 8)' : '';
        set('[data-w1]', `SA = <b>${fmt(cur.sa)} µm²</b>${each}`);
        set('[data-w2]', `V = <b>${fmt(cur.v)} µm³</b>${each}`);
      }
      set('[data-w3]', `SA:V = ${fmt(cur.sa)} ÷ ${fmt(cur.v)} = <b>${fmt(cur.ratio)} µm⁻¹</b>`);

      // graph markers
      const x = sx(rf, L);
      setX(q<SVGLineElement>('[data-marker]'), x);
      setX(q<SVGLineElement>('[data-marker2]'), sx(gf, L));
      const dot = q<SVGCircleElement>('[data-dot]');
      dot.setAttribute('cx', x.toFixed(1)); dot.setAttribute('cy', sy(rf, Math.min(rf.y.max, m.ratio)).toFixed(1));
      dot.setAttribute('class', `dot ${sh}`);
      const dd = q<SVGCircleElement>('[data-dot-div]');
      dd.style.display = divided && d.ratio <= rf.y.max ? '' : 'none';
      dd.setAttribute('cx', x.toFixed(1)); dd.setAttribute('cy', sy(rf, Math.min(rf.y.max, d.ratio)).toFixed(1));

      divBtn.textContent = divided ? 'Put back as one cell' : 'Divide into 8 cells';
      divBtn.setAttribute('aria-pressed', String(divided));

      clearTimeout(timer);
      timer = window.setTimeout(() => {
        const base = sh === 'cube' ? `A cube of side ${L} µm has SA:V = ${fmt(m.ratio)} µm⁻¹.` : `A ${shapeName[sh]} with the volume of a cube of side ${L} µm has SA:V = ${fmt(m.ratio)} µm⁻¹.`;
        const div = divided ? ` Divided into 8 smaller cells of the same shape, the total volume is unchanged but the total surface area doubles, so SA:V rises to ${fmt(d.ratio)} µm⁻¹.` : '';
        const shapeNote = sh === 'sphere' ? ' A sphere has the smallest surface area for its volume.' : sh === 'flat' ? ` That is ${fmt(m.ratio / measure('cube', L).ratio, 2)} times the SA:V of a cube of the same volume.` : '';
        readout.textContent = base + shapeNote + div;
      }, 300);
    };

    slider.addEventListener('input', update);
    root.querySelectorAll('[data-shape]').forEach((r) => r.addEventListener('change', update));
    root.querySelectorAll<HTMLInputElement>('[data-graph-pick]').forEach((r) => r.addEventListener('change', () => {
      root.querySelectorAll<SVGSVGElement>('[data-graph]').forEach((g) => { g.style.display = g.dataset.graph === r.value ? '' : 'none'; });
    }));
    divBtn.addEventListener('click', () => { divided = !divided; update(); });
  });
</script>

<style>
  .sav { container-type: inline-size; }
  .layout { display: grid; gap: var(--space-4); }
  @container (min-width: 46rem) { .layout { grid-template-columns: minmax(0, 1.5fr) minmax(16rem, 1fr); align-items: start; } }
  .views { display: grid; gap: var(--space-3); }
  .art { width: 100%; max-width: 30rem; height: auto; justify-self: center; background: var(--surface-2); border-radius: var(--radius-m); font-family: var(--font-sans); }
  .art :global(.fr) { fill: color-mix(in srgb, var(--bio-protein) 30%, var(--surface)); stroke: var(--text); stroke-width: 1.4; stroke-linejoin: round; }
  .art :global(.tp) { fill: color-mix(in srgb, var(--bio-protein) 14%, var(--surface)); stroke: var(--text); stroke-width: 1.4; stroke-linejoin: round; }
  .art :global(.rt) { fill: color-mix(in srgb, var(--bio-protein) 48%, var(--surface)); stroke: var(--text); stroke-width: 1.4; stroke-linejoin: round; }
  .art :global(.sph) { fill: color-mix(in srgb, var(--bio-protein-2) 32%, var(--surface)); stroke: var(--text); stroke-width: 1.4; }
  .art :global(.eq) { fill: none; stroke: color-mix(in srgb, var(--text) 45%, transparent); stroke-width: 1; stroke-dasharray: 3 3; }
  .art :global(.hl) { fill: var(--surface); opacity: 0.7; }
  .scalebar line { stroke: var(--text); stroke-width: 2; }
  .scalebar text { font-size: 13px; fill: var(--text); font-weight: 650; }
  .chart { width: 100%; height: auto; font-family: var(--font-sans); }
  .grid line { stroke: var(--border); stroke-width: 1; }
  .ticks text { font-size: 17px; fill: var(--text-muted); }
  .axis { font-size: 16px; font-weight: 650; fill: var(--text); }
  .graph-note { margin: 0; font-size: var(--step--1); color: var(--text-muted); }
  .note { font-size: 14px; fill: var(--text-muted); font-style: italic; }
  .line { fill: none; stroke-width: 3.5; stroke-linecap: round; stroke-linejoin: round; }
  .line.cube, .key.cube { stroke: var(--bio-protein); border-color: var(--bio-protein); }
  .line.sphere { stroke: var(--bio-protein-2); stroke-dasharray: 12 7; }
  .line.flat { stroke: var(--bio-head); stroke-dasharray: 2 7; }
  .line.sa { stroke: var(--bio-carb); }
  .line.vol { stroke: var(--bio-k); stroke-dasharray: 12 7; }
  .lab { font-size: 15px; font-weight: 700; fill: var(--text); }
  .marker { stroke: var(--text); stroke-width: 1.2; stroke-dasharray: 3 3; }
  .dot { fill: var(--bio-protein); stroke: var(--surface); stroke-width: 2; }
  .dot.sphere { fill: var(--bio-protein-2); }
  .dot.flat { fill: var(--bio-head); }
  .dot-div { fill: var(--surface); stroke: var(--text); stroke-width: 2.5; }
  .controls { display: grid; gap: var(--space-3); font-size: var(--step--1); }
  .slider { display: grid; gap: var(--space-1); font-weight: 600; }
  output { font-weight: 800; color: var(--accent-strong); }
  fieldset { border: 1px solid var(--border); border-radius: var(--radius-m); padding: var(--space-2) var(--space-3) var(--space-3); margin: 0; display: grid; gap: var(--space-1); }
  legend { font-weight: 700; color: var(--text-muted); padding: 0 var(--space-1); }
  fieldset label { display: flex; align-items: center; gap: var(--space-2); min-height: 24px; }
  .key { display: inline-block; width: 1.8rem; height: 0; border-top: 3.5px solid; flex: none; }
  .key.sphere { border-color: var(--bio-protein-2); border-top-style: dashed; }
  .key.flat { border-color: var(--bio-head); border-top-style: dotted; }
  .working { padding: var(--space-3); border-radius: var(--radius-m); background: var(--surface-2); font-variant-numeric: tabular-nums; }
  .working p { margin: 0 0 0.25rem; }
  .working p:last-child { margin: 0; }
  .readout { margin: var(--space-3) 0 0; padding: var(--space-3); background: var(--surface-2); border-radius: var(--radius-m); font-size: var(--step--1); }
  .table { margin-top: var(--space-2); font-size: var(--step--1); }
  .table summary { cursor: pointer; font-weight: 650; color: var(--accent-strong); }
  table { border-collapse: collapse; margin-top: var(--space-2); font-variant-numeric: tabular-nums; }
  caption { text-align: left; font-weight: 650; padding-bottom: var(--space-1); }
  th, td { padding: 0.2rem 0.7rem; border-bottom: 1px solid var(--border); text-align: right; }
  .model-note { font-size: 0.8rem; color: var(--text-muted); margin: var(--space-2) 0 0; }
</style>
