---
import { FIELD, fieldMarkup, resultsMarkup } from './b3-1-stomata-draw';
import { TRUE_DENSITY, makeField, working } from './models/b3-1-stomata';

const d0 = 0.4;
// fixed seed so the server-rendered field is stable; the browser makes new ones
let s = 23;
const seeded = () => { s = (s * 16807) % 2147483647; return (s - 1) / 2147483646; };
const field0 = makeField(seeded, 'lower', d0);
const w0 = working([], d0);
---
<div class="sim-stoma" data-sim-stoma>
  <div class="layout">
    <div class="view">
      <svg class="field" viewBox={`0 0 ${FIELD.size} ${FIELD.size}`} role="img" aria-labelledby="sd-t sd-d">
        <title id="sd-t">Field of view of leaf epidermis at high power</title>
        <desc id="sd-d">A circular field of view showing wavy-walled epidermal cells and scattered stomata, each a pair of guard cells around a pore. Tap stomata to tick them off as you count.</desc>
        <g data-field set:html={fieldMarkup(field0, d0)} />
      </svg>
      <p class="tally" aria-live="polite" data-tally>Tap each stoma to tick it off as you count (ticked: 0). Count stomata that are more than half inside the circle.</p>
    </div>
    <div class="controls">
      <fieldset class="surface">
        <legend>Leaf surface</legend>
        <label><input type="radio" name="sd-surface" value="lower" checked data-surface /> Lower epidermis</label>
        <label><input type="radio" name="sd-surface" value="upper" data-surface /> Upper epidermis</label>
      </fieldset>
      <label class="slider">Diameter of the field of view (from a stage micrometer): <output data-out="d">{d0.toFixed(2)} mm</output>
        <input type="range" min="0.3" max="0.6" step="0.05" value={d0} data-param="d" />
      </label>
      <p class="hint">Changing the surface or the field size starts a new set of counts.</p>
      <div class="btns">
        <button class="btn btn-primary" type="button" data-record>Record this count</button>
        <button class="btn" type="button" data-next>New field of view</button>
        <button class="btn" type="button" data-auto>Record 10 more fields</button>
        <button class="btn" type="button" data-clear>Clear results</button>
      </div>
    </div>
  </div>
  <div class="results">
    <svg class="rchart" viewBox="0 0 360 200" role="img" aria-labelledby="sd-rt">
      <title id="sd-rt">Stomatal density estimated from each field, with the running mean</title>
      <g data-rchart set:html={resultsMarkup([], d0, TRUE_DENSITY.lower)} />
    </svg>
    <div class="calc">
      <p class="rkey">Green dots: the density from each single field. Orange line: the mean of all fields so far.</p>
      <p class="counts" data-counts>Counts recorded: none yet.</p>
      <ol class="working" data-working>{w0.lines.map((l) => <li>{l}</li>)}</ol>
    </div>
  </div>
  <p class="readout" aria-live="polite" data-readout>Count the stomata in this field, then record the count. Repeat for several randomly chosen fields of view.</p>
  <p class="model-note">Simulated leaf: stomata are scattered at random around an illustrative average of {TRUE_DENSITY.lower} per mm² on the lower epidermis and {TRUE_DENSITY.upper} per mm² on the upper epidermis, and each patch of leaf differs a little. Real values vary between species and with growing conditions.</p>
  <script type="application/json" data-field0 set:html={JSON.stringify(field0)} />
</div>

<script>
  import { fieldMarkup, resultsMarkup } from './b3-1-stomata-draw';
  import { TRUE_DENSITY, makeField, sd, working, type Stoma, type Surface } from './models/b3-1-stomata';

  document.querySelectorAll<HTMLElement>('[data-sim-stoma]').forEach((root) => {
    const $ = <T extends Element>(sel: string) => root.querySelector<T>(sel)!;
    const fieldG = $<SVGGElement>('[data-field]');
    const readout = $<HTMLElement>('[data-readout]');
    const tally = $<HTMLElement>('[data-tally]');
    const recordBtn = $<HTMLButtonElement>('[data-record]');
    let field = JSON.parse($('[data-field0]').textContent!) as Stoma[];
    let ticked = new Set<number>();
    let recorded = false;
    let counts: number[] = [];
    let timer = 0;
    const say = (text: string) => { clearTimeout(timer); timer = window.setTimeout(() => (readout.textContent = text), 300); };
    const d = () => Number($<HTMLInputElement>('[data-param="d"]').value);
    const surface = () => (root.querySelector<HTMLInputElement>('[data-surface]:checked')?.value ?? 'lower') as Surface;

    const drawField = () => { fieldG.innerHTML = fieldMarkup(field, d(), ticked); };
    const drawTally = () => {
      tally.textContent = recorded
        ? `This field has ${field.length} stomata${ticked.size ? ` (you ticked ${ticked.size})` : ''}. Choose a new field of view for the next count.`
        : `Tap each stoma to tick it off as you count (ticked: ${ticked.size}). Count stomata that are more than half inside the circle.`;
    };
    const drawResults = () => {
      $<SVGGElement>('[data-rchart]').innerHTML = resultsMarkup(counts, d(), TRUE_DENSITY[surface()]);
      const w = working(counts, d());
      $('[data-working]').innerHTML = w.lines.map((l) => `<li>${l}</li>`).join('');
      const n = counts.length;
      $('[data-counts]').textContent = n
        ? `Counts recorded (${n} field${n > 1 ? 's' : ''}): ${counts.join(', ')}. Range ${Math.min(...counts)}–${Math.max(...counts)}${n > 1 ? `; standard deviation ${sd(counts).toFixed(1)}` : ''}.`
        : 'Counts recorded: none yet.';
    };
    const newField = () => {
      field = makeField(Math.random, surface(), d());
      ticked = new Set();
      recorded = false;
      recordBtn.disabled = false;
      drawField(); drawTally();
    };
    const record = (c: number) => { counts.push(c); };
    const summary = () => {
      const w = working(counts, d());
      return `Mean ${w.mean.toFixed(1)} stomata per field from ${counts.length} field${counts.length > 1 ? 's' : ''}, so the estimated density is ${Math.round(w.density)} stomata per mm².`;
    };
    const reset = () => {
      counts = [];
      $('[data-out="d"]').textContent = `${d().toFixed(2)} mm`;
      newField(); drawResults();
      say(`New set of counts on the ${surface()} epidermis with a field of view ${d().toFixed(2)} mm across (area ${working([], d()).area.toFixed(4)} mm²).`);
    };

    fieldG.addEventListener('click', (e) => {
      const g = (e.target as Element).closest<SVGGElement>('.stoma');
      if (!g) return;
      const i = Number(g.dataset.i);
      if (ticked.has(i)) ticked.delete(i); else ticked.add(i);
      g.classList.toggle('ticked', ticked.has(i));
      drawTally();
    });
    recordBtn.addEventListener('click', () => {
      if (recorded) return;
      record(field.length);
      recorded = true;
      recordBtn.disabled = true;
      drawTally(); drawResults();
      say(`Field ${counts.length}: ${field.length} stomata. ${summary()}`);
    });
    $('[data-next]').addEventListener('click', () => { newField(); say('New field of view. Count its stomata, then record the count.'); });
    $('[data-auto]').addEventListener('click', () => {
      if (!recorded) record(field.length);
      for (let i = 0; i < (recorded ? 10 : 9); i++) record(makeField(Math.random, surface(), d()).length);
      newField(); drawResults();
      say(`Ten more fields recorded. ${summary()} Notice how much single counts vary, while the mean settles down as more fields are counted.`);
    });
    $('[data-clear]').addEventListener('click', reset);
    $('[data-param="d"]').addEventListener('input', reset);
    root.querySelectorAll('[data-surface]').forEach((r) => r.addEventListener('change', reset));
  });
</script>

<style>
  .sim-stoma { container-type: inline-size; }
  .layout { display: grid; gap: var(--space-4); }
  @container (min-width: 44rem) { .layout { grid-template-columns: minmax(0, 1fr) minmax(15rem, 1fr); align-items: start; } }
  .view { display: grid; gap: var(--space-2); justify-items: center; }
  .field { width: 100%; max-width: 26rem; height: auto; font-family: var(--font-sans); }
  .field :global(.field-bg) { fill: color-mix(in srgb, var(--bio-carb) 10%, var(--surface)); }
  .field :global(.field-edge) { fill: none; stroke: var(--text); stroke-width: 3; }
  .field :global(.cellwall) { fill: none; stroke: color-mix(in srgb, var(--bio-carb) 55%, var(--text-muted)); stroke-width: 2.4; }
  .field :global(.stoma) { cursor: pointer; }
  .field :global(.guard) { fill: color-mix(in srgb, var(--bio-carb) 70%, var(--surface)); stroke: color-mix(in srgb, var(--bio-carb) 60%, black); stroke-width: 1.2; }
  .field :global(.pore) { fill: var(--text); }
  .field :global(.tick) { fill: transparent; stroke: transparent; stroke-width: 3; }
  .field :global(.ticked .tick) { fill: color-mix(in srgb, var(--bio-head) 25%, transparent); stroke: var(--bio-head); }
  .field :global(.bar path) { stroke: var(--text); stroke-width: 4; }
  .field :global(.bar text), .field :global(.diam) { font-size: 14px; font-weight: 700; fill: var(--text); }
  .tally { margin: 0; font-size: var(--step--1); color: var(--text-muted); text-align: center; }
  .controls { display: grid; gap: var(--space-3); font-size: var(--step--1); }
  .surface { border: 0; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-4); }
  .surface legend { font-weight: 700; color: var(--text-muted); margin-bottom: var(--space-1); width: 100%; }
  .surface label { display: flex; align-items: center; gap: var(--space-2); min-height: 1.75rem; }
  .slider { display: grid; gap: var(--space-1); font-weight: 600; }
  output { font-weight: 800; color: var(--accent-strong); }
  .hint { margin: 0; color: var(--text-muted); }
  .btns { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .results { display: grid; gap: var(--space-3); margin-top: var(--space-4); }
  @container (min-width: 44rem) { .results { grid-template-columns: minmax(0, 1fr) minmax(15rem, 1fr); align-items: start; } }
  .rchart { width: 100%; max-width: 30rem; height: auto; font-family: var(--font-sans); }
  .rkey { margin: 0 0 var(--space-2); color: var(--text-muted); }
  .rchart :global(.r-grid line) { stroke: var(--border); }
  .rchart :global(.r-grid text) { font-size: 13px; fill: var(--text-muted); }
  .rchart :global(.r-axis) { font-size: 13px; font-weight: 650; fill: var(--text); }
  .rchart :global(.r-note) { font-size: 12px; font-style: italic; fill: var(--text-muted); }
  .rchart :global(.r-true) { stroke: var(--text-muted); stroke-width: 1.4; stroke-dasharray: 6 4; }
  .rchart :global(.r-run) { fill: none; stroke: var(--bio-head); stroke-width: 3; }
  .rchart :global(.r-dot) { fill: var(--bio-carb); stroke: var(--surface); stroke-width: 1.5; }
  .calc { font-size: var(--step--1); }
  .counts { margin: 0 0 var(--space-2); font-weight: 600; }
  .working { margin: 0; padding-left: 1.3rem; font-variant-numeric: tabular-nums; }
  .readout { margin: var(--space-3) 0 0; padding: var(--space-3); background: var(--surface-2); border-radius: var(--radius-m); font-size: var(--step--1); }
  .model-note { font-size: 0.8rem; color: var(--text-muted); margin: var(--space-2) 0 0; }
</style>
