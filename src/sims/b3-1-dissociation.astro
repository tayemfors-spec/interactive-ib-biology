---
import { linePath, range, sx, sy, type Frame } from './chart';
import { LUNG_PO2, STANDARD_PCO2, p50, percent, phFromPco2, saturation, unloading } from './models/b3-1-dissociation';

const frame: Frame = {
  w: 640, h: 400, left: 62, right: 18, top: 18, bottom: 56,
  x: { min: 0, max: 14, ticks: range(0, 14, 2), label: 'Partial pressure of oxygen, pO₂ (kPa)' },
  y: { min: 0, max: 100, ticks: range(0, 100, 20), label: 'Saturation of haemoglobin (%)' },
};
const d = { po2: 4, pco2: 7 };
const pct = (fn: (x: number) => number) => (x: number) => 100 * fn(x);
const paths = {
  adult: linePath(frame, pct((x) => saturation(x, 'adult', STANDARD_PCO2)), 140),
  shifted: linePath(frame, pct((x) => saturation(x, 'adult', d.pco2)), 140),
  foetal: linePath(frame, pct((x) => saturation(x, 'foetal', STANDARD_PCO2)), 140),
  myo: linePath(frame, pct((x) => saturation(x, 'myoglobin')), 140),
};
const u = unloading(d.po2, d.pco2);
const table = range(0, 14, 1).map((x) => ({
  x,
  a: percent(saturation(x, 'adult')),
  s: percent(saturation(x, 'adult', d.pco2)),
  f: percent(saturation(x, 'foetal')),
  m: percent(saturation(x, 'myoglobin')),
}));
const lungX = sx(frame, LUNG_PO2), lungY = sy(frame, 100 * u.lungs);
const tisX = sx(frame, d.po2), tisY = sy(frame, 100 * u.tissue);
---
<div class="sim-odc" data-sim-odc data-frame={JSON.stringify(frame)}>
  <div class="layout">
    <svg class="chart" viewBox={`0 0 ${frame.w} ${frame.h}`} role="img" aria-labelledby="odc-t odc-d" data-chart>
      <title id="odc-t">Oxygen dissociation curves</title>
      <desc id="odc-d">Percentage saturation of haemoglobin against partial pressure of oxygen. The adult curve is S-shaped. A dashed curve for the tissue's carbon dioxide level lies to the right of it when carbon dioxide is higher. Markers show the saturation in the lungs and in the respiring tissue.</desc>
      <g class="grid">
        {frame.x.ticks.map((t) => <line x1={sx(frame, t)} x2={sx(frame, t)} y1={frame.top} y2={frame.h - frame.bottom} />)}
        {frame.y.ticks.map((t) => <line x1={frame.left} x2={frame.w - frame.right} y1={sy(frame, t)} y2={sy(frame, t)} />)}
      </g>
      <line class="half" x1={frame.left} x2={frame.w - frame.right} y1={sy(frame, 50)} y2={sy(frame, 50)} />
      <text class="note" x={frame.w - frame.right - 4} y={sy(frame, 50) - 6} text-anchor="end">50 % saturation (P50)</text>
      <g class="ticks">
        {frame.x.ticks.map((t) => <text x={sx(frame, t)} y={frame.h - frame.bottom + 20} text-anchor="middle">{t}</text>)}
        {frame.y.ticks.map((t) => <text x={frame.left - 8} y={sy(frame, t)} dy="0.35em" text-anchor="end">{t}</text>)}
      </g>
      <text class="axis" x={(frame.left + frame.w - frame.right) / 2} y={frame.h - 12} text-anchor="middle">{frame.x.label} →</text>
      <text class="axis" transform={`translate(18 ${(frame.top + frame.h - frame.bottom) / 2}) rotate(-90)`} text-anchor="middle">{frame.y.label} →</text>
      <rect class="band" data-band x={sx(frame, 2)} y={frame.top} width={sx(frame, 6) - sx(frame, 2)} height={frame.h - frame.top - frame.bottom} />
      <text class="note" x={sx(frame, 4)} y={frame.h - frame.bottom - 8} text-anchor="middle">respiring tissues</text>
      <path class="line myo" d={paths.myo} data-line="myo" style="display:none" />
      <path class="line foetal" d={paths.foetal} data-line="foetal" style="display:none" />
      <path class="line adult" d={paths.adult} data-line="adult" />
      <path class="line shifted" d={paths.shifted} data-line="shifted" />
      <line class="drop" data-drop x1={tisX} x2={tisX} y1={tisY} y2={frame.h - frame.bottom} />
      <path class="release" data-release d={`M${tisX - 14} ${lungY} H${lungX} M${tisX - 14} ${lungY} V${tisY}`} />
      <text class="rel-t" data-rel-t x={tisX - 20} y={(lungY + tisY) / 2} text-anchor="end">O₂ released</text>
      <circle class="pt lung" cx={lungX} cy={lungY} r="7" data-pt="lung" />
      <circle class="pt tissue" cx={tisX} cy={tisY} r="7" data-pt="tissue" />
      <text class="pt-t" x={lungX - 10} y={lungY + 22} text-anchor="end">lungs</text>
      <text class="pt-t" data-tissue-t x={tisX + 12} y={tisY + 5}>tissue</text>
    </svg>
    <div class="controls">
      <label class="slider">pO₂ in the respiring tissue: <output data-out="po2">{d.po2.toFixed(1)} kPa</output>
        <input type="range" min="1" max="13" step="0.1" value={d.po2} data-param="po2" />
      </label>
      <label class="slider">pCO₂ in the respiring tissue: <output data-out="pco2">{d.pco2.toFixed(1)} kPa (pH {phFromPco2(d.pco2).toFixed(2)})</output>
        <input type="range" min="4" max="9" step="0.1" value={d.pco2} data-param="pco2" />
      </label>
      <div class="presets" role="group" aria-label="Example tissues">
        <button class="btn" type="button" data-preset="5.3,6.1">Resting tissue</button>
        <button class="btn" type="button" data-preset="2.5,8.5">Exercising muscle</button>
      </div>
      <fieldset class="legend">
        <legend>Curves</legend>
        <p class="key-row"><span class="key adult"></span> Adult haemoglobin, pCO₂ 5.3 kPa (lungs)</p>
        <p class="key-row"><span class="key shifted"></span> Adult haemoglobin at the tissue pCO₂</p>
        <label><input type="checkbox" data-show="foetal" /> <span class="key foetal"></span> Foetal haemoglobin</label>
        <label><input type="checkbox" data-show="myo" /> <span class="key myo"></span> Myoglobin (muscle)</label>
      </fieldset>
    </div>
  </div>
  <p class="readout" aria-live="polite" data-readout>
    In the lungs (pO₂ 13.3 kPa) haemoglobin is {percent(u.lungs)} % saturated. In the tissue (pO₂ {d.po2.toFixed(1)} kPa, pCO₂ {d.pco2.toFixed(1)} kPa) it is {percent(u.tissue)} % saturated, so {percent(u.released)} percentage points of saturation are released. P50 at this pCO₂ = {p50('adult', d.pco2).toFixed(1)} kPa (normal 3.5 kPa).
  </p>
  <details class="table">
    <summary>Show data table</summary>
    <div class="scroll"><table>
      <thead><tr><th scope="col">pO₂ (kPa)</th><th scope="col">Adult, pCO₂ 5.3 (%)</th><th scope="col" data-th-shift>Adult, pCO₂ {d.pco2.toFixed(1)} (%)</th><th scope="col">Foetal (%)</th><th scope="col">Myoglobin (%)</th></tr></thead>
      <tbody data-tbody>{table.map((r) => <tr><th scope="row">{r.x}</th><td>{r.a}</td><td>{r.s}</td><td>{r.f}</td><td>{r.m}</td></tr>)}</tbody>
    </table></div>
  </details>
  <p class="model-note">Simplified model: Hill equation with n = 2.7 for haemoglobin (n = 1 for myoglobin), P50 = 3.5 kPa for adult and 2.5 kPa for foetal haemoglobin at pH 7.4 and 37 °C. Carbon dioxide's effect (through pH and carbaminohaemoglobin) is modelled as one Bohr shift. 1 kPa ≈ 7.5 mmHg.</p>
</div>

<script>
  import { linePath, range, sx, sy, type Frame } from './chart';
  import { LUNG_PO2, STANDARD_PCO2, p50, percent, phFromPco2, saturation, unloading } from './models/b3-1-dissociation';

  document.querySelectorAll<HTMLElement>('[data-sim-odc]').forEach((root) => {
    const frame = JSON.parse(root.dataset.frame!) as Frame;
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const input = (k: string) => $<HTMLInputElement>(`[data-param="${k}"]`);
    const out = (k: string, v: string) => ($(`[data-out="${k}"]`).textContent = v);
    const line = (k: string) => $<SVGPathElement>(`[data-line="${k}"]`);
    const readout = $<HTMLElement>('[data-readout]');
    let timer = 0;

    const update = () => {
      const po2 = Number(input('po2').value), pco2 = Number(input('pco2').value);
      const pH = phFromPco2(pco2);
      out('po2', `${po2.toFixed(1)} kPa`);
      out('pco2', `${pco2.toFixed(1)} kPa (pH ${pH.toFixed(2)})`);
      line('shifted').setAttribute('d', linePath(frame, (x) => 100 * saturation(x, 'adult', pco2), 140));
      const u = unloading(po2, pco2);
      const lx = sx(frame, LUNG_PO2), ly = sy(frame, 100 * u.lungs);
      const tx = sx(frame, po2), ty = sy(frame, 100 * u.tissue);
      const tissue = $<SVGCircleElement>('[data-pt="tissue"]');
      tissue.setAttribute('cx', tx.toFixed(1)); tissue.setAttribute('cy', ty.toFixed(1));
      const drop = $<SVGLineElement>('[data-drop]');
      drop.setAttribute('x1', tx.toFixed(1)); drop.setAttribute('x2', tx.toFixed(1)); drop.setAttribute('y1', ty.toFixed(1));
      $<SVGPathElement>('[data-release]').setAttribute('d', `M${(tx - 14).toFixed(1)} ${ly.toFixed(1)} H${lx.toFixed(1)} M${(tx - 14).toFixed(1)} ${ly.toFixed(1)} V${ty.toFixed(1)}`);
      const rt = $<SVGTextElement>('[data-rel-t]');
      rt.setAttribute('x', (tx - 20).toFixed(1)); rt.setAttribute('y', ((ly + ty) / 2).toFixed(1));
      const tt = $<SVGTextElement>('[data-tissue-t]');
      tt.setAttribute('x', (tx + 12).toFixed(1)); tt.setAttribute('y', (ty + 5).toFixed(1));
      $('[data-th-shift]').textContent = `Adult, pCO₂ ${pco2.toFixed(1)} (%)`;
      $('[data-tbody]').innerHTML = range(0, 14, 1)
        .map((x) => `<tr><th scope="row">${x}</th><td>${percent(saturation(x, 'adult'))}</td><td>${percent(saturation(x, 'adult', pco2))}</td><td>${percent(saturation(x, 'foetal'))}</td><td>${percent(saturation(x, 'myoglobin'))}</td></tr>`)
        .join('');
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        const share = u.lungs > 0 ? Math.round((100 * u.released) / u.lungs) : 0;
        const k = p50('adult', pco2);
        let extra = '';
        if (pco2 > STANDARD_PCO2 + 0.2) extra = ` The extra CO₂ lowers the affinity of haemoglobin for oxygen (Bohr shift): the curve moves right, so ${percent(u.released - (u.lungs - saturation(po2, 'adult', STANDARD_PCO2)))} more percentage points are released than at pCO₂ 5.3 kPa.`;
        else if (pco2 < STANDARD_PCO2 - 0.2) extra = ' With less CO₂ than normal the curve moves left and less oxygen is released.';
        if ($<HTMLInputElement>('[data-show="foetal"]').checked) extra += ` At this pO₂, foetal haemoglobin would be ${percent(saturation(po2, 'foetal'))} % saturated, higher than adult haemoglobin (${percent(saturation(po2, 'adult'))} % at pCO₂ 5.3 kPa).`;
        readout.textContent = `In the lungs (pO₂ 13.3 kPa) haemoglobin is ${percent(u.lungs)} % saturated. In the tissue (pO₂ ${po2.toFixed(1)} kPa, pCO₂ ${pco2.toFixed(1)} kPa) it is ${percent(u.tissue)} % saturated, so ${percent(u.released)} percentage points of saturation (about ${share} % of the oxygen carried) are released. P50 at this pCO₂ = ${k.toFixed(1)} kPa (normal 3.5 kPa).${extra}`;
      }, 350);
    };
    root.querySelectorAll('[data-param]').forEach((el) => el.addEventListener('input', update));
    root.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach((b) => b.addEventListener('click', () => {
      const [po2, pco2] = b.dataset.preset!.split(',');
      input('po2').value = po2!; input('pco2').value = pco2!;
      update();
    }));
    root.querySelectorAll<HTMLInputElement>('[data-show]').forEach((cb) => cb.addEventListener('change', () => {
      line(cb.dataset.show!).style.display = cb.checked ? '' : 'none';
      update();
    }));
  });
</script>

<style>
  .sim-odc { container-type: inline-size; }
  .layout { display: grid; gap: var(--space-4); }
  @container (min-width: 46rem) { .layout { grid-template-columns: minmax(0, 1.6fr) minmax(15rem, 1fr); align-items: start; } }
  .chart { width: 100%; height: auto; font-family: var(--font-sans); }
  .grid line { stroke: var(--border); stroke-width: 1; }
  .half { stroke: var(--text-muted); stroke-width: 1.2; stroke-dasharray: 2 4; }
  .band { fill: color-mix(in srgb, var(--bio-head) 12%, transparent); }
  .ticks text { font-size: 15px; fill: var(--text-muted); }
  .axis { font-size: 16px; font-weight: 650; fill: var(--text); }
  .note { font-size: 14px; fill: var(--text-muted); font-style: italic; }
  .line { fill: none; stroke-width: 3.5; stroke-linecap: round; stroke-linejoin: round; }
  .adult { stroke: var(--bio-k); }
  .shifted { stroke: var(--bio-head); stroke-dasharray: 12 7; }
  .foetal { stroke: var(--bio-na); stroke-dasharray: 2 7; }
  .myo { stroke: var(--bio-protein); stroke-dasharray: 14 5 3 5; }
  .drop { stroke: var(--text-muted); stroke-width: 1.2; stroke-dasharray: 3 3; }
  .release { fill: none; stroke: var(--text); stroke-width: 2; }
  .pt { stroke: var(--surface); stroke-width: 2.5; }
  .pt.lung { fill: var(--bio-k); }
  .pt.tissue { fill: var(--bio-head); }
  .rel-t { font-size: 14px; font-weight: 700; fill: var(--text); paint-order: stroke; stroke: var(--surface); stroke-width: 4px; }
  .pt-t { font-size: 15px; font-weight: 700; fill: var(--text); }
  .controls { display: grid; gap: var(--space-3); font-size: var(--step--1); }
  .slider { display: grid; gap: var(--space-1); font-weight: 600; }
  output { font-weight: 800; color: var(--accent-strong); }
  .presets { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .legend { border: 0; padding: 0; margin: 0; display: grid; gap: var(--space-1); }
  .legend legend { font-weight: 700; color: var(--text-muted); margin-bottom: var(--space-1); }
  .legend label, .key-row { display: flex; align-items: center; gap: var(--space-2); margin: 0; min-height: 1.75rem; }
  .key { display: inline-block; flex: none; width: 2rem; height: 0; border-top: 3.5px solid; }
  .key.adult { border-color: var(--bio-k); }
  .key.shifted { border-color: var(--bio-head); border-top-style: dashed; }
  .key.foetal { border-color: var(--bio-na); border-top-style: dotted; }
  .key.myo { border-color: var(--bio-protein); border-top-style: dashed; }
  .readout { margin: var(--space-3) 0 0; padding: var(--space-3); background: var(--surface-2); border-radius: var(--radius-m); font-size: var(--step--1); }
  .table { margin-top: var(--space-2); font-size: var(--step--1); }
  .table summary { cursor: pointer; font-weight: 650; color: var(--accent-strong); }
  .scroll { overflow-x: auto; }
  table { border-collapse: collapse; margin-top: var(--space-2); font-variant-numeric: tabular-nums; }
  th, td { padding: 0.2rem 0.6rem; border-bottom: 1px solid var(--border); text-align: right; }
  .model-note { font-size: 0.8rem; color: var(--text-muted); margin: var(--space-2) 0 0; }
</style>
