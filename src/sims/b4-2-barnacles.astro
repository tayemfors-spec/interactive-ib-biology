---
/**
 * B4.2.12 fundamental vs realized niche: Connell's barnacles on a rocky shore. Choose a scenario to see
 * where each species lives and how its realized niche compares with its fundamental niche.
 * Zone data in models/b4-2-barnacles.ts.
 */
import { fundamental, realized, scenarioLabel, scenarioText, type Barnacle, type Scenario } from './models/b4-2-barnacles';

const Y = (h: number) => 330 - h * 280;
const scenarios: Scenario[] = ['both', 'no-semibalanus', 'no-chthamalus'];
const init = realized('both');
// deterministic scatter of barnacles across each species' fundamental niche
let seed = 7;
const rand = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const scatter = (sp: Barnacle, n: number) =>
  Array.from({ length: n }, () => {
    const h = fundamental[sp].from + rand() * (fundamental[sp].to - fundamental[sp].from);
    return { sp, h, x: 128 + rand() * 196, y: Y(h) };
  });
const pts = [...scatter('semibalanus', 46), ...scatter('chthamalus', 52)];
const shown = (sp: Barnacle, h: number) => { const b = init[sp]; return !!b && h >= b.from && h <= b.to; };
const bars: { sp: Barnacle; x: number; name: string }[] = [
  { sp: 'chthamalus', x: 404, name: 'Chthamalus' },
  { sp: 'semibalanus', x: 520, name: 'Semibalanus' },
];
---
<div class="sim-barn" data-sim-barn>
  <div class="chips" role="group" aria-label="Scenario">
    {scenarios.map((s, i) => <button type="button" class="btn chip" data-scenario={s} aria-pressed={i === 0 ? 'true' : 'false'}>{scenarioLabel[s]}</button>)}
  </div>
  <svg viewBox="0 0 640 384" role="img" aria-labelledby="bn-t bn-d" class="art">
    <title id="bn-t">Barnacles on a rocky shore: where each species lives, and its fundamental and realized niches</title>
    <desc id="bn-d">A rocky shore from the high-tide mark down to the low-tide mark. Bars on the right compare the fundamental niche (dashed outline) and the realized niche (filled) of Chthamalus and Semibalanus.</desc>
    <rect class="sky" x="112" y="22" width="228" height={Y(1) - 22} />
    <rect class="rock" x="112" y={Y(1)} width="228" height={Y(0) - Y(1)} />
    <rect class="sea" x="112" y={Y(0)} width="228" height={372 - Y(0)} />
    <line class="tide" x1="104" x2="350" y1={Y(1)} y2={Y(1)} />
    <line class="tide" x1="104" x2="350" y1={Y(0)} y2={Y(0)} />
    <text class="lab" x="118" y={Y(1) - 6}>High-tide mark</text>
    <text class="lab" x="118" y={Y(0) + 18}>Low-tide mark (sea)</text>
    <line class="edge" x1="104" x2="340" y1={Y(0.62)} y2={Y(0.62)} />
    <text class="zone" x="100" y={Y(0.8) - 8} text-anchor="end">upper</text>
    <text class="zone" x="100" y={Y(0.8) + 8} text-anchor="end">shore</text>
    <text class="zone" x="100" y={Y(0.4) - 8} text-anchor="end">middle and</text>
    <text class="zone" x="100" y={Y(0.4) + 8} text-anchor="end">lower shore</text>
    <g class="pts">
      {pts.map((p) => (
        <g class={`b ${p.sp}`} data-sp={p.sp} data-h={p.h.toFixed(3)} transform={`translate(${p.x.toFixed(1)} ${p.y.toFixed(1)})`} style={shown(p.sp, p.h) ? '' : 'opacity:0'}>
          {p.sp === 'semibalanus' ? <><circle r="7" /><circle class="in" r="2.6" /></> : <><circle r="4.4" /><circle class="in" r="1.6" /></>}
        </g>
      ))}
    </g>
    <line class="axis" x1="384" x2="384" y1={Y(1)} y2={Y(0)} />
    <text class="lab" x="378" y={Y(1) + 4} text-anchor="end">high</text>
    <text class="lab" x="378" y={Y(0) + 4} text-anchor="end">low</text>
    {bars.map((b) => (
      <g>
        <text class="bn" x={b.x + 44} y="18" text-anchor="middle">{b.name}</text>
        <text class="bs" x={b.x + 18} y={Y(1) - 8} text-anchor="middle">fund.</text>
        <text class="bs" x={b.x + 70} y={Y(1) - 8} text-anchor="middle">realized</text>
        <rect class={`fund ${b.sp}`} x={b.x} y={Y(fundamental[b.sp].to)} width="36" height={Y(fundamental[b.sp].from) - Y(fundamental[b.sp].to)} rx="4" />
        <rect class={`real ${b.sp}`} data-real={b.sp} x={b.x + 52} y={Y(init[b.sp]!.to)} width="36" height={Y(init[b.sp]!.from) - Y(init[b.sp]!.to)} rx="4" />
        <text class="gone" data-gone={b.sp} x={b.x + 70} y={Y(0.5)} text-anchor="middle" style="display:none">removed</text>
      </g>
    ))}
    <g class="key" transform="translate(410 350)">
      <circle class="b chthamalus" cx="0" cy="0" r="4.4" /><text class="lab" x="12" y="4">Chthamalus (smaller)</text>
      <circle class="b semibalanus" cx="0" cy="22" r="7" /><text class="lab" x="12" y="26">Semibalanus</text>
    </g>
  </svg>
  <p class="readout" aria-live="polite" data-readout>{scenarioText.both}</p>
  <p class="model-note">Schematic, based on Connell's experiments on the Isle of Cumbrae, Scotland (published 1961). Zone limits are simplified; Semibalanus balanoides was then called Balanus balanoides.</p>
</div>

<script>
  import { realized, scenarioText, type Barnacle, type Scenario } from './models/b4-2-barnacles';

  const Y = (h: number) => 330 - h * 280;
  document.querySelectorAll<HTMLElement>('[data-sim-barn]').forEach((root) => {
    const btns = [...root.querySelectorAll<HTMLButtonElement>('[data-scenario]')];
    const readout = root.querySelector<HTMLElement>('[data-readout]')!;
    const pts = [...root.querySelectorAll<SVGGElement>('[data-sp]')];
    let timer = 0;
    const show = (s: Scenario) => {
      const r = realized(s);
      btns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.scenario === s)));
      pts.forEach((g) => {
        const band = r[g.dataset.sp as Barnacle];
        const h = Number(g.dataset.h);
        g.style.opacity = band && h >= band.from && h <= band.to ? '1' : '0';
      });
      (['chthamalus', 'semibalanus'] as Barnacle[]).forEach((sp) => {
        const rect = root.querySelector<SVGRectElement>(`[data-real="${sp}"]`)!;
        const gone = root.querySelector<SVGTextElement>(`[data-gone="${sp}"]`)!;
        const band = r[sp];
        rect.style.display = band ? '' : 'none';
        gone.style.display = band ? 'none' : '';
        if (band) { rect.setAttribute('y', String(Y(band.to))); rect.setAttribute('height', String(Y(band.from) - Y(band.to))); }
      });
      clearTimeout(timer);
      timer = window.setTimeout(() => { readout.textContent = scenarioText[s]; }, 200);
    };
    btns.forEach((b) => b.addEventListener('click', () => show(b.dataset.scenario as Scenario)));
  });
</script>

<style>
  .sim-barn { container-type: inline-size; }
  .chips { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-bottom: var(--space-3); }
  .chip { min-height: 2.25rem; font-size: var(--step--1); padding-inline: 0.7rem; }
  .art { width: 100%; height: auto; display: block; font-family: var(--font-sans); }
  .sky { fill: var(--surface-2); }
  .rock { fill: color-mix(in srgb, var(--text-muted) 22%, var(--surface)); }
  .sea { fill: color-mix(in srgb, var(--bio-water) 30%, var(--surface)); }
  .tide { stroke: var(--bio-water); stroke-width: 2; stroke-dasharray: 6 4; }
  .edge { stroke: var(--text-muted); stroke-width: 1; stroke-dasharray: 2 4; }
  .lab { font-size: 13px; fill: var(--text); }
  .zone { font-size: 13px; font-style: italic; font-weight: 650; fill: var(--text); }
  .b circle { stroke: var(--text); stroke-width: 1; }
  .b.chthamalus circle, circle.b.chthamalus { fill: var(--bio-tail); }
  .b.semibalanus circle, circle.b.semibalanus { fill: color-mix(in srgb, var(--bio-protein) 55%, var(--surface)); }
  circle.b { stroke: var(--text); stroke-width: 1; }
  .b .in { fill: var(--text) !important; stroke: none; }
  .b { transition: opacity 0.35s; }
  @media (prefers-reduced-motion: reduce) { .b { transition: none; } }
  :global([data-motion='reduce']) .b { transition: none; }
  .axis { stroke: var(--text-muted); stroke-width: 1.5; }
  .bn { font-size: 15px; font-weight: 750; font-style: italic; fill: var(--text); }
  .bs { font-size: 12px; fill: var(--text-muted); }
  .fund { fill: none; stroke-width: 2.5; stroke-dasharray: 6 4; }
  .fund.chthamalus { stroke: color-mix(in srgb, var(--bio-tail) 70%, var(--text)); }
  .fund.semibalanus { stroke: var(--bio-protein); }
  .real.chthamalus { fill: var(--bio-tail); stroke: var(--text); stroke-width: 1; }
  .real.semibalanus { fill: color-mix(in srgb, var(--bio-protein) 55%, var(--surface)); stroke: var(--text); stroke-width: 1; }
  .gone { font-size: 13px; font-weight: 700; fill: var(--bad); }
  .readout { margin: var(--space-3) 0 0; padding: var(--space-3); background: var(--surface-2); border-radius: var(--radius-m); font-size: var(--step--1); }
  .model-note { font-size: 0.8rem; color: var(--text-muted); margin: var(--space-2) 0 0; }
</style>
