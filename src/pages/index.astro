---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_NAME, SITE_TAGLINE } from '../lib/site';
import { idOf, themeSlug, topics, topicsByThemeAndLevel } from '../lib/syllabus';
import { withBase } from '../lib/url';

const published = new Set((await getCollection('topics')).map((t) => t.id));
const groups = topicsByThemeAndLevel();
const first = topics.find((t) => published.has(idOf(t.code)));
const site = Astro.site!;
const jsonLd = [
  {
    '@type': 'WebSite',
    name: SITE_NAME,
    alternateName: 'Interactive IB Biology revision',
    url: new URL(withBase('/'), site).href,
    inLanguage: 'en-GB',
    description: SITE_TAGLINE,
  },
];
---
<BaseLayout title={SITE_NAME} description="Free interactive IB Biology revision: 3D models, animations, simulations, quizzes and flashcards for every topic in the 2025 syllabus (SL and HL)." jsonLd={jsonLd}>
  <div class="home">
    <section class="hero">
      <p class="eyebrow">IB Diploma Biology · first assessment 2025 · SL &amp; HL</p>
      <h1>See the biology, then test yourself</h1>
      <p class="lead">Rotate a 3D membrane, step through the sodium–potassium pump, drag sliders to see what really changes a rate. Every topic has clear explanations with SL and AHL content marked, common exam mistakes, and a self-test that remembers your progress.</p>
      <div class="cta">
        {first && <a class="btn btn-primary" href={withBase(first.slug)}>Start with {first.code} {first.title}</a>}
        <button class="btn" type="button" data-search-open>Search the syllabus</button>
      </div>
      <p class="continue" data-continue hidden data-slugs={JSON.stringify(Object.fromEntries(topics.filter((t) => published.has(idOf(t.code))).map((t) => [t.code, [withBase(t.slug), t.title]])))}></p>
    </section>

    <section aria-labelledby="how-h" class="how">
      <h2 id="how-h" class="visually-hidden">What's on each topic page</h2>
      <ul class="features">
        <li><strong>Interactive visuals</strong> 3D models you can rotate and label, step-by-step animations and simulations with live graphs, plus exam-style diagrams.</li>
        <li><strong>SL vs AHL clearly marked</strong> Higher Level content sits in AHL sections marked with a solid bar; SL students can hide it in Display settings.</li>
        <li><strong>Self-test</strong> Multiple-choice questions with an explanation for every option, and flashcards. Progress is saved in your browser only.</li>
      </ul>
    </section>

    <section aria-labelledby="syl-h">
      <h2 id="syl-h">The syllabus</h2>
      <p class="muted">The course is organised into four themes, each studied at four levels of biological organisation. <span data-progress-summary></span></p>
      <div class="themes">
        {groups.map(({ theme, levels }) => (
          <article class="theme">
            <h3><a href={withBase(`themes/${themeSlug(theme.id)}`)}><span class="tl">{theme.id}</span> {theme.title}</a></h3>
            {levels.filter((l) => l.topics.length).map((l) => (
              <div class="lvl">
                <p class="lvl-name">{l.level}</p>
                <ul>
                  {l.topics.map((t) => (
                    <li data-level-block={t.status === 'AHL' ? 'AHL' : undefined}>
                      {published.has(idOf(t.code))
                        ? <a href={withBase(t.slug)} data-topic={t.code}><span class="c">{t.code}</span> {t.title}</a>
                        : <span class="planned"><span class="c">{t.code}</span> {t.title} <span class="soon">coming soon</span></span>}
                      {t.status === 'AHL' && <span class="ahl">AHL</span>}
                      <span class="score" data-score-for={t.code}></span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </article>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import { getProgress } from '../lib/progress';

  const p = getProgress();
  let done = 0;
  for (const [code, t] of Object.entries(p.topics)) {
    const q = t.quiz;
    const el = document.querySelector<HTMLElement>(`[data-score-for="${code}"]`);
    if (q && el) { el.textContent = `${q.best}/${q.total}`; if (q.best / q.total >= 0.8) done++; }
  }
  const summary = document.querySelector<HTMLElement>('[data-progress-summary]');
  if (summary && done) summary.textContent = `You've scored 80% or more on ${done} topic quiz${done === 1 ? '' : 'zes'}.`;
  const cont = document.querySelector<HTMLElement>('[data-continue]');
  const slugs = JSON.parse(cont?.dataset.slugs ?? '{}') as Record<string, [string, string]>;
  const last = p.lastTopic ? slugs[p.lastTopic] : undefined;
  if (last && cont) {
    cont.innerHTML = '';
    const a = document.createElement('a');
    a.href = last[0];
    a.textContent = `Continue where you left off: ${p.lastTopic} ${last[1]}`;
    cont.append(a);
    cont.hidden = false;
  }
</script>

<style>
  .home { max-width: 70rem; margin: 0 auto; }
  .hero { padding: var(--space-5) 0 var(--space-4); max-width: 46rem; }
  .eyebrow { font-size: var(--step--1); font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: var(--space-2); }
  .hero h1 { font-size: clamp(2rem, 1.5rem + 2.4vw, 3rem); }
  .lead { font-size: var(--step-1); color: var(--text-muted); }
  .cta { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-4); }
  .continue { margin-top: var(--space-3); font-weight: 650; }
  .features { list-style: none; padding: 0; display: grid; gap: var(--space-3); grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); margin: var(--space-5) 0; }
  .features li { margin: 0; padding: var(--space-4); border: 1px solid var(--border); border-radius: var(--radius-l); background: var(--surface); font-size: var(--step--1); color: var(--text-muted); }
  .features strong { display: block; font-size: var(--step-0); margin-bottom: var(--space-1); color: var(--text); }
  .muted { color: var(--text-muted); }
  .themes { display: grid; gap: var(--space-4); grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); }
  .theme { padding: var(--space-4); border: 1px solid var(--border); border-radius: var(--radius-l); background: var(--surface); }
  .theme h3 { margin: 0 0 var(--space-3); font-size: var(--step-1); }
  .theme h3 a { color: var(--text); text-decoration: none; display: flex; gap: var(--space-2); align-items: center; }
  .tl { display: inline-grid; place-items: center; width: 1.8rem; height: 1.8rem; border-radius: 8px; background: var(--ink); color: var(--on-ink); font-size: 0.95rem; flex: none; }
  .lvl-name { font-size: 0.72rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted); margin: var(--space-3) 0 var(--space-1); }
  .lvl ul { list-style: none; padding: 0; margin: 0; font-size: var(--step--1); }
  .lvl li { display: flex; gap: var(--space-2); align-items: baseline; margin: 0.15rem 0; }
  .c { font-weight: 700; color: var(--text-muted); font-variant-numeric: tabular-nums; margin-right: 0.15rem; }
  .planned { color: var(--text-muted); }
  .soon { font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.04em; border: 1px dashed var(--border-strong); border-radius: 999px; padding: 0 0.4em; margin-left: 0.2rem; }
  .ahl { font-size: 0.6rem; font-weight: 800; color: var(--text-muted); border: 1px solid currentColor; border-radius: 3px; padding: 0 0.25em; }
  .score { margin-left: auto; font-weight: 700; color: var(--text); font-variant-numeric: tabular-nums; }
</style>
