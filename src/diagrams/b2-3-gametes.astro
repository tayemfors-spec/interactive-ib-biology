---
/**
 * Human sperm and egg (B2.3.10). Exam-style drawings, NOT to the same scale: the egg is about 110 µm across,
 * the sperm head about 3 µm wide. The tail is shortened (break marks).
 */
import { rng } from '../viewer3d/kit';

// ---- sperm ----
const mitoL = Array.from({ length: 9 }, (_, i) => 116 + i * 10.5);
// ---- egg ----
const E = { cx: 156, cy: 192, mem: 82, zIn: 96, zOut: 110 };
const polar = { a: -0.95, r: 89 };
const rand = rng(31);
const follicles: { x: number; y: number; r: number }[] = [];
for (const [rad, n, size] of [[118, 30, 8.5], [134, 36, 8]] as const) {
  for (let k = 0; k < n; k++) {
    const a = (k / n) * Math.PI * 2 + (rad === 134 ? 0.08 : 0);
    follicles.push({ x: E.cx + rad * Math.cos(a), y: E.cy + rad * Math.sin(a), r: size });
  }
}
const cortical = Array.from({ length: 40 }, (_, k) => {
  const a = (k / 40) * Math.PI * 2;
  return { x: E.cx + (E.mem - 6) * Math.cos(a), y: E.cy + (E.mem - 6) * Math.sin(a) };
});
const yolk: [number, number][] = [];
for (let i = 0; yolk.length < 70 && i < 3000; i++) {
  const a = rand() * Math.PI * 2, r = Math.sqrt(rand()) * (E.mem - 16);
  const x = E.cx + r * Math.cos(a), y = E.cy + r * Math.sin(a);
  if (Math.hypot(x - E.cx, y - (E.cy - 34)) < 26) continue; // keep clear of the spindle
  if (y > E.cy + 40 && y < E.cy + 58) continue; // keep clear of the dimension line
  if (yolk.some(([u, v]) => Math.hypot(u - x, v - y) < 9)) continue;
  yolk.push([x, y]);
}
const pb = { x: E.cx + polar.r * Math.cos(polar.a), y: E.cy + polar.r * Math.sin(polar.a) };
const spindle = { x: E.cx, y: E.cy - 34 };
const chromos = [-12, -4, 4, 12];
---
<div class="gam">
  <div class="panel">
    <svg viewBox="0 0 460 210" role="img" aria-labelledby="ga-s-t ga-s-d">
      <title id="ga-s-t">Human sperm cell with its parts labelled</title>
      <desc id="ga-s-d">A sperm cell drawn from the side. The head contains a haploid nucleus, capped at the front by the acrosome. Behind the head is a centriole, then a mid-piece containing mitochondria wound in a helix around the core of the tail. The long tail (flagellum) contains microtubules in a 9 + 2 arrangement. The whole cell is enclosed by a plasma membrane.</desc>
      <!-- tail with a break -->
      <path class="cellm" d="M206 101 L320 104 L320 116 L206 119 Z" />
      <path class="cellm" d="M336 104.5 L440 107 L440 113 L336 115.5 Z" />
      <path class="brk" d="M316 98 L326 122 M330 98 L340 122" />
      <path class="axo" d="M112 108 H320 M112 112 H320 M336 108.5 H436 M336 111.5 H436" />
      <!-- mid-piece -->
      <rect class="cellm" x="110" y="96" width="98" height="28" rx="8" />
      {mitoL.map((x) => <><ellipse class="mito" cx={x} cy="102.5" rx="5.5" ry="4.5" /><ellipse class="mito" cx={x + 5} cy="117.5" rx="5.5" ry="4.5" /></>)}
      <path class="axo" d="M112 110 H208" />
      <!-- head -->
      <path class="cellm" d="M100 110 C100 84 80 76 60 76 C34 76 22 94 22 110 C22 126 34 144 60 144 C80 144 100 136 100 110 Z" />
      <path class="acro" d="M70 80 C46 76 28 90 28 110 C28 130 46 144 70 140 C52 134 40 124 40 110 C40 96 52 86 70 80 Z" />
      <ellipse class="nucleus" cx="66" cy="110" rx="27" ry="25" />
      <rect class="cent" x="102" y="104" width="5" height="12" rx="1" />
      <!-- labels -->
      <path class="lead" d="M36 94 L36 40" /><text class="t b" x="10" y="20">acrosome</text><text class="t" x="10" y="36">(enzymes digest zona)</text>
      <path class="lead" d="M74 100 L150 42" /><text class="t b" x="154" y="20">haploid nucleus</text><text class="t" x="154" y="36">(23 chromosomes)</text>
      <path class="lead" d="M150 98 L300 56" /><text class="t b" x="304" y="36">mid-piece: helical</text><text class="t" x="304" y="52">mitochondria (ATP)</text>
      <path class="lead" d="M380 106 L400 82" /><text class="t b" x="356" y="78">tail (flagellum)</text>
      <path class="lead" d="M104 116 L96 170" /><text class="t" x="70" y="186">centriole</text>
      <path class="lead" d="M260 112 L240 170" /><text class="t" x="180" y="186">microtubules, 9 + 2</text>
      <path class="lead" d="M60 144 L30 170" /><text class="t" x="4" y="202">plasma membrane</text>
      <text class="t muted" x="440" y="202" text-anchor="end">head ≈ 5 µm long, 3 µm wide · whole cell ≈ 55 µm</text>
    </svg>
    <p class="cap"><strong>Sperm</strong> <span class="count">small · motile · haploid · millions made</span></p>
  </div>

  <div class="panel">
    <svg viewBox="0 0 520 390" role="img" aria-labelledby="ga-e-t ga-e-d">
      <title id="ga-e-t">Human egg (secondary oocyte) at ovulation with its parts labelled</title>
      <desc id="ga-e-d">A large round cell about 110 micrometres across. Its cytoplasm contains droplets of lipid and other nutrients, and near the surface a single layer of cortical granules just inside the plasma membrane. A haploid set of chromosomes is held on a spindle. Outside the plasma membrane is a small first polar body, then a thick glycoprotein layer, the zona pellucida, and outside that a layer of follicle cells, the corona radiata.</desc>
      {follicles.map((f) => <circle class="foll" cx={f.x.toFixed(1)} cy={f.y.toFixed(1)} r={f.r} />)}
      <circle class="zona" cx={E.cx} cy={E.cy} r={(E.zIn + E.zOut) / 2} stroke-width={E.zOut - E.zIn} />
      <circle class="pvs" cx={E.cx} cy={E.cy} r={E.zIn} />
      <circle class="pb" cx={pb.x.toFixed(1)} cy={pb.y.toFixed(1)} r="6.5" />
      <circle class="cyto" cx={E.cx} cy={E.cy} r={E.mem} />
      {yolk.map(([x, y]) => <circle class="yolk" cx={x.toFixed(1)} cy={y.toFixed(1)} r="2.6" />)}
      {cortical.map((c) => <circle class="cg" cx={c.x.toFixed(1)} cy={c.y.toFixed(1)} r="2.6" />)}
      <path class="spindle" d={`M${spindle.x - 18} ${spindle.y} Q${spindle.x} ${spindle.y - 22} ${spindle.x + 18} ${spindle.y} Q${spindle.x} ${spindle.y + 22} ${spindle.x - 18} ${spindle.y} M${spindle.x - 18} ${spindle.y} H${spindle.x + 18} M${spindle.x - 18} ${spindle.y} Q${spindle.x} ${spindle.y - 10} ${spindle.x + 18} ${spindle.y} M${spindle.x - 18} ${spindle.y} Q${spindle.x} ${spindle.y + 10} ${spindle.x + 18} ${spindle.y}`} />
      {chromos.map((dy) => <rect class="chr" x={spindle.x - 2.5} y={spindle.y + dy - 3} width="5" height="6" rx="1.5" />)}
      <path class="dim" d={`M${E.cx - E.mem} ${E.cy + 49} H${E.cx + E.mem} M${E.cx - E.mem} ${E.cy + 43} V${E.cy + 55} M${E.cx + E.mem} ${E.cy + 43} V${E.cy + 55}`} />
      <text class="t b" x={E.cx} y={E.cy + 70} text-anchor="middle">≈ 110 µm</text>

      <path class="lead" d={`M${spindle.x + 10} ${spindle.y - 8} L316 52`} /><text class="t b" x="320" y="34">haploid chromosomes</text><text class="t" x="320" y="50">(n = 23, at metaphase II)</text>
      <path class="lead" d={`M${pb.x + 6} ${pb.y - 2} L316 96`} /><text class="t" x="320" y="100">first polar body</text>
      <path class="lead" d={`M${E.cx + 103} ${E.cy - 26} L316 142`} /><text class="t b" x="320" y="138">zona pellucida</text><text class="t" x="320" y="154">(glycoprotein layer)</text>
      <path class="lead" d={`M${E.cx + 136} ${E.cy + 12} L316 196`} /><text class="t b" x="320" y="192">corona radiata</text><text class="t" x="320" y="208">(follicle cells)</text>
      <path class="lead" d={`M${E.cx + 80} ${E.cy + 18} L316 246`} /><text class="t" x="320" y="250">plasma membrane</text>
      <path class="lead" d={`M${E.cx + 72} ${E.cy + 36} L316 290`} /><text class="t b" x="320" y="290">cortical granules</text><text class="t" x="320" y="306">(harden the zona)</text>
      <path class="lead" d={`M${E.cx + 30} ${E.cy + 20} L316 340`} /><text class="t b" x="320" y="340">cytoplasm with lipid</text><text class="t" x="320" y="356">droplets (food reserves)</text>
    </svg>
    <p class="cap"><strong>Egg (secondary oocyte)</strong> <span class="count">large · not motile · haploid · one a month</span></p>
  </div>
</div>

<style>
  .gam { display: grid; gap: var(--space-5); }
  .panel { display: grid; gap: var(--space-1); align-content: start; }
  .panel svg { font-family: var(--font-sans); }
  .panel:last-child svg { max-width: 40rem; }
  .cap { margin: 0; display: flex; flex-wrap: wrap; gap: var(--space-2); align-items: center; }
  .count { font-size: 0.78rem; font-weight: 800; padding: 0.05rem 0.5rem; border-radius: 999px; background: var(--accent-soft); color: var(--accent-strong); }
  .t { font-size: 13.5px; fill: var(--text); }
  .t.b { font-weight: 750; }
  .t.muted { fill: var(--text-muted); font-size: 12.5px; }
  .cellm { fill: color-mix(in srgb, var(--bio-tail) 30%, var(--surface)); stroke: var(--bio-head); stroke-width: 1.8; stroke-linejoin: round; }
  .acro { fill: color-mix(in srgb, var(--bio-protein) 40%, var(--surface)); stroke: var(--text); stroke-width: 1.2; }
  .nucleus { fill: color-mix(in srgb, var(--bio-na) 60%, var(--surface)); stroke: var(--text); stroke-width: 1.4; }
  .cent { fill: var(--text); }
  .mito { fill: color-mix(in srgb, var(--bio-chol) 40%, var(--surface)); stroke: var(--text); stroke-width: 1; }
  .axo { stroke: var(--text); stroke-width: 1.1; fill: none; }
  .brk { stroke: var(--text-muted); stroke-width: 1.6; }
  .foll { fill: color-mix(in srgb, var(--bio-glucose) 28%, var(--surface)); stroke: var(--text); stroke-width: 1; }
  .zona { fill: none; stroke: color-mix(in srgb, var(--bio-carb) 34%, var(--surface)); }
  .pvs { fill: var(--surface); stroke: var(--text); stroke-width: 1; }
  .pb { fill: color-mix(in srgb, var(--bio-tail) 45%, var(--surface)); stroke: var(--text); stroke-width: 1.2; }
  .cyto { fill: color-mix(in srgb, var(--bio-tail) 22%, var(--surface)); stroke: var(--bio-head); stroke-width: 2.2; }
  .yolk { fill: color-mix(in srgb, var(--bio-glucose) 55%, var(--surface)); }
  .cg { fill: color-mix(in srgb, var(--bio-protein-2) 65%, var(--surface)); }
  .spindle { fill: none; stroke: var(--text-muted); stroke-width: 1; }
  .chr { fill: color-mix(in srgb, var(--bio-na) 75%, var(--text)); }
  .dim { fill: none; stroke: var(--text); stroke-width: 1.3; }
  .lead { stroke: var(--text); stroke-width: 1.1; }
</style>
