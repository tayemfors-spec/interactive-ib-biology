---
/** D3.1.19: progesterone maintains pregnancy (corpus luteum, then placenta); oxytocin positive feedback in childbirth. Qualitative. */
import { linePath, type Frame } from '../sims/chart';
const f: Frame = { w: 340, h: 300, left: 40, right: 12, top: 40, bottom: 56, x: { min: 0, max: 40, ticks: [0, 10, 20, 30, 40], label: 'Weeks of pregnancy' }, y: { min: 0, max: 100, ticks: [], label: '' } };
const sx = (v: number) => f.left + (v / 40) * (f.w - f.left - f.right);
const sy = (v: number) => f.h - f.bottom - (v / 100) * (f.h - f.top - f.bottom);
const cl = (w: number) => 22 * Math.exp(-(((w - 4) / 5) ** 2));
const pl = (w: number) => (88 / (1 + Math.exp(-(w - 16) / 4.5))) * (w > 38.5 ? Math.max(0.55, 1 - (w - 38.5) * 0.3) : 1);
const boxes = [
  { x: 525, y: 46, t: ['Contractions push the', 'baby against the cervix'] },
  { x: 628, y: 150, t: ['Stretch receptors send', 'impulses to the brain'] },
  { x: 525, y: 254, t: ['Posterior pituitary', 'secretes more oxytocin'] },
  { x: 422, y: 150, t: ['Stronger, more frequent', 'uterine contractions'] },
];
---
<svg viewBox="0 0 720 312" role="img" aria-labelledby="d31-bi-t d31-bi-d" class="bir">
  <title id="d31-bi-t">Progesterone during pregnancy, and the oxytocin positive feedback loop in childbirth</title>
  <desc id="d31-bi-d">Left: a qualitative graph of progesterone over 40 weeks of pregnancy. Early on, progesterone comes from the corpus luteum, maintained by hCG; this source fades after about the first trimester as the placenta takes over and secretes rising amounts. At the end of pregnancy progesterone falls. Right: a cycle. Uterine contractions push the baby against the cervix; stretch receptors send impulses to the brain; the posterior pituitary secretes more oxytocin; contractions become stronger and more frequent, stretching the cervix further. This positive feedback continues until the baby is born.</desc>
  <defs><marker id="d31-bi-ah" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 z" class="ah" /></marker></defs>
  <text class="t b" x="20" y="18">Progesterone maintains pregnancy</text>
  <line class="axis" x1={f.left} y1={sy(0)} x2={f.w - f.right} y2={sy(0)} /><line class="axis" x1={f.left} y1={sy(0)} x2={f.left} y2={f.top - 6} />
  {f.x.ticks.map((t) => <text class="tick" x={sx(t)} y={sy(0) + 16} text-anchor="middle">{t}</text>)}
  <text class="t" x={(f.left + f.w) / 2} y={sy(0) + 36} text-anchor="middle">{f.x.label} →</text>
  <text class="t" transform={`translate(16 ${(f.top + sy(0)) / 2}) rotate(-90)`} text-anchor="middle">Progesterone →</text>
  <path class="cl" d={linePath(f, cl, 160)} /><path class="pl" d={linePath(f, pl, 160)} />
  <path class="lead" d={`M${sx(16.5)} ${sy(8)} L${sx(7)} ${sy(16)}`} /><text class="lab clc" x={sx(17)} y={sy(6)}>from corpus luteum</text>
  <text class="lab plc" x={sx(3)} y={sy(64)}>from placenta</text>
  
  <path class="lead" d={`M${sx(39.6)} ${sy(64)} L${sx(37)} ${sy(52)}`} /><text class="lab" x={sx(36.5)} y={sy(44)} text-anchor="end">falls before birth</text>

  <text class="t b" x="360" y="18">Childbirth: oxytocin positive feedback</text>
  {boxes.map((b) => <><rect class="bx" x={b.x - 84} y={b.y - 22} width="168" height="44" rx="10" /><text class="t" x={b.x} y={b.y - 4} text-anchor="middle">{b.t[0]}</text><text class="t" x={b.x} y={b.y + 13} text-anchor="middle">{b.t[1]}</text></>)}
  <path class="arr" d="M600 60 C620 76 628 100 628 124" marker-end="url(#d31-bi-ah)" />
  <path class="arr" d="M628 174 C628 200 620 222 604 234" marker-end="url(#d31-bi-ah)" />
  <path class="arr" d="M446 236 C428 222 422 200 422 176" marker-end="url(#d31-bi-ah)" />
  <path class="arr" d="M422 126 C422 100 430 80 448 66" marker-end="url(#d31-bi-ah)" />
  <text class="t b acc" x="525" y="196" text-anchor="middle">positive</text><text class="t b acc" x="525" y="212" text-anchor="middle">feedback</text>
  <text class="t muted" x="525" y="294" text-anchor="middle">Falling progesterone allows oxytocin secretion</text><text class="t muted" x="525" y="309" text-anchor="middle">to rise; the loop stops once the baby is born.</text>
</svg>
<style>
  .bir { font-family: var(--font-sans); }
  .t { font-size: 13.5px; fill: var(--text); }
  .t.b { font-weight: 750; }
  .t.muted { fill: var(--text-muted); font-size: 12.5px; }
  .acc { fill: var(--accent-strong); }
  .tick { font-size: 13px; fill: var(--text-muted); }
  .axis { stroke: var(--text); stroke-width: 1.4; }
  .cl, .pl { fill: none; stroke-width: 3.5; }
  .cl { stroke: var(--bio-glucose); stroke-dasharray: 3 5; }
  .pl { stroke: var(--bio-head); stroke-dasharray: 10 5; }
  .lab { font-size: 13px; font-weight: 700; fill: var(--text); }
  .clc { fill: color-mix(in srgb, var(--bio-glucose) 55%, var(--text)); }
  .plc { fill: color-mix(in srgb, var(--bio-head) 55%, var(--text)); }
  .lead { stroke: var(--text-muted); stroke-width: 1; }
  .bx { fill: color-mix(in srgb, var(--bio-protein) 10%, var(--surface)); stroke: var(--border-strong); stroke-width: 1.4; }
  .arr { fill: none; stroke: var(--text); stroke-width: 2; }
  .ah { fill: var(--text); }
</style>
