---
/** Sketch of ribose vs deoxyribose (A1.2.7): the only difference is –OH vs –H on carbon 2′. */
type P = [number, number];
const pent = (cx: number, cy: number, r: number): P[] =>
  [-90, -18, 54, 126, 198].map((a) => [cx + r * Math.cos((a * Math.PI) / 180), cy + r * Math.sin((a * Math.PI) / 180)]);
const pts = (p: P[]) => p.map(([x, y]) => `${x.toFixed(1)},${y.toFixed(1)}`).join(' ');
const sugars = [
  { v: pent(150, 110, 46), two: 'OH', name: 'Ribose (in RNA)', hl: 'hl-oh' },
  { v: pent(450, 110, 46), two: 'H', name: 'Deoxyribose (in DNA)', hl: 'hl-h' },
];
---
<svg viewBox="0 0 600 236" role="img" aria-labelledby="rb-t rb-d" xmlns="http://www.w3.org/2000/svg" class="rb">
  <title id="rb-t">Ribose compared with deoxyribose</title>
  <desc id="rb-d">Two five-membered rings, each with four carbons numbered 1′ to 4′ and an oxygen at the top, and carbon 5′ projecting from carbon 4′. Both have –OH on carbon 3′. Ribose has –OH on carbon 2′; deoxyribose has only –H on carbon 2′.</desc>
  {sugars.map(({ v, two, name, hl }) => (
    <g>
      <line class="bond" x1={v[4]![0]} y1={v[4]![1]} x2={v[4]![0] - 16} y2={v[4]![1] - 34} />
      <text class="t" x={v[4]![0] - 62} y={v[4]![1] - 40}>5′ CH₂OH</text>
      <line class="bond" x1={v[1]![0]} y1={v[1]![1]} x2={v[1]![0] + 18} y2={v[1]![1] - 24} />
      <text class="t" x={v[1]![0] + 12} y={v[1]![1] - 30}>OH</text>
      <line class="bond" x1={v[3]![0]} y1={v[3]![1]} x2={v[3]![0] - 10} y2={v[3]![1] + 30} />
      <text class="t" x={v[3]![0] - 26} y={v[3]![1] + 50}>OH</text>
      <line class="bond" x1={v[2]![0]} y1={v[2]![1]} x2={v[2]![0] + 10} y2={v[2]![1] + 30} />
      <circle class={`hl ${hl}`} cx={v[2]![0] + 14} cy={v[2]![1] + 45} r="21" />
      <text class="t strong" x={v[2]![0] + 14} y={v[2]![1] + 50} text-anchor="middle">{two}</text>
      <polygon class="sugar" points={pts(v)} />
      <text class="t" x={v[0]![0]} y={v[0]![1] + 19} text-anchor="middle">O</text>
      <text class="n" x={v[1]![0] - 15} y={v[1]![1] + 5} text-anchor="middle">1′</text>
      <text class="n" x={v[2]![0] - 7} y={v[2]![1] - 7} text-anchor="middle">2′</text>
      <text class="n" x={v[3]![0] + 7} y={v[3]![1] - 7} text-anchor="middle">3′</text>
      <text class="n" x={v[4]![0] + 15} y={v[4]![1] + 5} text-anchor="middle">4′</text>
      <text class="name" x={v[0]![0]} y="228" text-anchor="middle">{name}</text>
    </g>
  ))}
  <text class="note" x="300" y="122" text-anchor="middle">differ only</text>
  <text class="note" x="300" y="140" text-anchor="middle">at carbon 2′</text>
</svg>
<style>
  .rb { font-family: var(--font-sans); }
  .bond { stroke: var(--text); stroke-width: 2.4; }
  .sugar { fill: color-mix(in srgb, var(--border-strong) 35%, var(--surface)); stroke: var(--text); stroke-width: 2.2; }
  .t { font-size: 17px; fill: var(--text); }
  .strong { font-weight: 800; }
  .n { font-size: 14px; font-weight: 700; fill: var(--text-muted); }
  .name { font-size: 18px; font-weight: 750; fill: var(--text); }
  .note { font-size: 15px; font-style: italic; fill: var(--text-muted); }
  .hl { fill: none; stroke-width: 2.4; stroke-dasharray: 4 3; }
  .hl-oh { stroke: var(--bio-k); }
  .hl-h { stroke: var(--text-muted); }
</style>
