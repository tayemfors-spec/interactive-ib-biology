---
/** Sex determination in humans (D3.2.11): gametes, the 1 : 1 grid, SRY and the size difference of X and Y. */
const chr = (x: number, y: number, h: number, cls: string, label: string) =>
  `<rect class="${cls}" x="${x - 7}" y="${y}" width="14" height="${h}" rx="7"/><text class="t c" x="${x}" y="${y + h + 16}" text-anchor="middle">${label}</text>`;
---
<svg viewBox="0 0 540 300" role="img" aria-labelledby="sex-t sex-d" class="sexd">
  <title id="sex-t">Sex determination in humans</title>
  <desc id="sex-d">A female is XX and all her eggs carry an X chromosome. A male is XY and half his sperm carry X and half carry Y. A Punnett grid gives 1 XX female to 1 XY male. The Y chromosome carries the SRY gene, which makes the embryonic gonads develop into testes; testes secrete testosterone, which causes male-typical development. Without a Y, the gonads develop into ovaries. The X chromosome is much larger than the Y and carries many more genes.</desc>
  <text class="t strong" x="70" y="20" text-anchor="middle">female XX</text>
  <g set:html={chr(58, 30, 70, 'x', 'X') + chr(82, 30, 70, 'x', 'X')} />
  <text class="t strong" x="230" y="20" text-anchor="middle">male XY</text>
  <g set:html={chr(218, 30, 70, 'x', 'X') + chr(242, 30, 26, 'y', 'Y')} />
  <rect class="sry" x="235" y="44" width="14" height="6" />
  <text class="t small" x="256" y="50">SRY</text>

  <g transform="translate(40 150)">
    <text class="t" x="125" y="-2" text-anchor="middle">sperm</text>
    <text class="t g" x="95" y="18" text-anchor="middle">X</text><text class="t g" x="155" y="18" text-anchor="middle">Y</text>
    <text class="t" x="0" y="64" text-anchor="middle">eggs</text>
    <text class="t g" x="50" y="50" text-anchor="end">X</text><text class="t g" x="50" y="100" text-anchor="end">X</text>
    <rect class="cell f" x="65" y="26" width="60" height="48" /><rect class="cell m" x="125" y="26" width="60" height="48" />
    <rect class="cell f" x="65" y="74" width="60" height="48" /><rect class="cell m" x="125" y="74" width="60" height="48" />
    <text class="t strong" x="95" y="55" text-anchor="middle">XX ♀</text><text class="t strong" x="155" y="55" text-anchor="middle">XY ♂</text>
    <text class="t strong" x="95" y="103" text-anchor="middle">XX ♀</text><text class="t strong" x="155" y="103" text-anchor="middle">XY ♂</text>
    <text class="t" x="125" y="142" text-anchor="middle">1 female : 1 male</text>
  </g>

  <g transform="translate(300 10)">
    <rect class="panel" x="0" y="0" width="232" height="152" rx="8" />
    <text class="t strong" x="12" y="22">The sperm decides</text>
    <text class="t small" x="12" y="42">Y sperm → XY zygote. SRY makes</text>
    <text class="t small" x="12" y="58">the embryonic gonads develop as</text>
    <text class="t small" x="12" y="74">testes; their testosterone causes</text>
    <text class="t small" x="12" y="90">male-typical features.</text>
    <text class="t small" x="12" y="114">X sperm → XX zygote: no SRY, so</text>
    <text class="t small" x="12" y="130">the gonads develop as ovaries.</text>
  </g>
  <g transform="translate(300 172)">
    <rect class="panel" x="0" y="0" width="232" height="118" rx="8" />
    <text class="t strong" x="12" y="22">Genes carried (approx.)</text>
    <rect class="barx" x="12" y="34" width="208" height="22" rx="4" />
    <text class="t small" x="18" y="50">X: over 800 protein-coding</text>
    <rect class="bary" x="12" y="64" width="18" height="22" rx="4" />
    <text class="t small" x="36" y="80">Y: fewer than 100</text>
    <text class="t small" x="12" y="106">Most X genes have no Y partner.</text>
  </g>
</svg>
<style>
  .sexd { font-family: var(--font-sans); }
  .sexd :global(.x) { fill: var(--bio-chol); }
  .sexd :global(.y) { fill: var(--bio-protein); }
  .sry { fill: var(--bio-glucose); stroke: var(--text); }
  .sexd :global(.t) { font-size: 13px; fill: var(--text); }
  .sexd :global(.t.c) { font-weight: 800; }
  .t.strong { font-weight: 800; }
  .t.small { font-size: 12px; }
  .t.g { font-weight: 800; font-size: 15px; }
  .cell { stroke: var(--text); stroke-width: 1.5; }
  .cell.f { fill: color-mix(in srgb, var(--bio-chol) 18%, var(--surface)); }
  .cell.m { fill: color-mix(in srgb, var(--bio-protein) 18%, var(--surface)); }
  .panel { fill: var(--surface); stroke: var(--border-strong); }
  .barx { fill: color-mix(in srgb, var(--bio-chol) 35%, var(--surface)); stroke: var(--bio-chol); }
  .bary { fill: color-mix(in srgb, var(--bio-protein) 35%, var(--surface)); stroke: var(--bio-protein); }
</style>
