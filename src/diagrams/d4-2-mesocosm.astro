---
/** Setting up a sealed aquatic mesocosm (D4.2.4), with labels and an experimental design panel. */
const labsL = [
  { y: 48, t: ['Airtight seal:', 'no matter in or out'], ax: 196, ay: 44 },
  { y: 112, t: ['Air: O₂ and CO₂'], ax: 170, ay: 112 },
  { y: 176, t: ['Pond water'], ax: 150, ay: 176 },
  { y: 240, t: ['Consumers, e.g.', 'water snails'], ax: 168, ay: 236 },
  { y: 296, t: ['Pond mud: bacteria', 'and fungi', '(decomposers)'], ax: 156, ay: 302 },
];
const labsR = [
  { y: 70, t: ['Clear glass: light', 'in, heat out'], ax: 272, ay: 92 },
  { y: 176, t: ['Producers: aquatic', 'plants and algae'], ax: 238, ay: 190 },
];
---
<svg viewBox="0 0 600 340" role="img" aria-labelledby="d42m-t d42m-d" xmlns="http://www.w3.org/2000/svg">
  <title id="d42m-t">A sealed aquatic mesocosm and an experimental design</title>
  <desc id="d42m-d">A clear glass jar sealed with an airtight lid. Inside, from the top: air containing oxygen and carbon dioxide; pond water containing aquatic plants and algae as producers and small invertebrates such as water snails as consumers; and a layer of pond mud containing bacteria and fungi as decomposers. Light enters through the glass and heat leaves, but no matter can enter or leave. A panel on the right shows an experiment: three levels of the independent variable, such as light intensity, each with three replicate jars, with dissolved oxygen, pH and survival of organisms as dependent variables, and other conditions kept constant.</desc>
  <!-- jar -->
  <rect class="lid" x="178" y="30" width="80" height="22" rx="4" />
  <path class="glass" d="M184 52 L184 70 Q150 82 150 116 L150 300 Q150 318 168 318 L268 318 Q286 318 286 300 L286 116 Q286 82 252 70 L252 52" />
  <path class="water" d="M152 140 L284 140 L284 300 Q284 316 268 316 L168 316 Q152 316 152 300 Z" />
  <path class="mud" d="M152 290 Q218 282 284 290 L284 300 Q284 316 268 316 L168 316 Q152 316 152 300 Z" />
  <line class="surface" x1="152" y1="140" x2="284" y2="140" />
  <g class="plant">
    <path d="M200 288 q-10 -30 0 -60 q10 -30 0 -60 M200 250 q12 -6 16 -16 M200 210 q-12 -6 -16 -16 M200 176 q12 -6 14 -14" />
    <path d="M246 290 q8 -26 0 -52 q-8 -26 0 -54 M246 256 q-12 -6 -14 -16 M246 222 q12 -6 14 -16" />
  </g>
  <g class="snail"><path d="M168 240 q0 -10 10 -10 q10 0 10 10 Z" /><circle cx="178" cy="234" r="4" class="shell" /></g>
  <g class="snail"><path d="M222 276 q0 -10 10 -10 q10 0 10 10 Z" /><circle cx="232" cy="270" r="4" class="shell" /></g>
  <g class="dots">{[[170, 160], [214, 196], [262, 168], [180, 206], [258, 236], [226, 154]].map(([x, y]) => <circle cx={x} cy={y} r="2.2" />)}</g>

  {labsL.map((l) => (
    <g>
      {l.t.map((s, i) => <text class="lab" x="140" y={l.y + i * 15 - (l.t.length - 1) * 7} text-anchor="end">{s}</text>)}
      <line class="ptr" x1="143" y1={l.y - 4} x2={l.ax} y2={l.ay} />
    </g>
  ))}
  {labsR.map((l) => (
    <g>
      {l.t.map((s, i) => <text class="lab" x="300" y={l.y + i * 15}>{s}</text>)}
      <line class="ptr" x1="297" y1={l.y - 4} x2={l.ax} y2={l.ay} />
    </g>
  ))}

  <!-- experimental design -->
  <rect class="panel" x="430" y="12" width="164" height="316" rx="10" />
  <text class="ph" x="512" y="34" text-anchor="middle">Experimental design</text>
  {['low', 'medium', 'high'].map((lv, r) => (
    <g>
      <text class="pl" x="442" y={66 + r * 52}>{lv} light</text>
      {[0, 1, 2].map((c) => (
        <g>
          <rect class="mini" x={446 + c * 46} y={74 + r * 52} width="30" height="20" rx="5" />
          <rect class="mini-w" x={446 + c * 46} y={82 + r * 52} width="30" height="12" rx="4" />
        </g>
      ))}
    </g>
  ))}
  <text class="pt" x="442" y="216">3 replicates per level</text>
  <text class="pt b" x="442" y="240">Measure:</text>
  <text class="pt" x="442" y="256">dissolved O₂, pH,</text>
  <text class="pt" x="442" y="272">survival and growth</text>
  <text class="pt b" x="442" y="296">Keep constant:</text>
  <text class="pt" x="442" y="312">temperature, volumes</text>
</svg>
<style>
  svg { font-family: var(--font-sans); }
  .lid { fill: var(--text-muted); }
  .glass { fill: none; stroke: var(--text); stroke-width: 2.2; }
  .water { fill: color-mix(in srgb, var(--bio-water) 25%, var(--surface)); }
  .mud { fill: color-mix(in srgb, var(--bio-tail) 60%, var(--text)); }
  .surface { stroke: var(--bio-water); stroke-width: 2; }
  .plant path { fill: none; stroke: var(--bio-carb); stroke-width: 3; stroke-linecap: round; }
  .snail path { fill: var(--bio-head); }
  .snail .shell { fill: var(--surface); stroke: var(--bio-head); stroke-width: 1.5; }
  .dots circle { fill: color-mix(in srgb, var(--bio-carb) 70%, var(--text)); }
  .lab { font-size: 13px; font-weight: 650; fill: var(--text); }
  .ptr { stroke: var(--text-muted); stroke-width: 1.2; }
  .panel { fill: var(--surface); stroke: var(--border); }
  .ph { font-size: 13.5px; font-weight: 800; fill: var(--text); }
  .pl { font-size: 12.5px; font-weight: 700; fill: var(--text); }
  .mini { fill: none; stroke: var(--text-muted); stroke-width: 1.4; }
  .mini-w { fill: color-mix(in srgb, var(--bio-water) 35%, var(--surface)); }
  .pt { font-size: 12.5px; fill: var(--text); }
  .pt.b { font-weight: 750; }
</style>
