---
/**
 * Exam-style diagram of transcription (D1.2.1, D1.2.2; also the first paint of the protein-synthesis viewer).
 * The coding (sense) strand is on top, 5′→3′ left to right; the template (antisense) strand below runs
 * 3′→5′, so it is antiparallel. Inside the bubble the template bases are paired with RNA nucleotides; the
 * RNA's 3′ end is at the polymerase's active site and its 5′ end has already left. Numbered markers keep it
 * legible on phones; the key below gives the names in real text.
 */
const coding = 'GACCATGGCAT'.split(''); // bubble positions j = 0…10, read 5′→3′
const pairT: Record<string, string> = { A: 'T', T: 'A', G: 'C', C: 'G' };
const pairR: Record<string, string> = { A: 'U', T: 'A', G: 'C', C: 'G' };
const template = coding.map((b) => pairT[b]!);
const xj = (j: number) => 250 + 20 * j;
const HYB0 = 4; // RNA is paired with template positions 4…10
const cls = (b: string) => `b${b}`;
const leftRungs = Array.from({ length: 9 }, (_, i) => 40 + i * 20);
const rightRungs = Array.from({ length: 10 }, (_, i) => 510 + i * 20);
const free = [
  { b: 'A', x: 520, y: 112 }, { b: 'G', x: 556, y: 92 }, { b: 'U', x: 590, y: 120 }, { b: 'C', x: 548, y: 136 },
];
const markers: { n: number; x: number; y: number; to: [number, number] }[] = [
  { n: 1, x: 395, y: 268, to: [395, 236] },
  { n: 2, x: 330, y: 40, to: [330, 76] },
  { n: 3, x: 600, y: 262, to: [600, 216] },
  { n: 4, x: 150, y: 70, to: [214, 70] },
  { n: 5, x: 640, y: 96, to: [604, 110] },
  { n: 6, x: 484, y: 192, to: [456, 184] },
  { n: 7, x: 500, y: 60, to: [474, 112] },
  { n: 8, x: 200, y: 128, to: [214, 156] },
  { n: 9, x: 90, y: 268, to: [90, 236] },
];
const key = [
  'RNA polymerase: unwinds the DNA and links RNA nucleotides',
  'Coding (sense) strand: same base sequence as the RNA, with T in place of U',
  'Template (antisense) strand: the strand that is copied, read 3′ → 5′',
  'RNA (here mRNA) leaving the polymerase, 5′ end first',
  'Free RNA nucleotides (ribonucleoside triphosphates)',
  'Hydrogen bonds between complementary bases: A–U, T–A, G–C, C–G',
  'DNA unwinding ahead of the polymerase',
  'DNA rewinding into a double helix behind it',
  'Promoter: where RNA polymerase binds to start transcription',
];
---
<div class="exam-diagram">
  <svg viewBox="0 0 720 290" role="img" aria-labelledby="tx-title tx-desc" xmlns="http://www.w3.org/2000/svg">
    <title id="tx-title">Transcription of a gene by RNA polymerase</title>
    <desc id="tx-desc">A gene in double-stranded DNA. RNA polymerase has separated the two strands over a short stretch, forming a bubble. Inside it, RNA nucleotides are paired with the bases of the lower, template strand by hydrogen bonds: A with U, T with A, G with C and C with G. The RNA grows 5′ to 3′ as the polymerase moves to the right; its 5′ end has already left the DNA. The upper, coding strand has the same sequence as the RNA except that it has T where the RNA has U. Behind the polymerase the DNA rewinds; ahead of it the DNA is unwound. The promoter is at the start of the gene, on the left.</desc>

    <!-- direction of transcription -->
    <path class="arrow" d="M560 26 H700" marker-end="url(#tx-ah)" />
    <text class="note" x="630" y="18" text-anchor="middle">direction of transcription</text>

    <!-- promoter region -->
    <rect class="prom" x="30" y="128" width="130" height="92" rx="6" />

    <!-- RNA polymerase behind everything -->
    <ellipse class="pol" cx="372" cy="148" rx="150" ry="86" />

    <!-- closed DNA either side: rungs -->
    {leftRungs.map((x) => <path class="rung" d={`M${x} 142 V214`} />)}
    {rightRungs.map((x) => <path class="rung" d={`M${x} 142 V214`} />)}

    <!-- strands -->
    <path class="dna" d="M20 140 H204 C226 140 222 76 242 76 H458 C478 76 474 140 496 140 H700" />
    <path class="dna" d="M20 216 H700" />
    <text class="end" x="6" y="145">5′</text><text class="end" x="704" y="145">3′</text>
    <text class="end" x="6" y="221">3′</text><text class="end" x="704" y="221">5′</text>

    <!-- coding strand bases in the bubble (unpaired) -->
    {coding.map((b, j) => (
      <g>
        <rect class={`slab ${cls(b)}`} x={xj(j) - 7} y="78" width="14" height="22" rx="2" />
        <text class="base" x={xj(j)} y="94" text-anchor="middle">{b}</text>
      </g>
    ))}
    <!-- template strand bases -->
    {template.map((b, j) => (
      <g>
        <rect class={`slab ${cls(b)}`} x={xj(j) - 7} y="192" width="14" height="22" rx="2" />
        <text class="base" x={xj(j)} y="208" text-anchor="middle">{b}</text>
      </g>
    ))}
    <!-- RNA paired with the template (hybrid) -->
    <path class="rna" d={`M${xj(HYB0)} 150 H${xj(10)}`} />
    {coding.slice(HYB0).map((_, k) => {
      const j = HYB0 + k;
      const r = pairR[template[j]!]!;
      const n = r === 'G' || r === 'C' ? 3 : 2;
      return (
        <g>
          <rect class={`slab ${cls(r)}`} x={xj(j) - 7} y="152" width="14" height="22" rx="2" />
          <text class="base" x={xj(j)} y="168" text-anchor="middle">{r}</text>
          {Array.from({ length: n }, (_, q) => <path class="hb" d={`M${xj(j) - (n - 1) * 3 + q * 6} 176 V190`} />)}
        </g>
      );
    })}
    <!-- RNA leaving: 5′ end first -->
    <path class="rna" d={`M${xj(HYB0)} 150 C300 150 262 112 236 82 S196 36 168 34`} />
    <text class="end strong" x="146" y="38">5′</text>
    <text class="end strong" x={xj(10) + 11} y="170">3′</text>

    <!-- free nucleotides, one arriving at the active site -->
    {free.map((f) => (
      <g>
        <circle class={`nt ${cls(f.b)}`} cx={f.x} cy={f.y} r="10" />
        <text class="base" x={f.x} y={f.y + 4.5} text-anchor="middle">{f.b}</text>
      </g>
    ))}
    <path class="arrow thin" d="M512 118 Q486 128 462 140" marker-end="url(#tx-ah)" />

    <g class="markers">
      {markers.map((m) => (
        <g>
          <path class="lead" d={`M${m.x} ${m.y} L${m.to[0]} ${m.to[1]}`} />
          <circle cx={m.x} cy={m.y} r="13" />
          <text x={m.x} y={m.y} dy="0.36em" text-anchor="middle">{m.n}</text>
        </g>
      ))}
    </g>
    <defs><marker id="tx-ah" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0 0 L10 5 L0 10 Z" class="ah" /></marker></defs>
  </svg>
  <ol class="key">
    {key.map((k) => <li>{k}</li>)}
  </ol>
</div>

<style>
  .exam-diagram svg { font-family: var(--font-sans); }
  .dna { stroke: var(--text); stroke-width: 4; fill: none; stroke-linejoin: round; }
  .rna { stroke: var(--bio-chol); stroke-width: 4; fill: none; stroke-linecap: round; }
  .rung { stroke: var(--text-muted); stroke-width: 3; }
  .prom { fill: color-mix(in srgb, var(--bio-chol) 16%, transparent); stroke: var(--bio-chol); stroke-width: 1.4; stroke-dasharray: 5 4; }
  .pol { fill: color-mix(in srgb, var(--bio-protein) 14%, transparent); stroke: color-mix(in srgb, var(--bio-protein) 70%, var(--text)); stroke-width: 1.6; }
  .slab { stroke-width: 1.4; }
  .bA { fill: color-mix(in srgb, var(--bio-protein) 30%, var(--surface)); stroke: var(--bio-protein); }
  .bT { fill: color-mix(in srgb, var(--bio-head) 30%, var(--surface)); stroke: var(--bio-head); }
  .bG { fill: color-mix(in srgb, var(--bio-carb) 30%, var(--surface)); stroke: var(--bio-carb); }
  .bC { fill: color-mix(in srgb, var(--bio-protein-2) 30%, var(--surface)); stroke: var(--bio-protein-2); }
  .bU { fill: color-mix(in srgb, var(--bio-glucose) 34%, var(--surface)); stroke: var(--bio-glucose); }
  .nt { stroke-width: 1.6; }
  .base { font-size: 13px; font-weight: 800; fill: var(--text); }
  .hb { stroke: var(--text); stroke-width: 1.4; stroke-dasharray: 2 2; }
  .end { font-size: 14px; font-weight: 800; fill: var(--text); }
  .note { font-size: 13px; font-style: italic; fill: var(--text-muted); }
  .arrow { stroke: var(--text); stroke-width: 2; fill: none; }
  .arrow.thin { stroke-width: 1.4; stroke-dasharray: 4 3; }
  .ah { fill: var(--text); }
  .markers circle { fill: var(--surface); stroke: var(--text); stroke-width: 1.8; }
  .markers text { font-size: 15px; font-weight: 800; fill: var(--text); }
  .lead { stroke: var(--text); stroke-width: 1.4; }
  .key { columns: 2 17rem; column-gap: var(--space-5); margin: var(--space-3) 0 0; padding: 0; list-style: none; counter-reset: k; font-size: var(--step--1); }
  .key li { break-inside: avoid; margin: 0 0 0.3rem; display: grid; grid-template-columns: 1.7rem 1fr; counter-increment: k; }
  .key li::before { content: counter(k); font-weight: 800; display: inline-grid; place-items: center; width: 1.35rem; height: 1.35rem; border: 1.5px solid var(--text); border-radius: 50%; font-size: 0.75rem; margin-top: 0.1rem; }
</style>
