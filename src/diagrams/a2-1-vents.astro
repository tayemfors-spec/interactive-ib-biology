---
/** A proposed early-Earth (Hadean) alkaline hydrothermal vent and a close-up of one micropore in its chimney wall (A2.1.9).
 *  Not Lost City: modern carbonate chimneys contain little FeS; FeS walls are proposed for vents in the iron-rich Hadean ocean. */
const pores = [[150, 280], [178, 262], [140, 236], [170, 212], [150, 186], [176, 160], [158, 132], [168, 106], [196, 236], [126, 262], [190, 188]];
const hOut = [[372, 92], [410, 120], [380, 150], [432, 176], [366, 200], [404, 226], [440, 104], [430, 246], [376, 252]];
const hIn = [[548, 130], [580, 220]];
const fes = [96, 128, 160, 192, 224, 256];
---
<svg viewBox="0 0 640 380" role="img" aria-labelledby="vent-t vent-d" xmlns="http://www.w3.org/2000/svg">
  <title id="vent-t">A proposed early-Earth alkaline hydrothermal vent and one of its micropores</title>
  <desc id="vent-d">A model of an alkaline vent as proposed for the Hadean ocean, which was rich in dissolved iron; it is not a picture of a modern vent such as Lost City, whose chimneys contain little iron sulfide. Left: a porous mineral chimney rises from the seafloor. Warm alkaline fluid rich in hydrogen and methane, produced where seawater reacts with rock below the seafloor, flows up through it into ocean water that is rich in carbon dioxide and more acidic. Right: a close-up of one micropore. A thin mineral wall, thought to have contained iron–sulfur minerals in these early vents, separates acidic ocean water with many hydrogen ions and carbon dioxide from alkaline vent fluid with few hydrogen ions and hydrogen gas. Hydrogen ions tend to flow across the wall down this natural gradient, and the iron–sulfur minerals could catalyse reactions between hydrogen and carbon dioxide that make organic molecules. The pore itself is a natural compartment.</desc>

  <!-- ocean and seafloor -->
  <rect class="ocean" x="0" y="0" width="330" height="320" />
  <rect class="rock" x="0" y="320" width="330" height="60" />
  <path class="crack" d="M130 338 L136 328 L142 320 M198 338 L192 328 L190 320" />
  <text class="lbl strong" x="12" y="22">Proposed</text>
  <text class="lbl strong" x="12" y="40">Hadean vent</text>
  <text class="lbl" x="12" y="72">early ocean: CO₂-</text>
  <text class="lbl" x="12" y="90">and iron-rich,</text>
  <text class="lbl" x="12" y="108">more acidic</text>
  <text class="lbl" x="12" y="356">rock reacts with seawater</text>
  <text class="lbl" x="12" y="374">→ H₂ and warm alkaline fluid</text>

  <!-- chimney -->
  <path class="chimney" d="M104 320 C110 250 128 170 142 100 L150 84 L176 84 L186 104 C198 170 216 250 232 320 Z" />
  {pores.map(([x, y]) => <ellipse class="pore" cx={x} cy={y} rx="7" ry="5" />)}
  <path class="flow" d="M160 316 C150 260 172 200 158 120" />
  <path class="flow" d="M188 316 C196 262 178 200 172 120" />
  <path class="plume" d="M150 80 C140 60 152 44 140 24 M176 80 C186 60 176 44 188 24" />
  <path class="arrowhead" d="M134 32 L140 22 L146 34 M182 34 L188 22 L194 32" />
  <text class="lbl" x="240" y="150">porous</text>
  <text class="lbl" x="240" y="168">mineral</text>
  <text class="lbl" x="240" y="186">chimney</text>
  <path class="lead" d="M236 162 L200 172" />
  <text class="lbl strong" x="200" y="24">warm alkaline</text>
  <text class="lbl strong" x="200" y="42">fluid: H₂, CH₄</text>

  <!-- zoom -->
  <circle class="zoom" cx="176" cy="160" r="12" />
  <path class="zoomline" d="M186 152 L346 40 M186 168 L346 306" />

  <!-- close-up of a micropore -->
  <rect class="inset" x="346" y="40" width="288" height="266" rx="10" />
  <rect class="ocean" x="347" y="41" width="133" height="264" />
  <rect class="fluid" x="500" y="41" width="133" height="264" />
  <rect class="wall" x="480" y="41" width="20" height="264" />
  {fes.map((y) => <rect class="fes" x="485" y={y} width="10" height="10" transform={`rotate(45 490 ${y + 5})`} />)}
  {hOut.map(([x, y]) => <text class="ion" x={x} y={y} text-anchor="middle">H⁺</text>)}
  {hIn.map(([x, y]) => <text class="ion" x={x} y={y} text-anchor="middle">H⁺</text>)}
  <text class="lbl strong" x="358" y="64">ocean side</text>
  <text class="lbl" x="358" y="282">CO₂, many H⁺</text>
  <text class="lbl strong" x="510" y="64">inside pore</text>
  <text class="lbl" x="510" y="170">vent fluid:</text>
  <text class="lbl" x="510" y="188">H₂, few H⁺</text>
  <path class="harrow" d="M448 140 H534 M524 132 L534 140 L524 148" />
  <text class="lbl" x="490" y="330" text-anchor="middle">thin wall containing FeS minerals,</text>
  <text class="lbl" x="490" y="350" text-anchor="middle">which may catalyse CO₂ + H₂ →</text>
  <text class="lbl" x="490" y="370" text-anchor="middle">organic molecules</text>
</svg>
<style>
  svg { font-family: var(--font-sans); }
  .ocean { fill: color-mix(in srgb, var(--bio-water) 16%, var(--surface)); }
  .fluid { fill: color-mix(in srgb, var(--bio-glucose) 14%, var(--surface)); }
  .rock { fill: color-mix(in srgb, var(--text-muted) 30%, var(--surface)); }
  .crack { fill: none; stroke: var(--bio-head); stroke-width: 3; stroke-linejoin: round; }
  .chimney { fill: color-mix(in srgb, var(--text-muted) 14%, var(--surface)); stroke: var(--text-muted); stroke-width: 2; }
  .pore { fill: color-mix(in srgb, var(--bio-glucose) 35%, var(--surface)); stroke: var(--text-muted); stroke-width: 1; }
  .flow { fill: none; stroke: var(--bio-head); stroke-width: 3; stroke-dasharray: 6 5; }
  .plume, .arrowhead { fill: none; stroke: var(--bio-head); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  .lbl { font-size: 14px; fill: var(--text); }
  .strong { font-weight: 800; }
  .lead { stroke: var(--text); stroke-width: 1.2; }
  .zoom { fill: none; stroke: var(--accent); stroke-width: 2.5; }
  .zoomline { fill: none; stroke: var(--accent); stroke-width: 1.5; stroke-dasharray: 4 4; }
  .inset { fill: none; stroke: var(--accent); stroke-width: 2.5; }
  .wall { fill: color-mix(in srgb, var(--text-muted) 40%, var(--surface)); }
  .fes { fill: var(--bio-glucose); stroke: var(--text); stroke-width: 1; }
  .ion { font-size: 14px; font-weight: 800; fill: var(--bio-k); }
  .harrow { fill: none; stroke: var(--bio-k); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
</style>
