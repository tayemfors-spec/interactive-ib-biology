---
/** C2.2.10: interpreting an oscilloscope trace, and measuring impulse frequency. */
import { membranePotential } from '../sims/models/c2-2-action-potential';

// panel 1: one action potential, 0–6 ms
const A = { l: 62, r: 540, t: 24, b: 224 };
const ax = (t: number) => A.l + (t / 6) * (A.r - A.l);
const vy = (top: number, bottom: number) => (v: number) => bottom - ((v + 90) / 140) * (bottom - top);
const ay = vy(A.t, A.b);
const one = Array.from({ length: 301 }, (_, i) => i * 0.02).map((t, i) => `${i ? 'L' : 'M'}${ax(t).toFixed(1)} ${ay(membranePotential(t)).toFixed(1)}`).join('');

// panel 2: a train of impulses, 0–50 ms, one every 10 ms
const B = { l: 62, r: 540, t: 300, b: 470 };
const bx = (t: number) => B.l + (t / 50) * (B.r - B.l);
const by = vy(B.t, B.b);
const starts = [3, 13, 23, 33, 43];
const trainV = (t: number) => {
  for (const s of starts) if (t >= s - 1 && t < s + 6) return membranePotential(t - s + 1);
  return -70;
};
const train = Array.from({ length: 1001 }, (_, i) => i * 0.05).map((t, i) => `${i ? 'L' : 'M'}${bx(t).toFixed(1)} ${by(trainV(t)).toFixed(1)}`).join('');
const peakT = (s: number) => s + 1; // peak is 1 ms after the start of each spike (2.0 − 1.0)

const markers = [
  { n: 1, t: 0.5, dx: 0, dy: -26 },
  { n: 2, t: 1.4, dx: -26, dy: -12 },
  { n: 3, t: 1.8, dx: -28, dy: 0 },
  { n: 4, t: 2.0, dx: 26, dy: -6 },
  { n: 5, t: 2.6, dx: 28, dy: 0 },
  { n: 6, t: 3.2, dx: 30, dy: 12 },
  { n: 7, t: 5.4, dx: 0, dy: -26 },
];
const key = [
  'Resting potential, about −70 mV',
  'Depolarised to the threshold potential (−50 mV)',
  'Depolarisation: voltage-gated Na⁺ channels open and Na⁺ diffuses in',
  'Peak, about +30 to +40 mV: Na⁺ channels close',
  'Repolarisation: voltage-gated K⁺ channels open and K⁺ diffuses out',
  'Hyperpolarisation (about −80 mV); refractory period',
  'Resting potential restored as K⁺ channels close',
];
---
<div class="exam-diagram">
  <svg viewBox="0 0 560 520" role="img" aria-labelledby="tr-title tr-desc" xmlns="http://www.w3.org/2000/svg" class="trace">
    <title id="tr-title">Oscilloscope traces of a resting potential and action potentials</title>
    <desc id="tr-desc">Top: one action potential over 6 milliseconds. The potential is steady at −70 mV, rises to the threshold of −50 mV, shoots up to about +35 mV, falls steeply to about −80 mV and then returns to −70 mV. Bottom: five action potentials in 50 milliseconds, one every 10 milliseconds, so the frequency is 100 impulses per second.</desc>

    <!-- panel 1 -->
    <g class="grid">{[40, 0, -40, -80].map((v) => <line x1={A.l} x2={A.r} y1={ay(v)} y2={ay(v)} />)}</g>
    <line class="thr" x1={A.l} x2={A.r} y1={ay(-50)} y2={ay(-50)} />
    <text class="thrtext" x={ax(3.9)} y={ay(-50) - 5}>threshold</text>
    <path class="axes" d={`M${A.l} ${A.t} V${A.b} H${A.r}`} />
    <g class="ticks">
      {[40, 0, -40, -80].map((v) => <text x={A.l - 8} y={ay(v)} dy="0.35em" text-anchor="end">{v > 0 ? `+${v}` : v}</text>)}
      {[0, 1, 2, 3, 4, 5, 6].map((t) => <text x={ax(t)} y={A.b + 17} text-anchor="middle">{t}</text>)}
    </g>
    <text class="axis" x={(A.l + A.r) / 2} y={A.b + 38} text-anchor="middle">Time / ms</text>
    <text class="axis" transform={`translate(16 ${(A.t + A.b) / 2}) rotate(-90)`} text-anchor="middle">Potential / mV</text>
    <path class="line" d={one} />
    <g class="markers">
      {markers.map((m) => {
        const px = ax(m.t), py = ay(membranePotential(m.t));
        return (
          <g>
            <path class="lead" d={`M${px} ${py} L${px + m.dx} ${py + m.dy}`} />
            <circle cx={px + m.dx} cy={py + m.dy} r="11" />
            <text x={px + m.dx} y={py + m.dy} dy="0.36em" text-anchor="middle">{m.n}</text>
          </g>
        );
      })}
    </g>

    <!-- panel 2 -->
    <text class="ptitle" x={B.l} y={B.t - 16}>Measuring impulse frequency</text>
    <g class="grid">{[40, 0, -40, -80].map((v) => <line x1={B.l} x2={B.r} y1={by(v)} y2={by(v)} />)}</g>
    <path class="axes" d={`M${B.l} ${B.t} V${B.b} H${B.r}`} />
    <g class="ticks">
      {[40, 0, -40, -80].map((v) => <text x={B.l - 8} y={by(v)} dy="0.35em" text-anchor="end">{v > 0 ? `+${v}` : v}</text>)}
      {[0, 10, 20, 30, 40, 50].map((t) => <text x={bx(t)} y={B.b + 17} text-anchor="middle">{t}</text>)}
    </g>
    <text class="axis" x={(B.l + B.r) / 2} y={B.b + 38} text-anchor="middle">Time / ms</text>
    <text class="axis" transform={`translate(16 ${(B.t + B.b) / 2}) rotate(-90)`} text-anchor="middle">Potential / mV</text>
    <path class="line" d={train} />
    <path class="dim" d={`M${bx(peakT(13))} ${by(46)} H${bx(peakT(23))}`} marker-start="url(#tr-a)" marker-end="url(#tr-a)" />
    <text class="dimtext" x={(bx(peakT(13)) + bx(peakT(23))) / 2} y={by(46) + 18} text-anchor="middle">10 ms</text>
    <defs>
      <marker id="tr-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 z" class="ah" /></marker>
    </defs>
  </svg>
  <ol class="key">{key.map((k) => <li>{k}</li>)}</ol>
  <p class="calc">Frequency: 5 action potentials in 50 ms, or one every 10 ms = 0.010 s, so 1 ÷ 0.010 s = <strong>100 impulses per second</strong>.</p>
</div>

<style>
  .trace { font-family: var(--font-sans); }
  .grid line { stroke: var(--border); }
  .axes { stroke: var(--text); stroke-width: 1.6; fill: none; }
  .ticks text { font-size: 14px; fill: var(--text-muted); }
  .axis { font-size: 14px; font-weight: 650; fill: var(--text); }
  .ptitle { font-size: 15px; font-weight: 750; fill: var(--text); }
  .thr { stroke: var(--warn); stroke-width: 1.5; stroke-dasharray: 6 4; }
  .thrtext { font-size: 13px; font-weight: 700; fill: var(--warn); }
  .line { fill: none; stroke: var(--accent); stroke-width: 3; stroke-linejoin: round; }
  .markers circle { fill: var(--surface); stroke: var(--text); stroke-width: 1.6; }
  .markers text { font-size: 13px; font-weight: 800; fill: var(--text); }
  .lead { stroke: var(--text); stroke-width: 1.2; }
  .dim { stroke: var(--text); stroke-width: 1.6; }
  .ah { fill: var(--text); }
  .dimtext { font-size: 14px; font-weight: 700; fill: var(--text); }
  .key { margin: var(--space-3) 0 0; padding: 0; list-style: none; counter-reset: k; font-size: var(--step--1); columns: 2 17rem; column-gap: var(--space-5); }
  .key li { break-inside: avoid; margin: 0 0 0.3rem; display: grid; grid-template-columns: 1.7rem 1fr; counter-increment: k; }
  .key li::before { content: counter(k); font-weight: 800; display: inline-grid; place-items: center; width: 1.35rem; height: 1.35rem; border: 1.5px solid var(--text); border-radius: 50%; font-size: 0.75rem; margin-top: 0.1rem; }
  .calc { font-size: var(--step--1); margin: var(--space-2) 0 0; }
</style>
