---
/** C2.2.4 skill: correlation coefficient (r) and R² for conduction speed against fibre diameter. */
import { correlation, myelinatedData } from '../sims/models/c2-2-correlation';

const c = correlation(myelinatedData);
const P = { l: 64, r: 540, t: 20, b: 280 };
const X = (d: number) => P.l + (d / 22) * (P.r - P.l);
const Y = (v: number) => P.b - (v / 140) * (P.b - P.t);
const xt = [0, 5, 10, 15, 20];
const yt = [0, 20, 40, 60, 80, 100, 120, 140];
// mini panels illustrating the sign and strength of r
const mini = (seed: number, slope: number, spread: number) =>
  Array.from({ length: 14 }, (_, i) => {
    const x = (i + 0.5) / 14;
    const n = Math.sin(i * 12.9898 + seed) * 43758.5453;
    const noise = (n - Math.floor(n) - 0.5) * spread;
    return [x, Math.min(0.98, Math.max(0.02, 0.5 + slope * (x - 0.5) + noise))] as [number, number];
  });
const panels = [
  { title: 'strong positive', pts: mini(1, 0.8, 0.25) },
  { title: 'no correlation', pts: mini(9, 0, 0.9) },
  { title: 'strong negative', pts: mini(3, -0.8, 0.25) },
].map((p) => ({ ...p, r: correlation(p.pts).r }));
---
<svg viewBox="0 0 560 500" role="img" aria-labelledby="cor-t cor-d" xmlns="http://www.w3.org/2000/svg" class="cor">
  <title id="cor-t">Scatter graph of conduction speed against diameter for myelinated nerve fibres</title>
  <desc id="cor-d">Seventeen points rise from about 10 metres per second at 2 micrometres to about 115 metres per second at 20 micrometres, close to a straight line of best fit. r = {c.r.toFixed(2)} and R squared = {c.r2.toFixed(2)}. Below, three small graphs show a strong positive correlation, no correlation and a strong negative correlation.</desc>
  <g class="grid">
    {yt.map((v) => <line x1={P.l} x2={P.r} y1={Y(v)} y2={Y(v)} />)}
  </g>
  <path class="axes" d={`M${P.l} ${P.t} V${P.b} H${P.r}`} />
  <g class="ticks">
    {xt.map((d) => <text x={X(d)} y={P.b + 18} text-anchor="middle">{d}</text>)}
    {yt.map((v) => <text x={P.l - 8} y={Y(v)} dy="0.35em" text-anchor="end">{v}</text>)}
  </g>
  <text class="axis" x={(P.l + P.r) / 2} y={P.b + 40} text-anchor="middle">Fibre diameter / µm</text>
  <text class="axis" transform={`translate(18 ${(P.t + P.b) / 2}) rotate(-90)`} text-anchor="middle">Conduction speed / m s⁻¹</text>
  <line class="fit" x1={X(1)} y1={Y(c.intercept + c.slope * 1)} x2={X(21)} y2={Y(c.intercept + c.slope * 21)} />
  {myelinatedData.map(([d, v]) => <circle class="pt" cx={X(d)} cy={Y(v)} r="5.5" />)}
  <g class="stats">
    <rect x={P.l + 14} y={P.t + 6} width="196" height="58" rx="6" />
    <text x={P.l + 26} y={P.t + 30}>r = {c.r.toFixed(2)}</text>
    <text x={P.l + 26} y={P.t + 54}>R² = {c.r2.toFixed(2)}</text>
  </g>

  {panels.map((p, i) => {
    const x0 = 24 + i * 180, y0 = 360, w = 150, h = 100;
    return (
      <g class="mini">
        <path class="axes" d={`M${x0} ${y0} V${y0 + h} H${x0 + w}`} />
        {p.pts.map(([x, y]) => <circle class="pt small" cx={x0 + x * w} cy={y0 + h - y * h} r="3.5" />)}
        <text x={x0 + w / 2} y={y0 - 10} text-anchor="middle" class="mtitle">{p.title}</text>
        <text x={x0 + w / 2} y={y0 + h + 22} text-anchor="middle" class="mr">r ≈ {Math.abs(p.r) < 0.005 ? '0.00' : `${p.r > 0 ? '+' : '−'}${Math.abs(p.r).toFixed(2)}`}</text>
      </g>
    );
  })}
</svg>

<style>
  .cor { font-family: var(--font-sans); }
  .grid line { stroke: var(--border); }
  .axes { stroke: var(--text); stroke-width: 1.6; fill: none; }
  .ticks text { font-size: 14px; fill: var(--text-muted); }
  .axis { font-size: 15px; font-weight: 650; fill: var(--text); }
  .pt { fill: var(--bio-protein); stroke: var(--surface); stroke-width: 1.2; }
  .fit { stroke: var(--bio-head); stroke-width: 2.5; stroke-dasharray: 8 5; }
  .stats rect { fill: var(--surface); stroke: var(--border-strong); }
  .stats text { font-size: 17px; font-weight: 800; fill: var(--text); }
  .mtitle { font-size: 14px; font-weight: 700; fill: var(--text); }
  .mr { font-size: 14px; font-weight: 700; fill: var(--text-muted); }
</style>
