---
/** Medical uses of isotonic solutions (D2.3.7): an intravenous drip and an organ stored for transplant. */
const rbcs = [[86, 262], [128, 270], [170, 258], [212, 268], [252, 260]];
const ice = Array.from({ length: 22 }, (_, i) => {
  const a = (i / 22) * Math.PI * 2;
  return [480 + 104 * Math.cos(a) * (0.88 + 0.1 * ((i * 7) % 3)), 150 + 76 * Math.sin(a) * (0.88 + 0.1 * ((i * 5) % 3))];
});
---
<svg viewBox="0 0 640 336" role="img" aria-labelledby="md-t md-d" xmlns="http://www.w3.org/2000/svg">
  <title id="md-t">Isotonic solutions in medicine</title>
  <desc id="md-d">Left: an intravenous drip bag of sterile saline, isotonic with blood plasma, flows through a tube into a vein; the red blood cells in the vein keep their normal shape. Right: a donor kidney kept in a sealed bag of cold, isotonic preservation solution, packed in ice inside an insulated box until transplantation.</desc>
  <text class="hd" x="160" y="24" text-anchor="middle">Intravenous (IV) fluids</text>
  <text class="hd" x="480" y="24" text-anchor="middle">Organ for transplantation</text>
  <line class="div" x1="320" x2="320" y1="10" y2="320" />

  <!-- IV drip -->
  <line class="stand" x1="60" y1="40" x2="60" y2="210" /><path class="stand" d="M60 44 H118 V54" />
  <path class="bag" d="M92 56 H146 Q152 56 152 64 V132 Q152 148 132 152 H106 Q86 148 86 132 V64 Q86 56 92 56 Z" />
  <path class="fluid" d="M89 92 H149 V132 Q149 145 131 149 H107 Q89 145 89 132 Z" />
  <rect class="chamber" x="111" y="154" width="16" height="24" rx="4" />
  <path class="tube" d="M119 178 C119 220 150 214 168 232 S 180 246 176 246" />
  <text class="lbl" x="160" y="74">sterile saline,</text><text class="lbl" x="160" y="92">isotonic with</text><text class="lbl" x="160" y="110">blood plasma</text>
  <text class="sm" x="160" y="130">(e.g. 0.9 % NaCl)</text>
  <rect class="vein" x="40" y="242" width="250" height="44" rx="22" />
  <text class="sm" x="296" y="300" text-anchor="end">vein</text>
  {rbcs.map(([x, y]) => <g><ellipse class="rbc" cx={x} cy={y} rx="15" ry="11" /><ellipse class="pallor" cx={x} cy={y} rx="6" ry="4.5" /></g>)}
  <text class="lbl" x="40" y="318">red blood cells keep their normal shape</text>

  <!-- organ storage -->
  <rect class="box" x="350" y="38" width="260" height="236" rx="14" />
  <text class="sm" x="480" y="266" text-anchor="middle">insulated box</text>
  {ice.map(([x, y], i) => <rect class="ice" x={(x! - 9).toFixed(1)} y={(y! - 9).toFixed(1)} width="18" height="18" rx="4" transform={`rotate(${(i * 23) % 50} ${x!.toFixed(1)} ${y!.toFixed(1)})`} />)}
  <g transform="translate(0 -46)">
    <path class="pbag" d="M418 136 Q480 122 542 136 Q554 196 542 256 Q480 270 418 256 Q406 196 418 136 Z" />
    <path class="kidney" d="M454 150 C430 150 424 176 430 198 C436 226 456 246 478 238 C496 232 492 214 484 204 C476 194 478 186 488 178 C500 168 488 150 454 150 Z" />
    <path class="ureter" d="M486 190 C504 194 512 206 520 232" />
  </g>
  <path class="lead" d="M590 62 L572 92" /><text class="sm" x="590" y="56" text-anchor="middle">ice</text>
  <text class="lbl" x="480" y="292" text-anchor="middle">donor kidney in a bag of cold</text>
  <text class="lbl" x="480" y="309" text-anchor="middle">isotonic preservation solution</text>
  <text class="lbl" x="480" y="326" text-anchor="middle">cells neither swell nor shrink</text>
</svg>
<style>
  svg { font-family: var(--font-sans); }
  .hd { font-size: 16px; font-weight: 800; fill: var(--text); }
  .lbl { font-size: 14px; fill: var(--text); }
  .sm { font-size: 13px; fill: var(--text-muted); }
  .div { stroke: var(--border-strong); stroke-dasharray: 4 4; }
  .stand { stroke: var(--text-muted); stroke-width: 4; fill: none; stroke-linecap: round; }
  .bag { fill: var(--surface); stroke: var(--text-muted); stroke-width: 2; }
  .fluid { fill: color-mix(in srgb, var(--bio-water) 35%, var(--surface)); }
  .chamber { fill: color-mix(in srgb, var(--bio-water) 25%, var(--surface)); stroke: var(--text-muted); stroke-width: 1.5; }
  .tube { stroke: var(--bio-water); stroke-width: 4; fill: none; stroke-linecap: round; }
  .vein { fill: color-mix(in srgb, var(--bio-k) 18%, var(--surface)); stroke: var(--bio-k); stroke-width: 2; }
  .rbc { fill: var(--bio-k); }
  .pallor { fill: color-mix(in srgb, var(--bio-k) 45%, var(--surface)); }
  .box { fill: var(--surface); stroke: var(--text-muted); stroke-width: 3; }
  .ice { fill: color-mix(in srgb, var(--bio-water) 15%, var(--surface)); stroke: var(--bio-water); stroke-width: 1.5; }
  .pbag { fill: color-mix(in srgb, var(--bio-water) 25%, var(--surface)); stroke: var(--bio-water); stroke-width: 2; }
  .kidney { fill: color-mix(in srgb, var(--bio-chol) 70%, var(--surface)); stroke: var(--bio-chol); stroke-width: 2; }
  .ureter { stroke: var(--bio-glucose); stroke-width: 4; fill: none; stroke-linecap: round; }
  .lead { stroke: var(--text); stroke-width: 1.2; }
</style>
