---
/**
 * Exam-style drawing of a plant (leaf mesophyll) cell from an electron micrograph (A2.2.10, A2.2.11).
 * The cell wall is a thick double line (two plain, unshaded lines); the plasma membrane is a single line pressed against it;
 * the large sap vacuole is pale and bounded by a single line (tonoplast); chloroplasts and mitochondria are
 * outlined twice; the nucleus has a double membrane with pores.
 */
const WO = { x: 70, y: 50, w: 660, h: 420, r: 14 };
const WI = { x: 88, y: 68, w: 624, h: 384, r: 8 };
const PM = { x: 92, y: 72, w: 616, h: 376, r: 6 };
const VAC = { x: 200, y: 150, w: 410, h: 240, r: 40 };

type Chl = { cx: number; cy: number; rx: number; ry: number; rot: number; starch?: [number, number] };
const chls: Chl[] = [
  { cx: 262, cy: 110, rx: 78, ry: 25, rot: 0 },
  { cx: 500, cy: 108, rx: 80, ry: 25, rot: 2, starch: [18, 9] },
  { cx: 420, cy: 422, rx: 80, ry: 23, rot: -2, starch: [20, 7] },
  { cx: 142, cy: 262, rx: 76, ry: 25, rot: 90 },
  { cx: 662, cy: 218, rx: 74, ry: 24, rot: 90 },
];
// grana: stacks of short lines across the chloroplast, joined by single lamellae
const grana = (c: Chl) => {
  const xs = [-0.6, -0.2, 0.2, 0.6].map((f) => f * c.rx);
  const stacks = xs.map((x, i) => {
    const h = (c.ry - 7) * Math.sqrt(1 - (x / (c.rx - 4)) ** 2);
    const n = Math.max(3, Math.min(6, Math.floor((h * 1.5) / 4.2)));
    const y0 = (i % 2 ? 2 : -2) - ((n - 1) * 4.2) / 2;
    return Array.from({ length: n }, (_, k) => `M${(c.cx + x - 9).toFixed(1)} ${(c.cy + y0 + k * 4.2).toFixed(1)} h18`).join(' ');
  });
  const lam = `M${c.cx + xs[0]! + 9} ${c.cy} L${c.cx + xs[1]! - 9} ${c.cy + 2} M${c.cx + xs[1]! + 9} ${c.cy + 2} L${c.cx + xs[2]! - 9} ${c.cy - 2} M${c.cx + xs[2]! + 9} ${c.cy - 2} L${c.cx + xs[3]! - 9} ${c.cy + 2}`;
  return { stacks: stacks.join(' '), lam };
};
const mitos = [{ cx: 652, cy: 104, rx: 28, ry: 12, rot: 18 }, { cx: 246, cy: 422, rx: 30, ry: 12, rot: -4 }];
const cristae = (m: (typeof mitos)[number]) => [-0.5, -0.17, 0.17, 0.5].map((f, i) => {
  const x = m.cx + f * m.rx;
  const h = (m.ry - 4) * Math.sqrt(1 - (f * m.rx / (m.rx - 4)) ** 2);
  return i % 2 ? `M${x.toFixed(1)} ${(m.cy + h).toFixed(1)} v${(-h * 1.3).toFixed(1)}` : `M${x.toFixed(1)} ${(m.cy - h).toFixed(1)} v${(h * 1.3).toFixed(1)}`;
}).join(' ');

const N = { cx: 142, cy: 404, r: 40 };
const pores = [30, 110, 200, 290].map((deg) => {
  const a = (deg * Math.PI) / 180;
  return { x: N.cx + N.r * Math.cos(a), y: N.cy + N.r * Math.sin(a), t: deg + 90 };
});
const golgi = [0, 1, 2].map((i) => `M${630 - 22 + i * 2} ${414 + i * 8} q22 12 44 0`);

// plasmodesmata: membrane-lined channels through the wall
const pdTop = [250, 560];
const pdRight = [330];

const markers: { n: number; x: number; y: number; to: [number, number] }[] = [
  { n: 1, x: 30, y: 150, to: [79, 150] },
  { n: 2, x: 30, y: 196, to: [92, 196] },
  { n: 3, x: 200, y: 22, to: [pdTop[0]! - 3, 58] },
  { n: 4, x: 770, y: 372, to: [588, 336] },
  { n: 5, x: 770, y: 74, to: [VAC.x + VAC.w - 12, VAC.y + 12] },
  { n: 6, x: 30, y: 92, to: [186, 106] },
  { n: 7, x: 318, y: 22, to: [262 - 0.2 * 78 + 4, 104] },
  { n: 8, x: 470, y: 500, to: [441, 432] },
  { n: 9, x: 770, y: 30, to: [670, 98] },
  { n: 10, x: 30, y: 404, to: [N.cx - N.r + 2, N.cy] },
  { n: 11, x: 770, y: 440, to: [653, 424] },
  { n: 12, x: 320, y: 500, to: [318, 432] },
];
const key = [
  'Cell wall (cellulose): strong and freely permeable; resists turgor pressure',
  'Plasma membrane: pressed against the wall; controls entry and exit',
  'Plasmodesma: membrane-lined channel through the wall joining neighbouring cells',
  'Large (sap) vacuole: stores cell sap; keeps the cell turgid',
  'Tonoplast: single membrane around the vacuole',
  'Chloroplast: double membrane; site of photosynthesis',
  'Granum: stack of thylakoids where light is absorbed',
  'Starch grain: stored carbohydrate',
  'Mitochondrion: aerobic respiration (plant cells have both organelles)',
  'Nucleus: double membrane with pores, pushed to the edge',
  'Golgi apparatus: packages proteins and makes some wall polysaccharides',
  'Cytoplasm: thin layer between the vacuole and the membrane',
];
const ell = (cx: number, cy: number, rx: number, ry: number) => `M${cx - rx} ${cy} A${rx} ${ry} 0 1 0 ${cx + rx} ${cy} A${rx} ${ry} 0 1 0 ${cx - rx} ${cy} Z`;
---
<div class="exam-diagram">
  <svg viewBox="0 0 800 520" role="img" aria-labelledby="pem-title pem-desc" xmlns="http://www.w3.org/2000/svg">
    <title id="pem-title">Drawing of a plant leaf cell from an electron micrograph</title>
    <desc id="pem-desc">A box-shaped cell surrounded by a thick cell wall drawn as two plain lines, crossed by plasmodesmata. The plasma membrane lies against the inside of the wall. A large pale sap vacuole bounded by the tonoplast fills the middle, so the cytoplasm forms a thin layer around it containing five chloroplasts with grana and starch grains, two mitochondria with cristae, a small Golgi apparatus and, in one corner, the nucleus with a double membrane, pores and a nucleolus.</desc>
    <!-- neighbouring cells share the wall -->
    <rect class="wall" x="392" y="12" width="16" height="40" />
    <rect class="wall" x="392" y="468" width="16" height="40" />
    <rect class="wall" x="10" y="252" width="62" height="16" />
    <rect class="wall" x="728" y="252" width="62" height="16" />
    <rect class="wall" x={WO.x} y={WO.y} width={WO.w} height={WO.h} rx={WO.r} />
    <rect class="cyto" x={WI.x} y={WI.y} width={WI.w} height={WI.h} rx={WI.r} />
    {pdTop.map((x) => <><rect class="gap" x={x - 4} y={WO.y - 1} width="8" height={WI.y - WO.y + 2} /><path class="pm" d={`M${x - 4} ${WO.y - 4} V${PM.y} M${x + 4} ${WO.y - 4} V${PM.y}`} /></>)}
    {pdRight.map((y) => <><rect class="gap" x={WI.x + WI.w - 1} y={y - 4} width={WO.x + WO.w - WI.x - WI.w + 2} height="8" /><path class="pm" d={`M${PM.x + PM.w} ${y - 4} H${WO.x + WO.w + 4} M${PM.x + PM.w} ${y + 4} H${WO.x + WO.w + 4}`} /></>)}
    <rect class="pm" x={PM.x} y={PM.y} width={PM.w} height={PM.h} rx={PM.r} />
    <rect class="vac" x={VAC.x} y={VAC.y} width={VAC.w} height={VAC.h} rx={VAC.r} />

    {chls.map((c) => {
      const g = grana(c);
      return (
        <g transform={`rotate(${c.rot} ${c.cx} ${c.cy})`}>
          <ellipse class="chl-out" cx={c.cx} cy={c.cy} rx={c.rx} ry={c.ry} />
          <ellipse class="chl-in" cx={c.cx} cy={c.cy} rx={c.rx - 4} ry={c.ry - 4} />
          <path class="lam" d={g.lam} />
          <path class="grana" d={g.stacks} />
          {c.starch && <ellipse class="starch" cx={c.cx + c.starch[0]} cy={c.cy + c.starch[1]} rx="11" ry="6" />}
        </g>
      );
    })}
    {mitos.map((m) => (
      <g transform={`rotate(${m.rot} ${m.cx} ${m.cy})`}>
        <ellipse class="mito-out" cx={m.cx} cy={m.cy} rx={m.rx} ry={m.ry} />
        <ellipse class="mito-in" cx={m.cx} cy={m.cy} rx={m.rx - 4} ry={m.ry - 4} />
        <path class="cristae" d={cristae(m)} />
      </g>
    ))}
    <path class="nucleoplasm" d={ell(N.cx, N.cy, N.r, N.r)} />
    <circle class="nucleolus" cx={N.cx + 6} cy={N.cy - 4} r="11" />
    <path class="dbl-out" d={ell(N.cx, N.cy, N.r, N.r)} />
    <path class="dbl-in" d={ell(N.cx, N.cy, N.r, N.r)} />
    {pores.map((p) => (
      <g transform={`translate(${p.x.toFixed(1)} ${p.y.toFixed(1)}) rotate(${p.t})`}>
        <rect class="pore-gap" x="-5" y="-5" width="10" height="10" />
        <path class="pore-edge" d="M-5 -4.2 v8.4 M5 -4.2 v8.4" />
      </g>
    ))}
    {golgi.map((d) => <><path class="dbl-out golgi" d={d} /><path class="dbl-in" d={d} /></>)}

    <g class="markers">
      {markers.map((m) => (
        <g>
          <path class="lead" d={`M${m.x} ${m.y} L${m.to[0].toFixed(1)} ${m.to[1].toFixed(1)}`} />
          <circle cx={m.x} cy={m.y} r="13" />
          <text x={m.x} y={m.y} dy="0.36em" text-anchor="middle">{m.n}</text>
        </g>
      ))}
    </g>
  </svg>
  <ol class="key">
    {key.map((k) => <li>{k}</li>)}
  </ol>
</div>

<style>
  .exam-diagram svg { font-family: var(--font-sans); }
  .wall { fill: var(--surface); stroke: var(--text); stroke-width: 1.8; }
  .cyto { fill: var(--surface); stroke: var(--text); stroke-width: 1.5; }
  .gap { fill: var(--surface); }
  .pm { fill: none; stroke: var(--bio-head); stroke-width: 2.4; }
  .vac { fill: color-mix(in srgb, var(--bio-water) 8%, var(--surface)); stroke: var(--bio-water); stroke-width: 2.2; }
  .chl-out { fill: color-mix(in srgb, var(--bio-carb) 18%, var(--surface)); stroke: var(--text); stroke-width: 1.7; }
  .chl-in { fill: none; stroke: var(--text); stroke-width: 1.4; }
  .grana { stroke: color-mix(in srgb, var(--bio-carb) 70%, var(--text)); stroke-width: 2.6; fill: none; }
  .lam { stroke: color-mix(in srgb, var(--bio-carb) 70%, var(--text)); stroke-width: 1.2; fill: none; }
  .starch { fill: var(--surface); stroke: var(--text); stroke-width: 1.3; }
  .mito-out { fill: color-mix(in srgb, var(--bio-chol) 22%, var(--surface)); stroke: var(--text); stroke-width: 1.6; }
  .mito-in { fill: none; stroke: var(--text); stroke-width: 1.3; }
  .cristae { stroke: var(--text); stroke-width: 1.4; fill: none; }
  .nucleoplasm { fill: color-mix(in srgb, var(--bio-na) 9%, var(--surface)); }
  .nucleolus { fill: color-mix(in srgb, var(--text) 75%, var(--surface)); }
  .dbl-out { fill: none; stroke: var(--text); stroke-width: 7; stroke-linecap: round; }
  .dbl-out.golgi { stroke: color-mix(in srgb, var(--bio-glucose) 80%, var(--text)); }
  .dbl-in { fill: none; stroke: var(--surface); stroke-width: 3.4; stroke-linecap: round; }
  .pore-gap { fill: color-mix(in srgb, var(--bio-na) 9%, var(--surface)); }
  .pore-edge { stroke: var(--text); stroke-width: 1.7; }
  .markers circle { fill: var(--surface); stroke: var(--text); stroke-width: 1.8; }
  .markers text { font-size: 15px; font-weight: 800; fill: var(--text); }
  .lead { stroke: var(--text); stroke-width: 1.3; }
  .key { columns: 2 17rem; column-gap: var(--space-5); margin: var(--space-3) 0 0; padding: 0; list-style: none; counter-reset: k; font-size: var(--step--1); }
  .key li { break-inside: avoid; margin: 0 0 0.3rem; display: grid; grid-template-columns: 1.7rem 1fr; counter-increment: k; }
  .key li::before { content: counter(k); font-weight: 800; display: inline-grid; place-items: center; width: 1.35rem; height: 1.35rem; border: 1.5px solid var(--text); border-radius: 50%; font-size: 0.75rem; margin-top: 0.1rem; }
</style>
