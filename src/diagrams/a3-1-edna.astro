---
/** Five stages of an environmental DNA (eDNA) barcoding survey, top to bottom. */
const steps = [
  { title: '1  Sample the environment', lines: ['Collect water, soil or even air from the habitat.', 'It holds DNA shed by organisms: skin cells, mucus,', 'faeces, urine, pollen and gametes.'] },
  { title: '2  Extract the DNA', lines: ['Filter the sample, break open the cells and purify', 'the DNA. The result is a mixture of DNA from', 'many different species.'] },
  { title: '3  Copy the barcode region by PCR', lines: ['Primers that bind to conserved sequences either side', 'of a barcode amplify it from every species at once,', 'e.g. COI (animals), 12S (fish), rbcL/matK (plants).'] },
  { title: '4  Sequence the copies', lines: ['High-throughput sequencing reads the base sequence', 'of thousands of barcode copies in one run.', 'Identical reads are grouped together.'] },
  { title: '5  Match to a reference database', lines: ['Each sequence is compared with barcodes from', 'identified specimens. A match names the species;', 'the result is a species list for the habitat.'] },
];
const top = 14;
const H = 116;
const dna = (x: number, y: number, cls: string) => `<path class="${cls}" d="M${x} ${y} q 4 -5 8 0 t 8 0 t 8 0"/>`;
---
<svg viewBox="0 0 520 584" role="img" aria-labelledby="ed-t ed-d" xmlns="http://www.w3.org/2000/svg">
  <title id="ed-t">Identifying species from environmental DNA using barcodes</title>
  <desc id="ed-d">A flow diagram in five stages. One: a water or soil sample is collected from a habitat; it contains DNA shed by organisms. Two: DNA is extracted, giving a mixture from many species. Three: PCR with primers that bind conserved sequences either side of a barcode region copies that region from all the species present. Four: the copies are sequenced. Five: each sequence is matched against a database of barcodes from identified specimens, giving a list of the species that were present.</desc>
  {steps.map((s, i) => (
    <g transform={`translate(0 ${top + i * H})`}>
      <rect class="box" x="10" y="0" width="112" height="92" rx="10" />
      <text class="h" x="140" y="20">{s.title}</text>
      {s.lines.map((l, k) => <text class="t" x="140" y={42 + k * 18}>{l}</text>)}
      {i < steps.length - 1 && <path class="arrow" d="M66 96 L66 110" marker-end="url(#ed-arrow)" />}
    </g>
  ))}
  <defs>
    <marker id="ed-arrow" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path class="head" d="M0 0 L10 5 L0 10 Z" /></marker>
  </defs>

  <!-- 1: pond and sampling bottle -->
  <g transform={`translate(0 ${top})`}>
    <path class="water" d="M18 54 Q 66 40 114 54 L114 84 L18 84 Z" />
    <path class="fish" d="M30 70 q 10 -8 20 0 q -10 8 -20 0 Z M50 70 l 6 -5 l 0 10 Z" />
    <path class="plant" d="M98 84 q -4 -24 2 -40 M104 84 q 4 -20 -2 -34" />
    <rect class="bottle" x="62" y="14" width="22" height="34" rx="4" />
    <rect class="cap" x="66" y="8" width="14" height="7" rx="2" />
    <path class="water" d="M64 32 h18 v13 a3 3 0 0 1 -3 3 h-12 a3 3 0 0 1 -3 -3 Z" />
  </g>
  <!-- 2: tube with mixed DNA -->
  <g transform={`translate(0 ${top + H})`}>
    <path class="tube" d="M50 10 h32 v52 a16 16 0 0 1 -32 0 Z" />
    <Fragment set:html={dna(54, 46, 'd1') + dna(55, 58, 'd2') + dna(54, 70, 'd3') + dna(56, 34, 'd4')} />
  </g>
  <!-- 3: PCR copies of one short region -->
  <g transform={`translate(0 ${top + 2 * H})`}>
    <rect class="long" x="20" y="14" width="92" height="6" rx="3" />
    <rect class="bc" x="50" y="13" width="30" height="8" rx="2" />
    <path class="arrow" d="M66 26 L66 38" marker-end="url(#ed-arrow)" />
    {[0, 1, 2, 3].map((r) => [0, 1, 2].map((c) => <rect class:list={['bc', `c${(r + c) % 3}`]} x={24 + c * 30} y={46 + r * 10} width="24" height="6" rx="2" />))}
  </g>
  <!-- 4: sequence read -->
  <g transform={`translate(0 ${top + 3 * H})`}>
    <text class="seq" x="66" y="34" text-anchor="middle">ACGTTAGC</text>
    <text class="seq" x="66" y="54" text-anchor="middle">ACGTTAGC</text>
    <text class="seq" x="66" y="74" text-anchor="middle">TCGATTGC</text>
  </g>
  <!-- 5: database match -->
  <g transform={`translate(0 ${top + 4 * H})`}>
    <rect class="db" x="24" y="14" width="84" height="64" rx="6" />
    <path class="lead" d="M24 36 h84 M24 57 h84" />
    <text class="dbt" x="32" y="30">ACGTTAGC  ✓</text>
    <text class="dbt" x="32" y="51">TCGATTGC  ✓</text>
    <text class="dbt" x="32" y="72">GGATCCAA</text>
  </g>
</svg>
<style>
  svg { font-family: var(--font-sans); }
  .box { fill: var(--surface); stroke: var(--border-strong); stroke-width: 1.2; }
  .h { font-size: 15px; font-weight: 750; fill: var(--text); }
  .t { font-size: 13.5px; fill: var(--text); }
  .arrow, .lead { stroke: var(--text); stroke-width: 1.6; fill: none; }
  .head { fill: var(--text); }
  .water { fill: color-mix(in srgb, var(--bio-water) 35%, transparent); stroke: var(--bio-water); stroke-width: 1; }
  .fish { fill: var(--bio-head); }
  .plant { stroke: var(--bio-carb); stroke-width: 3; fill: none; stroke-linecap: round; }
  .bottle, .tube { fill: var(--surface); stroke: var(--text); stroke-width: 1.4; }
  .cap { fill: var(--text-muted); }
  svg :global(.d1), svg :global(.d2), svg :global(.d3), svg :global(.d4) { fill: none; stroke-width: 2.6; stroke-linecap: round; }
  svg :global(.d1) { stroke: var(--bio-protein); }
  svg :global(.d2) { stroke: var(--bio-head); }
  svg :global(.d3) { stroke: var(--bio-carb); }
  svg :global(.d4) { stroke: var(--bio-protein-2); }
  .long { fill: var(--border-strong); }
  .bc { fill: var(--bio-protein); }
  .bc.c1 { fill: var(--bio-head); }
  .bc.c2 { fill: var(--bio-carb); }
  .seq { font-family: var(--font-mono); font-size: 14px; font-weight: 700; fill: var(--text); letter-spacing: 1px; }
  .db { fill: var(--surface-2); stroke: var(--text); stroke-width: 1.2; }
  .dbt { font-family: var(--font-mono); font-size: 10.5px; fill: var(--text); }
</style>
