---
/** Arrested succession: grazing on dry land and drainage of a wetland stop the climax developing (D4.2.15). */
const BW = 122, BH = 48, GAP = 26;
const X = (i: number) => 8 + i * (BW + GAP);
const rows = [
  { y: 34, head: 'On dry land', boxes: [['Bare ground'], ['Grasses', 'and herbs'], ['Shrubs', '(scrub)'], ['Woodland', '(climax)']] },
  { y: 226, head: 'In a wetland', boxes: [['Open water'], ['Reed swamp'], ['Fen or bog', '(peat forms)'], ['Wet woodland', '(climax)']] },
];
const branches = [
  { from: 1, y0: 34, label: ['intensive grazing by sheep or cattle:', 'shrub and tree seedlings are eaten'], box: ['Grassland plagioclimax', '(arrested succession)'] },
  { from: 2, y0: 226, label: ['drainage lowers the water table:', 'peat dries out and decomposes'], box: ['Farmland: crops or pasture', '(wetland never matures)'] },
];
---
<svg viewBox="0 0 600 400" role="img" aria-labelledby="d42r-t d42r-d" xmlns="http://www.w3.org/2000/svg">
  <title id="d42r-t">Human activities that arrest succession</title>
  <desc id="d42r-d">Top row, on dry land: bare ground, then grasses and herbs, then shrubs, then woodland as the climax. A branch from grasses and herbs shows that intensive grazing by sheep or cattle eats shrub and tree seedlings, so grassland persists as a plagioclimax: arrested succession. Bottom row, in a wetland: open water, then reed swamp, then fen or bog where peat forms, then wet woodland as the climax. A branch from fen or bog shows that drainage lowers the water table, so the peat dries out and decomposes and the land becomes farmland, and the wetland community never matures.</desc>
  <defs><marker id="d42r-a" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="8" markerHeight="8" orient="auto"><path d="M0 0 L10 5 L0 10 z" class="hd" /></marker>
  <marker id="d42r-b" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="8" markerHeight="8" orient="auto"><path d="M0 0 L10 5 L0 10 z" class="hb" /></marker></defs>
  {rows.map((r) => (
    <g>
      <text class="rh" x="8" y={r.y - 12}>{r.head}</text>
      {r.boxes.map((b, i) => (
        <g>
          <rect class={`box ${i === 3 ? 'climax' : ''}`} x={X(i)} y={r.y} width={BW} height={BH} rx="9" />
          {b.map((s, k) => <text class={k === 0 ? 'n' : 's'} x={X(i) + BW / 2} y={r.y + (b.length === 1 ? 29 : 21 + k * 17)} text-anchor="middle">{s}</text>)}
          {i < 3 && <path class="arr" d={`M${X(i) + BW + 1} ${r.y + BH / 2} L${X(i + 1) - 3} ${r.y + BH / 2}`} marker-end="url(#d42r-a)" />}
        </g>
      ))}
    </g>
  ))}
  {branches.map((b) => {
    const x = X(b.from) + BW / 2, y1 = b.y0 + BH, y2 = b.y0 + BH + 70;
    return (
      <g>
        <path class="arr bad" d={`M${x} ${y1 + 2} L${x} ${y2 - 3}`} marker-end="url(#d42r-b)" />
        {b.label.map((s, k) => <text class="bl" x={x + 10} y={y1 + 28 + k * 16}>{s}</text>)}
        <rect class="box plagio" x={x - 100} y={y2} width="200" height={BH} rx="9" />
        {b.box.map((s, k) => <text class={k === 0 ? 'n' : 's'} x={x} y={y2 + 21 + k * 17} text-anchor="middle">{s}</text>)}
      </g>
    );
  })}
</svg>
<style>
  svg { font-family: var(--font-sans); }
  .rh { font-size: 14px; font-weight: 800; fill: var(--text); }
  .box { fill: color-mix(in srgb, var(--bio-carb) 10%, var(--surface)); stroke: var(--bio-carb); stroke-width: 1.5; }
  .box.climax { fill: color-mix(in srgb, var(--bio-carb) 26%, var(--surface)); stroke-width: 2.4; }
  .box.plagio { fill: color-mix(in srgb, var(--bad) 9%, var(--surface)); stroke: var(--bad); }
  .n { font-size: 13px; font-weight: 750; fill: var(--text); }
  .s { font-size: 12px; fill: var(--text-muted); }
  .arr { stroke: var(--text-muted); stroke-width: 2.2; fill: none; }
  .arr.bad { stroke: var(--bad); stroke-width: 2.6; }
  .hd { fill: var(--text-muted); }
  .hb { fill: var(--bad); }
  .bl { font-size: 12.5px; font-weight: 650; fill: var(--text); }
</style>
