---
/**
 * A1.1.8 (AHL): the Goldilocks (habitable) zone of the Solar System. Planet distances in AU and mean
 * surface temperatures are standard values. The zone shown (≈0.95–1.67 AU) follows recent climate-model
 * estimates for the Sun; published boundaries vary, so the edges are drawn soft.
 */
const ax = (au: number) => 56 + au * 250; // 0 … 1.8 AU
const planets = [
  { n: 'Venus', au: 0.72, r: 9, t: '464 °C', w: 'too hot: water lost', cls: 'venus', y: 136 },
  { n: 'Earth', au: 1.0, r: 9.5, t: '15 °C', w: 'liquid oceans', cls: 'earth', y: 178 },
  { n: 'Mars', au: 1.52, r: 6, t: '−63 °C', w: 'mostly ice; thin air', cls: 'mars', y: 136 },
];
---
<svg viewBox="0 0 520 272" role="img" aria-labelledby="gz-t gz-d" xmlns="http://www.w3.org/2000/svg">
  <title id="gz-t">The Goldilocks zone around the Sun</title>
  <desc id="gz-d">A scale of distance from the Sun. A shaded band from about 0.95 to 1.67 astronomical units is the Goldilocks zone, where a planet with a suitable atmosphere could have liquid water on its surface. Venus, at 0.72 AU, is closer than the zone and has a mean surface temperature of 464 °C, so its water has been lost. Earth, at 1.00 AU, has a mean temperature of about 15 °C and liquid oceans. Mars, at 1.52 AU, is near the outer edge but small, with a thin atmosphere and a mean temperature of about −63 °C, so its water is mostly frozen.</desc>
  <defs>
    <linearGradient id="gz-band" x1="0" x2="1" y1="0" y2="0">
      <stop offset="0" class="stop" stop-opacity="0" />
      <stop offset="0.12" class="stop" stop-opacity="0.28" />
      <stop offset="0.88" class="stop" stop-opacity="0.28" />
      <stop offset="1" class="stop" stop-opacity="0" />
    </linearGradient>
  </defs>
  <rect x={ax(0.88)} y="20" width={ax(1.74) - ax(0.88)} height="180" fill="url(#gz-band)" />
  <text class="zone" x={ax(1.31)} y="40" text-anchor="middle">Goldilocks zone</text>
  <text class="zsub" x={ax(1.31)} y="58" text-anchor="middle">liquid water possible on the surface</text>
  <circle class="sun" cx="0" cy="104" r="44" />
  <text class="lbl" x="8" y="166">Sun</text>
  <line class="orbit" x1="44" x2={ax(1.8)} y1="104" y2="104" />
  {planets.map((p) => (
    <>
      <circle class={`planet ${p.cls}`} cx={ax(p.au)} cy="104" r={p.r} />
      <text class="lbl" x={ax(p.au)} y="84" text-anchor="middle">{p.n}</text>
      <line class="lead" x1={ax(p.au)} x2={ax(p.au)} y1={104 + p.r + 2} y2={p.y - 13} />
      <text class="temp" x={ax(p.au)} y={p.y} text-anchor="middle">{p.t}</text>
      <text class="sm" x={ax(p.au)} y={p.y + 16} text-anchor="middle">{p.w}</text>
    </>
  ))}
  <g class="axis">
    <line x1="56" x2={ax(1.8)} y1="216" y2="216" />
    {[0.2, 0.4, 0.6, 0.8, 1, 1.2, 1.4, 1.6, 1.8].map((v) => <><line x1={ax(v)} x2={ax(v)} y1="216" y2="221" /><text x={ax(v)} y="235" text-anchor="middle">{v}</text></>)}
    <text x={ax(0.95)} y="258" text-anchor="middle">distance from the Sun (AU); mean surface temperature shown</text>
  </g>
</svg>
<style>
  svg { font-family: var(--font-sans); }
  .sun { fill: var(--bio-glucose); }
  .stop { stop-color: var(--bio-carb); }
  .orbit { stroke: var(--border-strong); stroke-width: 1.4; stroke-dasharray: 2 4; }
  .planet.venus { fill: var(--bio-head); }
  .planet.earth { fill: var(--bio-water); }
  .planet.mars { fill: var(--bio-k); }
  .zone { font-size: 15px; font-weight: 800; fill: var(--text); }
  .zsub { font-size: 13px; fill: var(--text); }
  .lbl { font-size: 14px; font-weight: 700; fill: var(--text); }
  .temp { font-size: 13px; font-weight: 700; fill: var(--text); }
  .sm { font-size: 12px; fill: var(--text-muted); }
  .lead { stroke: var(--border-strong); stroke-width: 1.2; }
  .axis line { stroke: var(--text-muted); stroke-width: 1.3; }
  .axis text { font-size: 12px; fill: var(--text-muted); }
</style>
