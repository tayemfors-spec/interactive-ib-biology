---
/**
 * Exam-style diagrams of the four phases of mitosis (D2.1.7–D2.1.8) in an animal cell with 2n = 4
 * (long and short homologous pairs; red = maternal, blue = paternal, matching the 3D model).
 * Labels are HTML text under each drawing so they stay legible at phone width.
 */
type V = [number, number];
const ARM = { L: 22, S: 12 };
/** A chromatid: two arms from centromere c along ±u, swung towards w by angle b (radians). */
const chromatid = (c: V, u: V, w: V, b: number, len: number) => {
  const tip = (k: number): V => [c[0] + len * (k * u[0] * Math.cos(b) + w[0] * Math.sin(b)), c[1] + len * (k * u[1] * Math.cos(b) + w[1] * Math.sin(b))];
  const [a, z] = [tip(1), tip(-1)];
  return `M${a[0].toFixed(1)} ${a[1].toFixed(1)} L${c[0].toFixed(1)} ${c[1].toFixed(1)} L${z[0].toFixed(1)} ${z[1].toFixed(1)}`;
};
const norm = (v: V): V => { const l = Math.hypot(v[0], v[1]); return [v[0] / l, v[1] / l]; };
type Ch = { t: 'L' | 'S'; col: 'm' | 'p' };
const SET: Ch[] = [{ t: 'L', col: 'm' }, { t: 'S', col: 'p' }, { t: 'L', col: 'p' }, { t: 'S', col: 'm' }];

// prophase: X-shaped replicated chromosomes inside the old nucleus
const pro: { c: V; u: V }[] = [
  { c: [88, 92], u: norm([0.4, 1]) }, { c: [140, 128], u: norm([1, 0.3]) }, { c: [132, 82], u: norm([-0.5, 1]) }, { c: [86, 140], u: norm([1, -0.2]) },
];
const proPaths = SET.flatMap((ch, i) => {
  const { c, u } = pro[i]!;
  const v: V = [-u[1], u[0]];
  return [-1, 1].map((s) => ({ col: ch.col, d: chromatid([c[0] + s * 4.6 * v[0], c[1] + s * 4.6 * v[1]], u, [s * v[0], s * v[1]], 0.32, ARM[ch.t]) }));
});
// metaphase: centromeres on the equator (x = 110)
const metaY = [49, 89, 129, 169];
const metaU: V[] = [norm([0.55, 1]), norm([-0.55, 1]), norm([0.55, 1]), norm([-0.55, 1])];
const metaPaths = SET.flatMap((ch, i) => [-1, 1].map((s) => ({ col: ch.col, d: chromatid([110 + s * 4.6, metaY[i]!], metaU[i]!, [s, 0], 0.08, ARM[ch.t]) })));
const metaCen = metaY.flatMap((y) => [[105.4, y], [114.6, y]] as V[]);
// anaphase: separated chromatids (now chromosomes) moving to the poles, arms trailing
const anaY = [62, 94, 124, 156];
const anaPaths = SET.flatMap((ch, i) => [-1, 1].map((s) => ({ col: ch.col, d: chromatid([110 + s * 56, anaY[i]!], [0, 1], [-s, 0], 0.75, ARM[ch.t]) })));
const anaCen = anaY.flatMap((y) => [[54, y], [166, y]] as V[]);
// telophase: chromosomes decondensing inside re-forming nuclei
const teloPaths = [-1, 1].flatMap((s) => SET.map((ch, i) => {
  const cx = 110 + s * 56, cy = 96 + (i - 1.5) * 9;
  const n = ch.t === 'L' ? 5 : 3;
  let d = `M${cx - 16} ${cy}`;
  for (let k = 1; k <= n; k++) d += ` q 3 ${k % 2 ? -7 : 7} ${32 / n} 0`;
  return { col: ch.col, d };
}));
const phases = [
  { id: 'pro', name: 'Prophase', look: ['Chromosomes visible: condensed by supercoiling, each two sister chromatids joined at a centromere', 'Nuclear membrane breaking down; nucleolus gone', 'Centrosomes moving to opposite poles; spindle forming'] },
  { id: 'meta', name: 'Metaphase', look: ['Chromosomes lined up on the equator', 'Spindle microtubules from each pole attached to the centromere of every chromosome', 'No nuclear membrane'] },
  { id: 'ana', name: 'Anaphase', look: ['Centromeres divide: sister chromatids separate and become chromosomes', 'Pulled to opposite poles by shortening spindle microtubules, centromere first (V shapes)', 'Identical sets at each pole'] },
  { id: 'telo', name: 'Telophase', look: ['A set of chromosomes at each pole', 'Nuclear membranes re-form; chromosomes decondense', 'Usually followed by cytokinesis (cleavage furrow in animal cells)'] },
];
---
<div class="exam-diagram mit">
  <div class="panels">
    {phases.map((p) => (
      <div class="panel">
        <svg viewBox="0 0 220 210" role="img" aria-labelledby={`mit-${p.id}-t`} xmlns="http://www.w3.org/2000/svg">
          <title id={`mit-${p.id}-t`}>{p.name}: {p.look.join('; ')}.</title>
          {p.id === 'pro' && (
            <>
              <circle class="cell" cx="110" cy="105" r="90" />
              <circle class="nuc broken" cx="110" cy="110" r="56" />
              <path class="mt" d="M84 26 l-16 -4 M84 26 l-12 10 M84 26 l4 -14 M136 26 l16 -4 M136 26 l12 10 M136 26 l-4 -14 M84 26 Q110 12 136 26" />
              <circle class="cs" cx="84" cy="26" r="5" /><circle class="cs" cx="136" cy="26" r="5" />
              {proPaths.map((c) => <path class:list={['chr', c.col]} d={c.d} />)}
              {pro.map(({ c }) => <circle class="cen" cx={c[0]} cy={c[1]} r="3.2" />)}
            </>
          )}
          {p.id === 'meta' && (
            <>
              <ellipse class="cell" cx="110" cy="108" rx="100" ry="94" />
              <path class="eq" d="M110 16 V200" />
              {metaCen.map(([x, y]) => <path class="mt" d={`M${x < 110 ? 24 : 196} 109 L${x} ${y}`} />)}
              <path class="mt faint" d="M24 109 L104 70 M24 109 L104 160 M196 109 L116 70 M196 109 L116 160 M24 109 l-12 -8 M24 109 l-12 8 M196 109 l12 -8 M196 109 l12 8" />
              <circle class="cs" cx="24" cy="109" r="5" /><circle class="cs" cx="196" cy="109" r="5" />
              {metaPaths.map((c) => <path class:list={['chr', c.col]} d={c.d} />)}
              {metaCen.map(([x, y]) => <circle class="cen" cx={x} cy={y} r="3" />)}
            </>
          )}
          {p.id === 'ana' && (
            <>
              <ellipse class="cell" cx="110" cy="110" rx="104" ry="80" />
              {anaCen.map(([x, y]) => <path class="mt" d={`M${x < 110 ? 16 : 204} 110 L${x} ${y}`} />)}
              <path class="mt faint" d="M16 110 L120 90 M16 110 L120 130 M204 110 L100 90 M204 110 L100 130" />
              <circle class="cs" cx="16" cy="110" r="5" /><circle class="cs" cx="204" cy="110" r="5" />
              {anaPaths.map((c) => <path class:list={['chr', c.col]} d={c.d} />)}
              {anaCen.map(([x, y]) => <circle class="cen" cx={x} cy={y} r="3" />)}
              <path class="arrow" d="M96 186 H66 M66 186 l7 -5 M66 186 l7 5 M124 186 H154 M154 186 l-7 -5 M154 186 l-7 5" />
            </>
          )}
          {p.id === 'telo' && (
            <>
              <path class="cell" d="M110 40 C 92 14, 6 18, 6 100 C 6 182, 92 186, 110 160 C 128 186, 214 182, 214 100 C 214 18, 128 14, 110 40 Z" />
              <circle class="nuc" cx="54" cy="96" r="34" /><circle class="nuc" cx="166" cy="96" r="34" />
              {teloPaths.map((c) => <path class:list={['thread', c.col]} d={c.d} />)}
              <path class="arrow" d="M110 18 V36 M110 36 l-5 -7 M110 36 l5 -7 M110 186 V166 M110 166 l-5 7 M110 166 l5 7" />
            </>
          )}
        </svg>
        <p class="pname">{p.name}</p>
        <ul>{p.look.map((l) => <li>{l}</li>)}</ul>
      </div>
    ))}
  </div>
  <p class="keyline"><span class="sw m"></span> maternal and <span class="sw p"></span> paternal chromosomes (2n = 4) · <span class="sw cen"></span> centromere · <span class="sw mt"></span> spindle microtubules · <span class="sw cs"></span> centrosome</p>
</div>

<style>
  .mit .panels { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-3) var(--space-4); }
  .mit svg { display: block; width: 100%; height: auto; }
  .pname { font-weight: 800; margin: var(--space-1) 0 0; }
  .mit ul { margin: var(--space-1) 0 0; padding-left: 1.05rem; font-size: 0.82rem; color: var(--text-muted); }
  .mit li { margin: 0.1rem 0; }
  .cell { fill: color-mix(in srgb, var(--bio-head) 8%, var(--surface)); stroke: var(--bio-head); stroke-width: 2.2; }
  .nuc { fill: none; stroke: var(--text-muted); stroke-width: 1.8; }
  .nuc.broken { stroke-dasharray: 10 8; }
  .eq { stroke: var(--text-muted); stroke-width: 1.2; stroke-dasharray: 4 4; }
  .mt { stroke: var(--bio-carb); stroke-width: 1.5; fill: none; }
  .mt.faint { opacity: 0.6; }
  .cs { fill: var(--bio-glucose); stroke: var(--text); stroke-width: 1; }
  .chr { fill: none; stroke-width: 8.5; stroke-linecap: round; stroke-linejoin: round; }
  .thread { fill: none; stroke-width: 2.4; stroke-linecap: round; }
  .m { stroke: var(--bio-k); }
  .p { stroke: var(--bio-protein); }
  .cen { fill: var(--text); }
  .arrow { stroke: var(--text); stroke-width: 1.8; fill: none; }
  .keyline { font-size: 0.82rem; color: var(--text-muted); margin: var(--space-3) 0 0; }
  .sw { display: inline-block; width: 0.9em; height: 0.9em; border-radius: 3px; vertical-align: -0.1em; }
  .sw.m { background: var(--bio-k); }
  .sw.p { background: var(--bio-protein); }
  .sw.cen { background: var(--text); border-radius: 50%; width: 0.6em; height: 0.6em; }
  .sw.mt { background: var(--bio-carb); height: 0.25em; vertical-align: 0.2em; }
  .sw.cs { background: var(--bio-glucose); border-radius: 50%; }
</style>
