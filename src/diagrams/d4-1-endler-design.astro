---
/**
 * D4.1.8: design of John Endler's guppy experiments. Greenhouse experiment (Endler 1980): one varied stock,
 * ten pools, a common predator-free start, then pike cichlid (Crenicichla) in four pools, Rivulus hartii in four,
 * and two predator-free control pools; censuses about 5 and 14 months later. Field transplant (1976): guppies
 * from a high-predation site moved to a guppy-free stream above a waterfall with only Rivulus.
 */
const pool = (n: number) => Array.from({ length: n });
---
<div class="endler">
  <p class="head">Greenhouse experiment</p>
  <ol class="stages">
    <li>
      <strong>1 · One varied stock</strong>
      <span>Guppies collected from many different streams were mixed, so the males varied widely in colour pattern.</span>
    </li>
    <li>
      <strong>2 · Ten similar pools, no predators</strong>
      <span>The fish bred for about six months in ten pools with the same gravel, plants and light. Same start for every pool.</span>
      <div class="pools" aria-hidden="true">{pool(10).map(() => <span class="pool"></span>)}</div>
    </li>
    <li>
      <strong>3 · Predators added (independent variable)</strong>
      <div class="treat">
        <div class="t t-c"><b>4 pools + pike cichlid</b><span>strong predator of adult guppies</span><span class="res">fewer, smaller spots</span></div>
        <div class="t t-r"><b>4 pools + <i>Rivulus</i></b><span>weak predator, mostly of juveniles</span><span class="res">more spots</span></div>
        <div class="t t-n"><b>2 pools, no predator</b><span>control</span><span class="res">more spots</span></div>
      </div>
    </li>
    <li>
      <strong>4 · Measure the males (dependent variable)</strong>
      <span>Number and size of colour spots on every male in each pool, counted at two census dates about 5 and 14 months after the predators were added. Several replicate pools per treatment show whether differences are consistent.</span>
    </li>
  </ol>
  <p class="head">Field transplant</p>
  <div class="field">
    <div class="site"><b>High-predation site</b><span>pike cichlids present; males dull</span></div>
    <span class="go" aria-hidden="true">→</span>
    <div class="site"><b>Stream above a waterfall</b><span>no guppies before; only <i>Rivulus</i></span></div>
    <span class="go" aria-hidden="true">→</span>
    <div class="site out"><b>About 2 years later</b><span>males had more and larger spots, like low-predation populations</span></div>
  </div>
</div>
<style>
  .endler { font-size: var(--step--1); display: grid; gap: var(--space-2); }
  .head { margin: var(--space-1) 0 0; font-weight: 800; color: var(--text); }
  .stages { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-2); }
  .stages li { margin: 0; padding: var(--space-2) var(--space-3); background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-m); color: var(--text-muted); }
  .stages strong { display: block; color: var(--text); }
  .pools { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: var(--space-2); }
  .pool { width: 1.6rem; height: 1rem; border-radius: 50%; background: color-mix(in srgb, var(--bio-water) 35%, var(--surface)); border: 1.5px solid var(--bio-water); }
  .treat { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); gap: var(--space-2); margin-top: var(--space-2); }
  .t { display: grid; gap: 0.15rem; padding: var(--space-2); border-radius: var(--radius-s); border: 2px solid; background: var(--surface-2); }
  .t b { color: var(--text); }
  .t-c { border-color: var(--bio-k); }
  .t-r { border-color: var(--bio-protein); border-style: dashed; }
  .t-n { border-color: var(--text-muted); border-style: dotted; }
  .res { font-weight: 750; color: var(--text); }
  .res::before { content: 'Result: '; font-weight: 600; color: var(--text-muted); }
  .field { display: grid; grid-template-columns: 1fr auto 1fr auto 1fr; gap: var(--space-2); align-items: center; }
  .site { display: grid; gap: 0.15rem; padding: var(--space-2); background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-m); color: var(--text-muted); height: 100%; }
  .site b { color: var(--text); }
  .site.out { border-color: var(--bio-carb); border-width: 2px; }
  .go { font-size: 1.3rem; font-weight: 800; color: var(--text-muted); }
  @media (max-width: 36rem) { .field { grid-template-columns: 1fr; } .go { transform: rotate(90deg); justify-self: center; } }
</style>
