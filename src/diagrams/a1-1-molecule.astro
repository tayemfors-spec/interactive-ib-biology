---
/**
 * Exam-style drawing for A1.1.2: five water molecules with partial charges (δ+ on each H, δ− on each O)
 * and dashed hydrogen bonds from a δ+ hydrogen of one molecule to the δ− oxygen of another.
 * The central molecule donates two hydrogen bonds and accepts two, so it is bonded to four neighbours.
 * Geometry: O–H drawn 52 units long at 104.5°; hydrogen bonds 70 units (longer than covalent bonds).
 */
const L = 52;
const HB = 70;
const HALF = 104.5 / 2;
const rad = (d: number) => (d * Math.PI) / 180;
const pt = (x: number, y: number, ang: number, r: number): [number, number] => [x + r * Math.cos(rad(ang)), y + r * Math.sin(rad(ang))];

interface Mol { o: [number, number]; hAng: [number, number]; dm: number }
// bisector angle b (towards the H atoms; SVG angles, 0 = right, 90 = down) gives H at b ± 52.25°
const mol = (o: [number, number], b: number, dm: number): Mol => ({ o, hAng: [b - HALF, b + HALF], dm });
const O0: [number, number] = [300, 190];
const m0 = mol(O0, 90, -90);
const H0a = pt(...O0, 90 - HALF, L);
const H0b = pt(...O0, 90 + HALF, L);
const O1 = pt(...H0a, 90 - HALF, HB);
const O2 = pt(...H0b, 90 + HALF, HB);
const m1 = mol(O1, 90 - HALF, 160);
const m2 = mol(O2, 90 + HALF, 20);
// molecules 3 and 4 donate to the central oxygen, approaching from its lone-pair side
const H3 = pt(...O0, -125, HB);
const O3 = pt(...H3, -125, L);
const H4 = pt(...O0, -55, HB);
const O4 = pt(...H4, -55, L);
const m3 = mol(O3, 55 + HALF, -72.75);
const m4 = mol(O4, 125 - HALF, -107.25);
const mols = [m0, m1, m2, m3, m4];

const hOf = (m: Mol) => m.hAng.map((a) => pt(...m.o, a, L));
// δ+ sits beside each H, on the side away from the molecule's other H
const dPlus = (m: Mol) => m.hAng.map((a, k) => pt(...pt(...m.o, a, L), a + (k === 0 ? -90 : 90), 23));
const dMinus = (m: Mol) => pt(...m.o, m.dm, 32);
const hbonds: [[number, number], [number, number]][] = [[H0a, O1], [H0b, O2], [H3, O0], [H4, O0]];
const shorten = ([a, b]: [[number, number], [number, number]], s0: number, s1: number) => {
  const d = Math.hypot(b[0] - a[0], b[1] - a[1]);
  const ux = (b[0] - a[0]) / d, uy = (b[1] - a[1]) / d;
  return [a[0] + ux * s0, a[1] + uy * s0, b[0] - ux * s1, b[1] - uy * s1].map((v) => v.toFixed(1));
};
const arc = (() => {
  const r = 24;
  const [x1, y1] = pt(...O0, 90 - HALF, r);
  const [x2, y2] = pt(...O0, 90 + HALF, r);
  return `M${x1.toFixed(1)} ${y1.toFixed(1)} A${r} ${r} 0 0 1 ${x2.toFixed(1)} ${y2.toFixed(1)}`;
})();
const bondMid = (m: Mol, k: number) => pt(...m.o, m.hAng[k]!, L / 2);
const hbMid = pt(...H0a, 90 - HALF, HB / 2);
const markers: { n: number; x: number; y: number; to: [number, number] }[] = [
  { n: 1, x: 160, y: 50, to: bondMid(m3, 1) },
  { n: 2, x: 326, y: 266, to: hbMid },
  { n: 3, x: 300, y: 296, to: [300, 216] },
];
const key = [
  'Polar covalent bond within a molecule: the shared electrons are pulled towards O',
  'Hydrogen bond (dashed) between molecules: δ+ H of one molecule to δ− O of another',
  'Bond angle ≈ 104.5°: the bent shape keeps δ+ and δ− on opposite sides',
];
const f = (n: number) => n.toFixed(1);
---
<div class="exam-diagram">
  <svg viewBox="136 26 344 316" role="img" aria-labelledby="w-title w-desc" xmlns="http://www.w3.org/2000/svg">
    <title id="w-title">Hydrogen bonds between water molecules</title>
    <desc id="w-desc">Five bent water molecules. Each oxygen is labelled δ− and each hydrogen δ+. Covalent bonds inside each molecule are solid lines. Dashed hydrogen bonds join a δ+ hydrogen of one molecule to the δ− oxygen of another. The central molecule forms four hydrogen bonds: two from its own hydrogens and two to its oxygen.</desc>

    <g class="hb">
      {hbonds.map((b) => { const [x1, y1, x2, y2] = shorten(b, 14, 19); return <line x1={x1} y1={y1} x2={x2} y2={y2} />; })}
    </g>
    <path class="arc" d={arc} />

    {mols.map((m) => (
      <g class="mol">
        {hOf(m).map(([x, y]) => <line class="cov" x1={f(m.o[0])} y1={f(m.o[1])} x2={f(x)} y2={f(y)} />)}
        <circle class="o" cx={f(m.o[0])} cy={f(m.o[1])} r="17" />
        <text class="atom" x={f(m.o[0])} y={f(m.o[1])} dy="0.36em" text-anchor="middle">O</text>
        {hOf(m).map(([x, y]) => (
          <>
            <circle class="h" cx={f(x)} cy={f(y)} r="12" />
            <text class="atom small" x={f(x)} y={f(y)} dy="0.36em" text-anchor="middle">H</text>
          </>
        ))}
        {dPlus(m).map(([x, y]) => <text class="delta" x={f(x)} y={f(y)} dy="0.36em" text-anchor="middle">δ<tspan class="sign" dy="-0.45em">+</tspan></text>)}
        <text class="delta" x={f(dMinus(m)[0])} y={f(dMinus(m)[1])} dy="0.36em" text-anchor="middle">δ<tspan class="sign" dy="-0.45em">−</tspan></text>
      </g>
    ))}

    <g class="markers">
      {markers.map((m) => (
        <g>
          <path class="lead" d={`M${m.x} ${m.y} L${f(m.to[0])} ${f(m.to[1])}`} />
          <circle cx={m.x} cy={m.y} r="12" />
          <text x={m.x} y={m.y} dy="0.36em" text-anchor="middle">{m.n}</text>
        </g>
      ))}
    </g>
  </svg>
  <ol class="key">
    {key.map((k) => <li>{k}</li>)}
  </ol>
</div>

<style>
  .exam-diagram svg { font-family: var(--font-sans); max-width: 34rem; margin-inline: auto; }
  .cov { stroke: var(--text); stroke-width: 3.2; stroke-linecap: round; }
  .hb line { stroke: var(--text); stroke-width: 2.4; stroke-dasharray: 6 5; }
  .o { fill: color-mix(in srgb, var(--bio-k) 30%, var(--surface)); stroke: var(--bio-k); stroke-width: 2.4; }
  .h { fill: var(--surface); stroke: var(--text-muted); stroke-width: 2; }
  .atom { font-size: 18px; font-weight: 800; fill: var(--text); }
  .atom.small { font-size: 14px; }
  .delta { font-size: 17px; font-weight: 700; font-style: italic; fill: var(--text); }
  .sign { font-size: 13px; font-style: normal; }
  .arc { fill: none; stroke: var(--text-muted); stroke-width: 1.6; }
  .markers circle { fill: var(--surface); stroke: var(--text); stroke-width: 1.6; }
  .markers text { font-size: 13px; font-weight: 800; fill: var(--text); }
  .lead { stroke: var(--text-muted); stroke-width: 1.2; }
  .key { margin: var(--space-3) 0 0; padding-bottom: 3rem !important; padding: 0; list-style: none; counter-reset: k; font-size: var(--step--1); max-width: 40rem; }
  .key li { margin: 0 0 0.3rem; display: grid; grid-template-columns: 1.7rem 1fr; counter-increment: k; }
  .key li::before { content: counter(k); font-weight: 800; display: inline-grid; place-items: center; width: 1.35rem; height: 1.35rem; border: 1.5px solid var(--text); border-radius: 50%; font-size: 0.75rem; margin-top: 0.1rem; }
</style>
