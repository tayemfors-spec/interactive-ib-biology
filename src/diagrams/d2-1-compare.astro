---
/** Mitosis vs meiosis outcomes from the same 2n = 4 cell — D2.1.4 / D2.1.9. Chromosomes drawn unreplicated (one chromatid). */
type Bar = { t: 'L' | 'S'; c: 'm' | 'p'; tip?: 'm' | 'p' };
const H = { L: 34, S: 20 };
const bars = (set: Bar[], cx: number, cy: number) => set.map((b, i) => ({ ...b, x: cx - (set.length * 11) / 2 + i * 11 + 2, y: cy - H[b.t] / 2 }));
const full: Bar[] = [{ t: 'L', c: 'm' }, { t: 'L', c: 'p' }, { t: 'S', c: 'm' }, { t: 'S', c: 'p' }];
const gametes: Bar[][] = [
  [{ t: 'L', c: 'm' }, { t: 'S', c: 'p' }],
  [{ t: 'L', c: 'm', tip: 'p' }, { t: 'S', c: 'p', tip: 'm' }],
  [{ t: 'L', c: 'p' }, { t: 'S', c: 'm' }],
  [{ t: 'L', c: 'p', tip: 'm' }, { t: 'S', c: 'm', tip: 'p' }],
];
const gx = [42, 114, 186, 258];
---
<div class="dfig">
  <div class="pair">
    <svg viewBox="0 0 300 270" role="img" aria-labelledby="cmp-a-t cmp-a-d" xmlns="http://www.w3.org/2000/svg">
      <title id="cmp-a-t">Outcome of mitosis</title>
      <desc id="cmp-a-d">A diploid cell with four chromosomes (2n = 4: a long and a short pair, one of each pair maternal and one paternal) divides by mitosis into two diploid cells, each with the same four chromosomes as the parent: genetically identical.</desc>
      <text class="h" x="150" y="22" text-anchor="middle">Mitosis</text>
      <circle class="cell" cx="150" cy="80" r="44" />
      {bars(full, 150, 80).map((b) => <><rect class:list={['bar', b.c]} x={b.x} y={b.y} width="7" height={H[b.t]} rx="3.5" /></>)}
      <text class="s" x="206" y="84">2n = 4</text>
      <path class="arrow" d="M130 128 L96 160 M96 160 l2 -9 M96 160 l9 -2 M170 128 L204 160 M204 160 l-2 -9 M204 160 l-9 -2" />
      {[84, 216].map((cx) => (
        <>
          <circle class="cell" cx={cx} cy="206" r="40" />
          {bars(full, cx, 206).map((b) => <rect class:list={['bar', b.c]} x={b.x} y={b.y} width="7" height={H[b.t]} rx="3.5" />)}
          <text class="s" x={cx} y="262" text-anchor="middle">2n = 4</text>
        </>
      ))}
      <text class="t" x="150" y="150" text-anchor="middle">identical</text>
    </svg>
    <svg viewBox="0 0 300 270" role="img" aria-labelledby="cmp-b-t cmp-b-d" xmlns="http://www.w3.org/2000/svg">
      <title id="cmp-b-t">Outcome of meiosis</title>
      <desc id="cmp-b-d">The same diploid cell divides by meiosis into four haploid cells, each with two chromosomes (n = 2): one long and one short. Because of random orientation and crossing over, the four cells have different combinations of maternal and paternal chromosomes and of chromosome segments.</desc>
      <text class="h" x="150" y="22" text-anchor="middle">Meiosis</text>
      <circle class="cell" cx="150" cy="80" r="44" />
      {bars(full, 150, 80).map((b) => <rect class:list={['bar', b.c]} x={b.x} y={b.y} width="7" height={H[b.t]} rx="3.5" />)}
      <text class="s" x="206" y="84">2n = 4</text>
      <path class="arrow" d="M150 128 V150 M150 150 l-5 -7 M150 150 l5 -7" />
      <text class="s" x="160" y="146">two divisions</text>
      {gametes.map((g, i) => (
        <>
          <circle class="cell" cx={gx[i]} cy="198" r="31" />
          {bars(g, gx[i]!, 198).map((b) => (
            <>
              <rect class:list={['bar', b.c]} x={b.x} y={b.y} width="7" height={H[b.t]} rx="3.5" />
              {b.tip && <rect class:list={['bar', b.tip]} x={b.x} y={b.y + H[b.t] * 0.6} width="7" height={H[b.t] * 0.4} rx="3" />}
            </>
          ))}
          <text class="s" x={gx[i]} y="246" text-anchor="middle">n = 2</text>
        </>
      ))}
      <text class="t" x="150" y="266" text-anchor="middle">all genetically different</text>
    </svg>
  </div>
</div>

<style>
  .dfig { container-type: inline-size; }
  .pair { display: grid; gap: var(--space-4); grid-template-columns: minmax(0, 1fr); }
  @container (min-width: 34rem) { .pair { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .dfig svg { font-family: var(--font-sans); display: block; width: 100%; height: auto; }
  .h { font-size: 16px; font-weight: 800; fill: var(--text); }
  .t { font-size: 14px; font-weight: 700; fill: var(--text); }
  .s { font-size: 13px; fill: var(--text-muted); }
  .cell { fill: color-mix(in srgb, var(--bio-head) 8%, var(--surface)); stroke: var(--bio-head); stroke-width: 2; }
  .bar { stroke: var(--text); stroke-width: 0.8; }
  .m { fill: var(--bio-k); }
  .p { fill: var(--bio-protein); }
  .arrow { stroke: var(--text); stroke-width: 1.8; fill: none; }
</style>
